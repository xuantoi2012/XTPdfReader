    <!-- ══ Ribbon 1 hàng kiểu Foxit (không tab): nút LỚN icon trên-chữ dưới, nút NHỎ icon+chữ xếp
         chồng 3 hàng, nhãn nhóm ở đáy. Vẫn là xt:XTButton (Icon/IconBrush/Text của XTStyle) — chỉ
         thay template xếp dọc ở app, không sửa XTStyle. Tag="Active" = công cụ đang bật. ══ -->
    <ControlTemplate x:Key="PdfRibbonLargeButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="3" Padding="{TemplateBinding Padding}"
                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="1" SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
                <Path Data="{TemplateBinding IconData}" Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}"
                      Fill="{TemplateBinding IconBrush}" Stretch="Uniform" HorizontalAlignment="Center" Margin="0,2,0,3"/>
                <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}"
                           FontSize="12" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="72"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="PdfRibbonLargeButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource PdfRibbonLargeButtonTemplate}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="Height" Value="66"/>
        <Setter Property="Padding" Value="5,2"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="IconSize" Value="26"/>
        <Setter Property="Foreground" Value="{DynamicResource CadChromeText}"/>
        <Setter Property="IconBrush" Value="{DynamicResource CadChromeText}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CadChromeHoverBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource CadButtonHoverText}"/>
                <Setter Property="IconBrush" Value="{DynamicResource CadButtonHoverText}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{DynamicResource CadSelectionBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource CadSelectionBlue}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PdfRibbonSmallButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Padding" Value="4,0,6,0"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="IconSize" Value="16"/>
        <Setter Property="IconMargin" Value="0,0,5,0"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource CadChromeText}"/>
        <Setter Property="IconBrush" Value="{DynamicResource CadChromeText}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource CadChromeHoverBackground}"/>
                <Setter Property="Foreground" Value="{DynamicResource CadButtonHoverText}"/>
                <Setter Property="IconBrush" Value="{DynamicResource CadButtonHoverText}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="PdfRibbonGroupLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,1,0,2"/>
        <Setter Property="Foreground" Value="{DynamicResource CadTextSecondary}"/>
    </Style>

    <Style x:Key="PdfRibbonGroupSeparator" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="4,4,4,4"/>
        <Setter Property="Background" Value="{DynamicResource CadChromeBorder}"/>
    </Style>

    <Style x:Key="PdfCardIconButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="IconSize" Value="18"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="PdfViewerIconButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource PdfCardIconButton}">
        <Setter Property="Foreground" Value="{DynamicResource CadChromeText}"/>
        <!-- IconBrush (không phải Foreground) là thứ thật sự tô màu icon Path — style cha
             (XTToolButton) mặc định IconBrush=PrimaryBrush (xanh), Foreground=White ở
             trên không ăn vào icon nên trên nền tối ReaderPanel icon vẫn xanh, khó nhìn. -->
        <Setter Property="IconBrush" Value="{DynamicResource CadChromeText}"/>
        <Setter Property="Opacity" Value="0.92"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource CadButtonHoverText}"/>
                <Setter Property="IconBrush" Value="{DynamicResource CadButtonHoverText}"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ReaderContinuousPageTemplate KHÔNG đặt ở đây — nó có Loaded="ReaderContinuousImage_Loaded"
         (event handler), mà ResourceDictionary gốc không có x:Class nên không compile được event
         handler; đặt thẳng trong ReaderWindow.xaml's Resources (nơi có code-behind) thay vì đây. -->
</ResourceDictionary>
