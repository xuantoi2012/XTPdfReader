<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xt="clr-namespace:XTCADStyle.Controls;assembly=XTCADStyle"
                    xmlns:conv="clr-namespace:XTPdfMergeApp.Converters">
    <!-- Resource DÙNG CHUNG giữa MainWindow (PdfCardIconButton còn dùng ở header card/group ngoài
         Reader) và ReaderWindow (mọi thứ còn lại) — merge vào cả 2 Window's Resources, tách ra để
         không phải chép trùng. -->

    <conv:ContinuousPageSizeConverter x:Key="ContinuousPageSizeConverter"/>
    <conv:ContinuousPagePlaceholderHeightConverter x:Key="ContinuousPagePlaceholderHeightConverter"/>
    <conv:ContinuousPageMarginConverter x:Key="ContinuousPageMarginConverter"/>

    <Style x:Key="PdfCardIconButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="MinWidth" Value="32"/>
        <Setter Property="IconSize" Value="18"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="PdfViewerIconButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource PdfCardIconButton}">
        <Setter Property="Foreground" Value="White"/>
        <!-- IconBrush (không phải Foreground) là thứ thật sự tô màu icon Path — style cha
             (XTToolButton) mặc định IconBrush=PrimaryBrush (xanh), Foreground=White ở
             trên không ăn vào icon nên trên nền tối ReaderPanel icon vẫn xanh, khó nhìn. -->
        <Setter Property="IconBrush" Value="White"/>
        <Setter Property="Opacity" Value="0.92"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="#111827"/>
                <Setter Property="IconBrush" Value="#111827"/>
                <Setter Property="Opacity" Value="1"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ReaderContinuousPageTemplate KHÔNG đặt ở đây — nó có Loaded="ReaderContinuousImage_Loaded"
         (event handler), mà ResourceDictionary gốc không có x:Class nên không compile được event
         handler; đặt thẳng trong ReaderWindow.xaml's Resources (nơi có code-behind) thay vì đây. -->
</ResourceDictionary>
