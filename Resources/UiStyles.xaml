<!-- Style của thiết kế mới (docs/UI_REDESIGN.md). Dựa trên XTButton/XTToolButton của XTStyle; icon Phosphor tô đặc
     (Fill, lưới 24×24, Resources/UiIcons.xaml): công cụ đang bật vẽ thêm lớp duotone (Ui.Icon.X.Tint) màu accent, nút nhỏ dùng bản đậm. Màu lấy từ brush Ui.* (Resources/UiTokens.*.xaml),
     đổi theo theme lúc chạy nên dùng DynamicResource. Trạng thái bật của công cụ: Tag="Active" (như code-behind hiện có). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
                    xmlns:svc="clr-namespace:XTPdfMergeApp.Services">

    <svc:UiIconTintConverter x:Key="UiIconTint"/>
    <svc:UiIconAccentConverter x:Key="UiIconAccent"/>
    <svc:UiIconWeightConverter x:Key="UiIconWeight"/>

    <!-- Icon Phosphor: hình tô đặc (đặt Fill). -->
    <Style x:Key="UiIconPath" TargetType="Path">
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>

    <Style x:Key="UiLineIconPath" TargetType="Path">
        <Setter Property="StrokeThickness" Value="1.7"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>

    <!-- ══ Nút toolbar: vùng nhãn cố định để chữ 1/2 dòng không làm lệch hàng icon ══ -->
    <ControlTemplate x:Key="UiToolbarButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="26"/>
                </Grid.RowDefinitions>
                <Viewbox x:Name="ToolbarIcon" Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="Tint" Fill="{DynamicResource Ui.Accent}" Opacity="0.38"
                              Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UiIconTint}}"/>
                        <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding IconBrush}"/>
                        <Path x:Name="Accent" Fill="{DynamicResource Ui.Accent}"
                              Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UiIconAccent}}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="ToolbarLabel" Grid.Row="1" Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="11"
                           TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top" TextWrapping="Wrap"
                           LineHeight="12" LineStackingStrategy="BlockLineHeight" Margin="0,2,0,0"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Tint" Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Width cố định (không Auto theo chữ) + TextWrapping ở template: tên dài như "Highlight text"/"Highlight area"
         xuống 2 dòng thay vì kéo giãn bề ngang nút đó, để mọi nút trong hàng đều nhau, ribbon không bị so le. -->
    <Style x:Key="UiToolbarButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiToolbarButtonTemplate}"/>
        <Setter Property="Width" Value="54"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="62"/>
        <Setter Property="Padding" Value="1,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- Bậc icon lớn nhất trong app (giống ribbon Foxit): ribbon > thanh trái > quick access title bar > icon trong trang panel. -->
        <Setter Property="IconSize" Value="26"/>
        <Setter Property="Background" Value="Transparent"/>
        <!-- Mặc định dùng thẳng Ui.Text/Ui.Icon (đậm) thay vì Ui.Muted — trước đây icon/chữ chỉ đậm lên khi hover,
             nên cả ribbon nhìn mờ nhạt khi không rê chuột. -->
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Pressed}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Ribbon: nút tự rộng theo chữ, nhãn luôn đủ trên 1 dòng, khoảng cách gọn (còn chỗ cho chức năng sau này) ══ -->
    <ControlTemplate x:Key="UiRibbonButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox x:Name="ToolbarIcon" Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="Tint" Fill="{DynamicResource Ui.Accent}" Opacity="0.38"
                              Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UiIconTint}}"/>
                        <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding IconBrush}"/>
                        <Path x:Name="Accent" Fill="{DynamicResource Ui.Accent}"
                              Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UiIconAccent}}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="11" TextAlignment="Center"
                           HorizontalAlignment="Center" TextWrapping="NoWrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Active"><Setter TargetName="Tint" Property="Opacity" Value="0.7"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
<ControlTemplate x:Key="UiRibbonButtonDangerTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox x:Name="ToolbarIcon" Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="Tint" Fill="{DynamicResource Ui.Accent}" Opacity="0.38"
                              Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UiIconTint}}"/>
                        <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding IconBrush}"/>
                        <Path x:Name="Accent" Fill="{DynamicResource Ui.Danger}"
                              Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UiIconAccent}}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="11" TextAlignment="Center"
                           HorizontalAlignment="Center" TextWrapping="NoWrap" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Active"><Setter TargetName="Tint" Property="Opacity" Value="0.7"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style x:Key="UiRibbonButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource UiToolbarButton}">
        <Setter Property="Template" Value="{StaticResource UiRibbonButtonTemplate}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="Height" Value="54"/>
        <Setter Property="Padding" Value="4,0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="IconSize" Value="24"/>
    </Style>

    <!-- ══ Nút chính (Merge files): nền accent, icon + chữ ngang ══ -->
    <ControlTemplate x:Key="UiPrimaryButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox x:Name="Icon" Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding Foreground}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IconData" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiPrimaryButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiPrimaryButtonTemplate}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource XTPrimaryButtonBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.OnAccent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource XTPrimaryButtonHoverBackground}"/>
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Foreground" Value="White"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="UiRailButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border CornerRadius="6" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path x:Name="Tint" Fill="{DynamicResource Ui.Accent}" Opacity="0.38"
                          Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UiIconTint}}"/>
                    <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding IconBrush}"/>
                        <Path x:Name="Accent" Fill="{DynamicResource Ui.Accent}"
                              Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UiIconAccent}}"/>
                </Canvas>
            </Viewbox>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Tint" Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Icon-only sidebar rail; labels remain available as tooltips. -->
    <Style x:Key="UiRailButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource UiToolbarButton}">
        <Setter Property="Template" Value="{StaticResource UiRailButtonTemplate}"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="MinWidth" Value="36"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="IconSize" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Icon}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Pressed}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Nút hành động trong panel (Insert / Delete / Rotate / Extract): dàn đều, icon bậc nhỏ nhất + chữ 11 ══ -->
    <Style x:Key="UiPanelAction" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource UiToolbarButton}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="IconSize" Value="17"/>
    </Style>

    <!-- ══ Nút icon nhỏ (thanh trạng thái, đóng tab…) ══ -->
    <ControlTemplate x:Key="UiIconButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="5" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
            <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Fill="{TemplateBinding IconBrush}">
                        <Path.Data>
                            <MultiBinding Converter="{StaticResource UiIconWeight}">
                                <Binding Path="IconData" RelativeSource="{RelativeSource TemplatedParent}"/>
                                <Binding Path="IconSize" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </MultiBinding>
                        </Path.Data>
                    </Path>
                </Canvas>
            </Viewbox>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiIconButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiIconButtonTemplate}"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IconSize" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Icon}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Pressed}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Accent}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Destructive commands (Delete, Eraser): the icon is red instead of the accent, hover included. -->
    <Style x:Key="UiRibbonButtonDanger" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource UiRibbonButton}">
        <Setter Property="Template" Value="{StaticResource UiRibbonButtonDangerTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Danger}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="UiIconButtonDanger" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource UiIconButton}">
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Danger}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Danger}"/>
            </Trigger>
        </Style.Triggers>
    </Style>


    <!-- Thanh cuộn chính của PDF: rõ hơn scrollbar overlay dùng chung để luôn nhận ra vị trí
         trong tài liệu dài. Track nhận page-up/down trực tiếp, thumb không tự ẩn. -->
    <ControlTemplate x:Key="UiReaderVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="2,4,2,6">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" IsTabStop="False">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Background="{TemplateBinding Foreground}" MinHeight="48" Focusable="False">
                        <Thumb.Template>
                            <ControlTemplate TargetType="Thumb">
                                <Border Background="{TemplateBinding Background}" CornerRadius="4"/>
                            </ControlTemplate>
                        </Thumb.Template>
                    </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" IsTabStop="False">
                        <RepeatButton.Template>
                            <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
                        </RepeatButton.Template>
                    </RepeatButton>
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <Style x:Key="UiReaderVerticalScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="14"/>
        <Setter Property="MinWidth" Value="14"/>
        <Setter Property="Margin" Value="0,4,3,6"/>
        <Setter Property="Background" Value="{DynamicResource Ui.Panel}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Border}"/>
        <Setter Property="Template" Value="{StaticResource UiReaderVerticalScrollBarTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.28"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Ô nhảy trang ở statusbar: TextBox riêng, không dùng XTTextBox vì control đó có nút clear (X).
         Nền trắng giữ ô nhập nổi bật trên statusbar ở cả hai theme. -->
    <ControlTemplate x:Key="UiStatusPageBoxTemplate" TargetType="{x:Type TextBox}">
        <Border x:Name="Border" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="3" SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}"
                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                          VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiStatusPageBox" TargetType="{x:Type TextBox}">
        <Setter Property="Height" Value="22"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource Ui.Text}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template" Value="{StaticResource UiStatusPageBoxTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Ui.Muted}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Nút nhỏ icon + nhãn trong ribbon: vẫn xếp lưới để tiết kiệm chiều ngang, nhưng tên công cụ luôn nhìn thấy.
         Icon neo cố định bên trái (không center theo nội dung) để cột icon thẳng hàng dù chữ dài ngắn khác nhau
         (Rect/Cloud/Oval/Arrow/Line/Stamp) — center theo cả cụm icon+chữ làm icon bị xê dịch theo độ dài chữ. ══ -->
    <ControlTemplate x:Key="UiMiniLabeledButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="4" Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="7,0,4,0">
                <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="Tint" Fill="{DynamicResource Ui.Accent}" Opacity="0.38"
                              Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UiIconTint}}"/>
                        <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding IconBrush}"/>
                        <Path x:Name="Accent" Fill="{DynamicResource Ui.Accent}"
                              Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UiIconAccent}}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{TemplateBinding Text}" Margin="5,0,0,0" FontSize="11.5" TextTrimming="CharacterEllipsis"
                           Foreground="{TemplateBinding Foreground}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Active"><Setter TargetName="Tint" Property="Opacity" Value="0.7"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Không viền: chỉ đổi nền khi hover/active (giống mọi nút khác trong ribbon), viền cố định nhìn rối và lạc tông. -->
    <Style x:Key="UiMiniIconButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiMiniLabeledButtonTemplate}"/>
        <Setter Property="Width" Value="64"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="Margin" Value="0,0,3,3"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IconSize" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Pressed}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Accent}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Thanh trượt hiện đại dùng chung (trước đây MergeView có style riêng, chỗ khác dùng Slider mặc định
         của Windows — không đồng bộ): nền rãnh mảnh, chấm tròn viền accent. ══ -->
    <Style x:Key="UiSlider" TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Ui.Border}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource Ui.Accent}"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Height="22" Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False" Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Knob" Fill="{DynamicResource Ui.Surface}" Stroke="{DynamicResource Ui.Accent}" StrokeThickness="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Ui.AccentSoft}"/></Trigger>
                                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Ui.Accent}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Nút "Start" trong dải tab file: trông và bật/tắt giống hệt 1 tab file (UiTabItem) ══ -->
    <ControlTemplate x:Key="UiTabButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Grid Height="34" SnapsToDevicePixels="True">
            <Border x:Name="Bd" Padding="12,0,12,3" Background="Transparent">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding IconBrush}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="Tx" Text="{TemplateBinding Text}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
                </StackPanel>
            </Border>
            <Border x:Name="ActiveLine" Height="3" VerticalAlignment="Bottom" Background="Transparent" IsHitTestVisible="False"/>
            <Border x:Name="TabSeparator" Width="1" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="{DynamicResource Ui.TabSeparator}" IsHitTestVisible="False"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.TabSurface}"/>
                <Setter TargetName="ActiveLine" Property="Background" Value="{DynamicResource Ui.Accent}"/>
                <Setter TargetName="TabSeparator" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiTabButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiTabButtonTemplate}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Muted}"/>
        <Setter Property="Margin" Value="0"/>
        <Style.Triggers>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Đóng/mở tab: chỉ đổi màu icon, giữ nền trong suốt cả khi hover và nhấn. -->
    <Style x:Key="UiTabCloseButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource UiIconButton}">
        <Setter Property="BorderThickness" Value="0"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Brand}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Brand}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Brand}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Brand}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="UiTabAddButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource UiTabCloseButton}"/>

    <!-- ══ Tab file (ListBoxItem): nền mặt khi chọn, gạch accent 3 px dưới chân ══ -->
    <Style x:Key="UiTabItem" TargetType="ListBoxItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Bd" Padding="12,0,6,3" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                        </Border>
                        <Border x:Name="ActiveLine" Height="3" VerticalAlignment="Bottom" Background="Transparent" IsHitTestVisible="False"/>
                        <Border x:Name="TabSeparator" Width="1" Height="18" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="{DynamicResource Ui.TabSeparator}" IsHitTestVisible="False"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.TabSurface}"/>
                            <Setter TargetName="ActiveLine" Property="Background" Value="{DynamicResource Ui.Accent}"/>
                            <Setter TargetName="TabSeparator" Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <!-- Kéo trang lên tab: tab sáng lên (giữ ~0,5 s thì chuyển sang tab đó, thả lên tab = thêm vào cuối). -->
                        <Trigger Property="Tag" Value="DropHover">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                            <Setter TargetName="ActiveLine" Property="Background" Value="{DynamicResource Ui.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Ô thumbnail trong panel Pages ══ -->
    <Style x:Key="UiThumbItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="6" BorderThickness="1.5" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Nút viền mảnh (Show all / Hide all / Isolate…): icon tuỳ chọn + chữ 12 px ══ -->
    <ControlTemplate x:Key="UiGhostButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}"
                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox x:Name="Icon" Width="16" Height="16" Margin="0,0,6,0">
                    <Canvas Width="24" Height="24">
                        <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding IconBrush}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IconData" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiGhostButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiGhostButtonTemplate}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Search box of the title bar: a light surface so it stands out from the bar. -->
    <!-- The search box of the title bar: icon and hint gathered at the left (not centred across the whole box). -->
    <ControlTemplate x:Key="UiTitleSearchButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" CornerRadius="6" Padding="10,0" SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Viewbox Width="15" Height="15" Margin="0,0,8,0">
                    <Canvas Width="24" Height="24"><Path Data="{TemplateBinding IconData}" Fill="{DynamicResource Ui.Muted}"/></Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{TemplateBinding Text}" Foreground="{DynamicResource Ui.Muted}" FontSize="{TemplateBinding FontSize}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Ui.Chip}"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiTitleSearchButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource UiGhostButton}">
        <Setter Property="Background" Value="{DynamicResource Ui.Surface}"/>
        <Setter Property="Template" Value="{StaticResource UiTitleSearchButtonTemplate}"/>
    </Style>

    <!-- ══ Nút icon nền accent (nút "Cập nhật" ở thanh title): chỉ icon, hover = phủ trắng nhẹ ══ -->
    <ControlTemplate x:Key="UiAccentIconButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Grid SnapsToDevicePixels="True">
            <Border CornerRadius="6" Background="{DynamicResource Ui.Accent}"/>
            <Border x:Name="Veil" CornerRadius="6" Background="White" Opacity="0"/>
            <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="{TemplateBinding IconData}" Fill="{DynamicResource Ui.OnAccent}"/>
                </Canvas>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.2"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.07"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiAccentIconButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiAccentIconButtonTemplate}"/>
        <Setter Property="Width" Value="30"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IconSize" Value="18"/>
    </Style>

    <!-- Update button of the title bar: just the orange arrow, a soft orange wash on hover. -->
    <ControlTemplate x:Key="UiAccentGlyphButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Veil" CornerRadius="6" Background="{DynamicResource Ui.Brand}" Opacity="0"/>
            <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Data="{TemplateBinding IconData}" Fill="{DynamicResource Ui.Brand}"/>
                </Canvas>
            </Viewbox>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.14"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.24"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.42"/></Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiAccentGlyphButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource UiAccentIconButton}">
        <Setter Property="Template" Value="{StaticResource UiAccentGlyphButtonTemplate}"/>
    </Style>

    <!-- ══ Dòng danh sách (Layers…): hover + chọn nền accent nhạt ══ -->
    <Style x:Key="UiRowItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Cây (Bookmarks): hàng cao 30, mũi tên chevron nét mảnh, hover/chọn cùng kiểu danh sách Layers ══ -->
    <Style x:Key="UiTreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="22" Height="28">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Chev" Data="{StaticResource Ui.Icon.chevr.Bold}" Fill="{DynamicResource Ui.Muted}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chev" Property="Data" Value="{StaticResource Ui.Icon.chevd.Bold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UiTreeItem" TargetType="TreeViewItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="4,0" SnapsToDevicePixels="True">
                            <DockPanel MinHeight="28">
                                <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Style="{StaticResource UiTreeExpander}" ClickMode="Press"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </DockPanel>
                        </Border>
                        <ItemsPresenter x:Name="Items" Margin="16,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Items" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UiCountChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ui.Chip}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="UiGroupCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,3,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
    </Style>

    <Style x:Key="UiToolbarSeparator" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="5,6,5,14"/>
        <Setter Property="Background" Value="{DynamicResource Ui.ToolbarBorder}"/>
    </Style>

    <!-- ══ ProgressBar: accent colour from the settings, never the system green ══ -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
        <Setter Property="Background" Value="{DynamicResource Ui.Chip}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Grid x:Name="TemplateRoot" ClipToBounds="True">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Determinate"/>
                                <VisualState x:Name="Indeterminate">
                                    <Storyboard RepeatBehavior="Forever">
                                        <PointAnimationUsingKeyFrames Storyboard.TargetName="Marquee" Storyboard.TargetProperty="(UIElement.RenderTransformOrigin)">
                                            <EasingPointKeyFrame KeyTime="0" Value="-0.5,0.5"/>
                                            <EasingPointKeyFrame KeyTime="0:0:1.4" Value="1.5,0.5"/>
                                        </PointAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetName="Marquee" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/>
                                        <DoubleAnimation Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="3"/>
                        <Border x:Name="Marquee" Opacity="0" Background="{TemplateBinding Foreground}" CornerRadius="3" RenderTransformOrigin="-0.5,0.5">
                            <Border.RenderTransform><ScaleTransform ScaleX="0.3"/></Border.RenderTransform>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
