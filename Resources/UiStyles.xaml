<!-- Style của thiết kế mới (docs/UI_REDESIGN.md). Dựa trên XTButton/XTToolButton của XTStyle; icon Phosphor tô đặc
     (Fill, lưới 24×24, Resources/UiIcons.xaml): công cụ đang bật vẽ thêm lớp duotone (Ui.Icon.X.Tint) màu accent, nút nhỏ dùng bản đậm. Màu lấy từ brush Ui.* (Resources/UiTokens.*.xaml),
     đổi theo theme lúc chạy nên dùng DynamicResource. Trạng thái bật của công cụ: Tag="Active" (như code-behind hiện có). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
                    xmlns:svc="clr-namespace:XTPdfMergeApp.Services">

    <svc:UiIconTintConverter x:Key="UiIconTint"/>
    <svc:UiIconWeightConverter x:Key="UiIconWeight"/>

    <!-- Icon Phosphor: hình tô đặc (đặt Fill). -->
    <Style x:Key="UiIconPath" TargetType="Path">
        <Setter Property="StrokeThickness" Value="0"/>
    </Style>

    <Style x:Key="UiLineIconPath" TargetType="Path">
        <Setter Property="StrokeThickness" Value="1.7"/>
        <Setter Property="StrokeStartLineCap" Value="Round"/>
        <Setter Property="StrokeEndLineCap" Value="Round"/>
        <Setter Property="StrokeLineJoin" Value="Round"/>
        <Setter Property="Fill" Value="Transparent"/>
    </Style>

    <!-- ══ Nút toolbar: icon trên, chữ 11 px dưới ══ -->
    <ControlTemplate x:Key="UiToolbarButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" HorizontalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="Tint" Fill="{DynamicResource Ui.Accent}" Opacity="0.3" Visibility="Collapsed"
                              Data="{Binding IconData, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource UiIconTint}}"/>
                        <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding IconBrush}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="11"
                           TextAlignment="Center" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Tint" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiToolbarButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiToolbarButtonTemplate}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="60"/>
        <Setter Property="Height" Value="56"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="Margin" Value="1,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <!-- Bậc icon lớn nhất trong app (giống ribbon Foxit): ribbon > thanh trái > quick access title bar > icon trong trang panel. -->
        <Setter Property="IconSize" Value="26"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Icon}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Pressed}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Nút chính (Merge files): nền accent, icon + chữ ngang ══ -->
    <ControlTemplate x:Key="UiPrimaryButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="6" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox x:Name="Icon" Width="18" Height="18">
                    <Canvas Width="24" Height="24">
                        <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding Foreground}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontWeight="SemiBold" Margin="7,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IconData" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiPrimaryButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiPrimaryButtonTemplate}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource XTPrimaryButtonBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.OnAccent}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource XTPrimaryButtonHoverBackground}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Nút thanh trái (Pages / Bookmarks / Layers): 56×54, icon bậc 2 (nhỏ hơn ribbon) + chữ 11 ══ -->
    <Style x:Key="UiRailButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource UiToolbarButton}">
        <Setter Property="Width" Value="56"/>
        <Setter Property="MinWidth" Value="56"/>
        <Setter Property="Height" Value="58"/>
        <Setter Property="IconSize" Value="22"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Icon}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Pressed}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Nút hành động trong panel (Insert / Delete / Rotate / Extract): dàn đều, icon bậc nhỏ nhất + chữ 11 ══ -->
    <Style x:Key="UiPanelAction" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource UiToolbarButton}">
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="46"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="IconSize" Value="17"/>
    </Style>

    <!-- ══ Nút icon nhỏ (thanh trạng thái, đóng tab…) ══ -->
    <ControlTemplate x:Key="UiIconButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="5" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
            <Viewbox Width="{TemplateBinding IconSize}" Height="{TemplateBinding IconSize}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Canvas Width="24" Height="24">
                    <Path Fill="{TemplateBinding IconBrush}">
                        <Path.Data>
                            <MultiBinding Converter="{StaticResource UiIconWeight}">
                                <Binding Path="IconData" RelativeSource="{RelativeSource TemplatedParent}"/>
                                <Binding Path="IconSize" RelativeSource="{RelativeSource TemplatedParent}"/>
                            </MultiBinding>
                        </Path.Data>
                    </Path>
                </Canvas>
            </Viewbox>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiIconButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiIconButtonTemplate}"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IconSize" Value="16"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Icon}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Nút icon nhỏ xếp lưới trong ribbon (Shapes, Underline/Strikethrough…): kiểu Foxit gom nhiều công cụ
         ít dùng vào 1 ô nhỏ thay vì mỗi cái 1 nút to riêng — Tag="Active" = công cụ đang bật. ══ -->
    <Style x:Key="UiMiniIconButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiIconButtonTemplate}"/>
        <Setter Property="Width" Value="26"/>
        <Setter Property="Height" Value="19"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="IconSize" Value="15"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Icon}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Pressed}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Thanh trượt hiện đại dùng chung (trước đây MergeView có style riêng, chỗ khác dùng Slider mặc định
         của Windows — không đồng bộ): nền rãnh mảnh, chấm tròn viền accent. ══ -->
    <Style x:Key="UiSlider" TargetType="Slider">
        <Setter Property="Height" Value="22"/>
        <Setter Property="Focusable" Value="True"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Background="Transparent">
                        <Border Height="4" CornerRadius="2" Background="{DynamicResource Ui.Border}" VerticalAlignment="Center"/>
                        <Track x:Name="PART_Track" VerticalAlignment="Center">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="2" Background="{DynamicResource Ui.Accent}"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton"><Border Height="22" Background="Transparent"/></ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Focusable="False" Width="16" Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="Knob" Fill="{DynamicResource Ui.Surface}" Stroke="{DynamicResource Ui.Accent}" StrokeThickness="2"/>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Ui.AccentSoft}"/></Trigger>
                                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Ui.Accent}"/></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Nút "Start" trong dải tab file: trông và bật/tắt giống hệt 1 tab file (UiTabItem) ══ -->
    <ControlTemplate x:Key="UiTabButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" Padding="12,0,12,0" Height="34" BorderThickness="0,0,0,3" BorderBrush="Transparent" Background="Transparent" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding IconBrush}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="Tx" Text="{TemplateBinding Text}" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
            </Trigger>
            <Trigger Property="Tag" Value="Active">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Surface}"/>
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiTabButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiTabButtonTemplate}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Muted}"/>
    </Style>

    <!-- ══ Tab file (ListBoxItem): nền mặt khi chọn, gạch accent 2 px dưới chân ══ -->
    <Style x:Key="UiTabItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        <Setter Property="Height" Value="34"/>
        <Setter Property="Margin" Value="0,0,1,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Padding="12,0,6,0" BorderThickness="0,0,0,3" BorderBrush="Transparent" Background="Transparent" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" TextElement.FontWeight="{TemplateBinding FontWeight}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Surface}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                        <!-- Kéo trang lên tab: tab sáng lên (giữ ~0,5 s thì chuyển sang tab đó, thả lên tab = thêm vào cuối). -->
                        <Trigger Property="Tag" Value="DropHover">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Ô thumbnail trong panel Pages ══ -->
    <Style x:Key="UiThumbItem" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="1"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="6" BorderThickness="1.5" BorderBrush="Transparent" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Top"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Text}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Nút viền mảnh (Show all / Hide all / Isolate…): icon tuỳ chọn + chữ 12 px ══ -->
    <ControlTemplate x:Key="UiGhostButtonTemplate" TargetType="{x:Type xt:XTButton}">
        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}"
                Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Viewbox x:Name="Icon" Width="16" Height="16" Margin="0,0,6,0">
                    <Canvas Width="24" Height="24">
                        <Path Data="{TemplateBinding IconData}" Fill="{TemplateBinding IconBrush}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{TemplateBinding Text}" Foreground="{TemplateBinding Foreground}" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IconData" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.42"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="UiGhostButton" TargetType="{x:Type xt:XTButton}" BasedOn="{StaticResource XTToolButton}">
        <Setter Property="Template" Value="{StaticResource UiGhostButtonTemplate}"/>
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
        <Setter Property="IconBrush" Value="{DynamicResource Ui.Text}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Ui.Pressed}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ══ Dòng danh sách (Layers…): hover + chọn nền accent nhạt ══ -->
    <Style x:Key="UiRowItem" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ══ Cây (Bookmarks): hàng cao 30, mũi tên chevron nét mảnh, hover/chọn cùng kiểu danh sách Layers ══ -->
    <Style x:Key="UiTreeExpander" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent" Width="22" Height="28">
                        <Viewbox Width="14" Height="14">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Chev" Data="{StaticResource Ui.Icon.chevr.Bold}" Fill="{DynamicResource Ui.Muted}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chev" Property="Data" Value="{StaticResource Ui.Icon.chevd.Bold}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UiTreeItem" TargetType="TreeViewItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5" Margin="4,0" SnapsToDevicePixels="True">
                            <DockPanel MinHeight="28">
                                <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Style="{StaticResource UiTreeExpander}" ClickMode="Press"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            </DockPanel>
                        </Border>
                        <ItemsPresenter x:Name="Items" Margin="16,0,0,0" Visibility="Collapsed"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Items" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger SourceName="Bd" Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="UiCountChip" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Ui.Chip}"/>
        <Setter Property="CornerRadius" Value="9"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="UiGroupCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10.5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
    </Style>

    <Style x:Key="UiToolbarSeparator" TargetType="Border">
        <Setter Property="Width" Value="1"/>
        <Setter Property="Margin" Value="8,6,8,16"/>
        <Setter Property="Background" Value="{DynamicResource Ui.Border}"/>
    </Style>
