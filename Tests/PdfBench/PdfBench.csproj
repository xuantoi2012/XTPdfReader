<Project Sdk="Microsoft.NET.Sdk">
  <!-- Công cụ đo hiệu năng PDFium độc lập (không WPF), chạy được trên Windows và Linux. Cách chạy: xem README.md. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <!-- Đo đúng code của app: bộ đệm khối (bước #0), nguồn đọc cho FPDF_LoadCustomDocument (window, kịch bản D),
       bảng hàm PDFium PdfiumInstance (apicheck). -->
  <ItemGroup>
    <Compile Include="..\..\Services\PdfFileBuffer.cs" Link="App\PdfFileBuffer.cs" />
    <Compile Include="..\..\Services\LayeredDocumentSource.cs" Link="App\LayeredDocumentSource.cs" />
    <Compile Include="..\..\Services\DiagnosticsLog.cs" Link="App\DiagnosticsLog.cs" />
    <Compile Include="..\..\Services\RenderDiagnostics.cs" Link="App\RenderDiagnostics.cs" />
    <Compile Include="..\..\Services\PdfiumInstance.cs" Link="App\PdfiumInstance.cs" />
    <Compile Include="..\..\Services\PdfRenderGate.cs" Link="App\PdfRenderGate.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="itext" Version="9.6.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.6.0" />
    <!-- Cùng bản PDFium với app (147.0.7690). -->
    <PackageReference Include="bblanchon.PDFium.Win32" Version="147.0.7690" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="bblanchon.PDFium.Linux" Version="147.0.7690" Condition="!$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
</Project>
