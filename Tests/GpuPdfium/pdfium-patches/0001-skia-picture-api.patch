 // These checks are here because core/ and public/ cannot depend on each other.
@@ -843,6 +846,50 @@ FPDF_EXPORT void FPDF_CALLCONV FPDF_RenderPageSkia(FPDF_SKIA_CANVAS canvas,
                                 /*color_scheme=*/nullptr,
                                 /*need_to_restore=*/true, /*pause=*/nullptr);
 }
+
+FPDF_EXPORT FPDF_SKIA_PICTURE FPDF_CALLCONV
+FPDF_CreateSkiaPicture(FPDF_PAGE page, int size_x, int size_y) {
+  if (size_x <= 0 || size_y <= 0) {
+    return nullptr;
+  }
+
+  SkPictureRecorder recorder;
+  SkRTreeFactory rtree_factory;
+  SkCanvas* canvas = recorder.beginRecording(size_x, size_y, &rtree_factory);
+  FPDF_RenderPageSkia(FPDFSkiaCanvasFromSkCanvas(canvas), page, size_x, size_y);
+  return reinterpret_cast<FPDF_SKIA_PICTURE>(
+      recorder.finishRecordingAsPicture().release());
+}
+
+FPDF_EXPORT void FPDF_CALLCONV
+FPDF_RenderSkiaPicture(FPDF_SKIA_CANVAS canvas, FPDF_SKIA_PICTURE picture) {
+  SkCanvas* sk_canvas = SkCanvasFromFPDFSkiaCanvas(canvas);
+  SkPicture* sk_picture = reinterpret_cast<SkPicture*>(picture);
+  if (!sk_canvas || !sk_picture) {
+    return;
+  }
+  sk_canvas->drawPicture(sk_picture);
+}
+
+FPDF_EXPORT size_t FPDF_CALLCONV
+FPDF_SkiaPictureApproximateBytes(FPDF_SKIA_PICTURE picture) {
+  SkPicture* sk_picture = reinterpret_cast<SkPicture*>(picture);
+  return sk_picture ? sk_picture->approximateBytesUsed() : 0u;
+}
+
+FPDF_EXPORT int FPDF_CALLCONV
+FPDF_SkiaPictureApproximateOpCount(FPDF_SKIA_PICTURE picture) {
+  SkPicture* sk_picture = reinterpret_cast<SkPicture*>(picture);
+  return sk_picture ? sk_picture->approximateOpCount(/*nested=*/true) : 0;
+}
+
+FPDF_EXPORT void FPDF_CALLCONV
+FPDF_DestroySkiaPicture(FPDF_SKIA_PICTURE picture) {
+  SkPicture* sk_picture = reinterpret_cast<SkPicture*>(picture);
+  if (sk_picture) {
+    sk_picture->unref();
+  }
+}
 #endif  // defined(PDF_USE_SKIA)
 
