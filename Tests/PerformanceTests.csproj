<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <MuPdfOnly Condition="'$(MuPdfOnly)' == ''">true</MuPdfOnly>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>XTPdfMergeApp.PerformanceTests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <!-- PdfBench, PoolTest là project riêng (không WPF) — không gom vào đây. -->
    <Compile Remove="PdfBench\**;PoolTest\**;MuPdfNativeWorker\**" />
    <None Remove="PdfBench\**;PoolTest\**" />
    <EmbeddedResource Remove="PdfBench\**;PoolTest\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\XTPdfMergeApp.csproj" />
    <Compile Include="obj\BaselinePdfThumbnailService.cs" Condition="Exists('obj\BaselinePdfThumbnailService.cs')" />
  </ItemGroup>
  <PropertyGroup Condition="Exists('obj\BaselinePdfThumbnailService.cs')">
    <DefineConstants>$(DefineConstants);HAS_BASELINE</DefineConstants>
  </PropertyGroup>
  <Target Name="CopyTestPdfiumInstances" AfterTargets="Build" Condition="'$(MuPdfOnly)' != 'true'">
    <ItemGroup>
      <_TestPdfium Include="$(OutDir)runtimes\win-x64\native\pdfium.dll" />
      <_TestPdfiumCopy Include="1;2;3;4;5;6;7" />
    </ItemGroup>
    <Copy SourceFiles="@(_TestPdfium)" DestinationFiles="$(OutDir)pdfium.dll" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_TestPdfium)" DestinationFiles="$(OutDir)pdfium_%(_TestPdfiumCopy.Identity).dll" SkipUnchangedFiles="true" />
  </Target>
</Project>
