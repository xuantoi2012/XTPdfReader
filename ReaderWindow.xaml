<!-- Cửa sổ CHÍNH của app (App.OnStartup tạo và đặt làm Application.MainWindow): ribbon + tab file +
     panel trái + vùng đọc. Sở hữu DocumentSession (các file đang mở, undo/redo) và mở cửa sổ ghép phụ
     MergeWorkspaceWindow khi bấm "Ghép nhiều file…". -->
<xt:XTWindow x:Class="XTPdfMergeApp.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
        xmlns:conv="clr-namespace:XTPdfMergeApp.Converters"
        xmlns:local="clr-namespace:XTPdfMergeApp"
        xmlns:ctl="clr-namespace:XTPdfMergeApp.Controls"
        Title="XT PDF Reader" Width="1280" Height="820"
        MinWidth="760" MinHeight="520" TitleBarMode="Full"
        WindowStartupLocation="CenterScreen"
        TitleIcon="{DynamicResource Mat.FilePdfBox}" TitleIconBrush="{DynamicResource DangerBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Focusable="True"
        AllowDrop="True" DragOver="ReaderWindow_DragOver" Drop="ReaderWindow_Drop"
        PreviewKeyDown="ReaderWindow_PreviewKeyDown">

    <xt:XTWindow.TitleBarRightContent>
        <xt:XTToggleButton x:Name="ThemeToggleButton"
                           UncheckedText="Light" CheckedText="Dark"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="Switch between Light and Dark"
                           Checked="ThemeToggleButton_Changed"
                           Unchecked="ThemeToggleButton_Changed"/>
    </xt:XTWindow.TitleBarRightContent>

    <xt:XTWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XTPdfMergeApp;component/Resources/ReaderResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </xt:XTWindow.Resources>

    <!-- Toàn bộ nội dung dưới đây chuyển nguyên trạng từ MainWindow.xaml (Border "ReaderPanel",
         trước đó là panel nhúng cột 2 của MainContentGrid) — giữ NGUYÊN mọi x:Name/wiring sự
         kiện để phần code-behind (chuyển sang ReaderWindow.xaml.cs ở bước kế) không cần sửa gì
         thêm ngoài việc đổi tên class chứa. -->
    <Grid Background="{DynamicResource Ui.Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ Toolbar (docs/UI_REDESIGN.md): icon + chữ 11 px, nhóm bằng vạch; nút chính "Merge files" bên phải.
                 Chỉ hiện nút đã có chức năng. Xoay ở đây là xoay KHUNG NHÌN; xoay THẬT nằm ở panel Pages. Tag="Active" = công cụ đang bật. ══ -->
            <Border Grid.Row="0" Height="60" Background="{DynamicResource Ui.Surface}"
                    BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="12,0">
                    <xt:XTButton x:Name="ReaderMergeButton" DockPanel.Dock="Right" Style="{StaticResource UiPrimaryButton}"
                                 Icon="{StaticResource Ui.Icon.merge}" Text="Merge files" Margin="6,0,0,0"
                                 ToolTip="Open the Merge window: move or copy pages between files, merge, split and save"
                                 Click="ReaderShowMergeWindow_Click"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <xt:XTButton x:Name="ReaderHandToolButton" Style="{StaticResource UiToolbarButton}" Icon="{StaticResource Ui.Icon.hand}" Text="Hand"
                                     ToolTip="Drag to scroll the page (Esc returns to this tool)" Click="ReaderHandTool_Click" Tag="Active"/>
                        <xt:XTButton Style="{StaticResource UiToolbarButton}" Icon="{StaticResource Ui.Icon.undo}" Text="Undo"
                                     ToolTip="Undo (Ctrl+Z)" Click="ReaderUndo_Click"/>
                        <xt:XTButton Style="{StaticResource UiToolbarButton}" Icon="{StaticResource Ui.Icon.redo}" Text="Redo"
                                     ToolTip="Redo (Ctrl+Y)" Click="ReaderRedo_Click"/>
                        <Border Style="{StaticResource UiToolbarSeparator}"/>
                        <xt:XTButton x:Name="ReaderContinuousToggle" Style="{StaticResource UiToolbarButton}" Icon="{StaticResource Ui.Icon.scroll}" Text="Continuous"
                                     ToolTip="Continuous scrolling (mouse wheel scrolls across pages, Ctrl+wheel zooms)" Click="ReaderContinuousToggle_Click"/>
                        <xt:XTButton Style="{StaticResource UiToolbarButton}" Icon="{StaticResource Ui.Icon.fitp}" Text="Fit page"
                                     ToolTip="Fit page" Click="ReaderFitPage_Click"/>
                        <xt:XTButton Style="{StaticResource UiToolbarButton}" Icon="{StaticResource Ui.Icon.fitw}" Text="Fit width"
                                     ToolTip="Fit width" Click="ReaderFitWidth_Click"/>
                        <xt:XTButton Style="{StaticResource UiToolbarButton}" Icon="{StaticResource Ui.Icon.rotl}" Text="Rotate left"
                                     ToolTip="Rotate the view left (view only, the file is not changed)" Click="ReaderRotateLeft_Click"/>
                        <xt:XTButton Style="{StaticResource UiToolbarButton}" Icon="{StaticResource Ui.Icon.rotr}" Text="Rotate right"
                                     ToolTip="Rotate the view right (view only, the file is not changed)" Click="ReaderRotateRight_Click"/>
                        <Border Style="{StaticResource UiToolbarSeparator}"/>
                        <xt:XTButton x:Name="ReaderTypewriterToolButton" Style="{StaticResource UiToolbarButton}" Icon="{StaticResource Ui.Icon.type}" Text="Typewriter"
                                     ToolTip="Type text on the page: click where it goes, type, then Enter (Shift+Enter for a new line). Click existing text to edit." Click="ReaderTypewriterTool_Click"/>
                        <xt:XTButton x:Name="ReaderCommentToolButton" Style="{StaticResource UiToolbarButton}" Icon="{StaticResource Ui.Icon.note}" Text="Note"
                                     ToolTip="Sticky note: click the page, type, then Enter. Hover the icon to read it, click to edit." Click="ReaderCommentTool_Click"/>
                        <xt:XTButton x:Name="ReaderHighlightToolButton" Style="{StaticResource UiToolbarButton}" Icon="{StaticResource Ui.Icon.hl}" Text="Highlight"
                                     ToolTip="Drag a rectangle to highlight in yellow" Click="ReaderHighlightTool_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Tab các file đang mở, dưới toolbar. Bấm tab = chuyển file, × = đóng file, + = mở thêm file. -->
            <ListBox x:Name="ReaderDocumentTabs" Grid.Row="1" Height="36" BorderThickness="0,0,0,1" Padding="8,0,8,0"
                     BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Panel}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource UiTabItem}"
                     SelectionChanged="ReaderDocumentTabs_SelectionChanged">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <ItemsPresenter/>
                                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.plus}" IconSize="16"
                                                 VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="Open another file (Ctrl+O)"
                                                 Click="ReaderOpenFiles_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" MaxWidth="290" Background="Transparent" ToolTip="{Binding SourcePath}"
                                    PreviewMouseRightButtonDown="ReaderTab_PreviewMouseRightButtonDown">
                            <StackPanel.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Open in default app" Click="ReaderOpenExternal_Click"/>
                                    <MenuItem Header="Close" Click="ReaderCloseDocument_Click"/>
                                </ContextMenu>
                            </StackPanel.ContextMenu>
                            <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Ui.Icon.file}" Stroke="{DynamicResource Ui.Muted}" StrokeThickness="1.7"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxWidth="220" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.close}" Width="20" Height="20"
                                         IconSize="11" Margin="8,0,0,0" ToolTip="Close file" Click="ReaderCloseDocument_Click"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ReaderSidePanelColumn" Width="352" MinWidth="304" MaxWidth="640"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ctl:ReaderSidePanel x:Name="ReaderSidePanel" Grid.Column="0"/>
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="{DynamicResource Ui.Border}"/>

            <!-- Vùng xem trang + lớp tương tác (ReaderInteractionLayer) phủ trên cả 2 chế độ xem. -->
            <Grid x:Name="ReaderContentHost" Grid.Column="2" ClipToBounds="True"
                  PreviewMouseLeftButtonDown="ReaderContentHost_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="ReaderContentHost_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="ReaderContentHost_PreviewMouseLeftButtonUp"
                  MouseLeave="ReaderContentHost_MouseLeave"
                  LayoutUpdated="ReaderContentHost_LayoutUpdated">
            <ScrollViewer x:Name="ReaderScrollViewer"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource PdfViewerBackgroundBrush}" Padding="16"
                          PreviewMouseWheel="ReaderScrollViewer_PreviewMouseWheel"
                          ScrollChanged="ReaderScrollViewer_ScrollChanged"
                          SizeChanged="ReaderScrollViewer_SizeChanged">
                <Grid>
                    <TextBlock x:Name="ReaderEmptyText" Text="Select a page to view"
                               Foreground="{DynamicResource Ui.Muted}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- ReaderContentCanvas = "sizer" cấp kích thước cuộn CHÍNH XÁC cho
                         ScrollViewer (Width/Height set thẳng bằng code theo công thức, KHÔNG
                         dựa vào WPF tự đo qua LayoutTransform nữa) — Image/tile bên trong định vị
                         bằng Canvas.Left/Top tính sẵn + RenderTransform (Scale/Rotate) chỉ tác
                         động lúc VẼ, không kéo theo 1 lượt đo layout nào khi đổi zoom. Xem
                         ApplyReaderLayout/ZoomReaderAtPoint (ReaderWindow.xaml.cs) — đây là cách
                         các trình xem PDF/ảnh hiện đại (Chrome PDF viewer, Acrobat) giữ zoom mượt
                         và neo đúng điểm con trỏ: KHÔNG đo lại vị trí sau khi zoom, tính trước
                         bằng công thức rồi áp 1 lần duy nhất. -->
                    <Canvas x:Name="ReaderContentCanvas">
                        <Image x:Name="ReaderImage" Stretch="Fill"
                               RenderTransformOrigin="0.5,0.5"
                               RenderOptions.BitmapScalingMode="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderBitmapScalingMode}" Cursor="Hand"
                               MouseLeftButtonDown="ReaderImage_MouseLeftButtonDown"
                               MouseDown="ReaderImage_MouseDown"
                               MouseUp="ReaderImage_MouseUp"
                               MouseMove="ReaderImage_MouseMove"
                               MouseLeftButtonUp="ReaderImage_MouseLeftButtonUp"
                               LostMouseCapture="ReaderImage_LostMouseCapture">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ReaderScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ReaderRotateTransform" Angle="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <!-- Two independent coordinate spaces: old imagery remains visible
                             underneath each new tile until refinement is complete. -->
                        <Canvas x:Name="ReaderTileCanvas" Width="0" Height="0"
                                RenderTransformOrigin="0.5,0.5"
                                ClipToBounds="True" IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ReaderTileScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ReaderTileRotateTransform" Angle="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                        <Canvas x:Name="ReaderTileCanvasB" Width="0" Height="0"
                                RenderTransformOrigin="0.5,0.5"
                                ClipToBounds="True" IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ReaderTileScaleTransformB" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ReaderTileRotateTransformB" Angle="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <!-- Chế độ Cuộn liên tục kiểu Foxit: MỘT vùng vẽ tự vẽ mọi trang đang hiện (Controls/ContinuousPdfView) —
                 không ListBox/phần tử cho từng trang. Cuộn/zoom chỉ đổi vài con số rồi vẽ lại ngay bằng ảnh đang có. -->
            <ctl:ContinuousPdfView x:Name="ReaderContinuousView"
                                   Background="{DynamicResource PdfViewerBackgroundBrush}"
                                   Visibility="Collapsed"/>

                <!-- Lớp tương tác chung của Typewriter/Ghi chú/Highlight: không Background nên không
                     chặn chuột; chỉ ô nhập chữ, khung kéo highlight, popup xem ghi chú nằm ở đây. -->
                <Canvas x:Name="ReaderInteractionLayer">
                    <Rectangle x:Name="ReaderHighlightRubberBand" Visibility="Collapsed" IsHitTestVisible="False"
                               Fill="#66FFE600" Stroke="#FFC9A800" StrokeThickness="1"/>
                    <Border x:Name="ReaderCommentHoverPopup" Visibility="Collapsed" IsHitTestVisible="False"
                            MaxWidth="280" Padding="8,6" CornerRadius="3"
                            Background="#FFFFF6C4" BorderBrush="#FFC9A800" BorderThickness="1">
                        <TextBlock x:Name="ReaderCommentHoverText" TextWrapping="Wrap" Foreground="#FF222222" FontSize="12"/>
                    </Border>
                    <TextBox x:Name="ReaderAnnotationEditor" Visibility="Collapsed"
                             AcceptsReturn="True" TextWrapping="NoWrap" MinWidth="120"
                             Padding="1" BorderThickness="1"
                             BorderBrush="{DynamicResource XTSelectionBlue}" Foreground="Black"
                             PreviewKeyDown="ReaderAnnotationEditor_PreviewKeyDown"
                             LostKeyboardFocus="ReaderAnnotationEditor_LostKeyboardFocus"/>
                </Canvas>
            </Grid>
            </Grid>

            <!-- Thanh trạng thái: đường dẫn · điều hướng trang (giữa) · zoom (phải) -->
            <Grid Grid.Row="3" Background="{DynamicResource Ui.Panel}" Height="30"
                  TextElement.Foreground="{DynamicResource Ui.Muted}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="ReaderTitleText" Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="12,0,12,0" Foreground="{DynamicResource Ui.Muted}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.chevl}"
                                 ToolTip="Previous page" Click="ReaderPreviousPage_Click"/>
                    <TextBox x:Name="ReaderPageBox" Width="42" Height="22" Margin="3,0,0,0"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             KeyDown="ReaderPageBox_KeyDown" LostFocus="ReaderPageBox_LostFocus"/>
                    <TextBlock x:Name="ReaderPageTotalText" MinWidth="44" Margin="6,0,6,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Ui.Muted}"/>
                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.chevr}"
                                 ToolTip="Next page" Click="ReaderNextPage_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <!-- Tiến độ nạp file vào bộ đệm (đọc nền) — hết khi nạp xong. Không chặn thao tác. -->
                    <TextBlock x:Name="ReaderLoadProgressText" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource Ui.Muted}"
                               ToolTip="Reading the whole file into the cache. The page you are viewing is always read first."/>
                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.min}"
                                 ToolTip="Zoom out" Click="ReaderZoomOut_Click"/>
                    <TextBlock x:Name="ReaderZoomText" Width="46" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.plus}"
                                 ToolTip="Zoom in" Click="ReaderZoomIn_Click"/>
                </StackPanel>
            </Grid>
    </Grid>
</xt:XTWindow>
