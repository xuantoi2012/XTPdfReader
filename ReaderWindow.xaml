<!-- Cửa sổ CHÍNH của app (App.OnStartup tạo và đặt làm Application.MainWindow): ribbon + tab file +
     panel trái + vùng đọc. Sở hữu DocumentSession (các file đang mở, undo/redo) và mở cửa sổ ghép phụ
     MergeWorkspaceWindow khi bấm "Ghép nhiều file…". -->
<xt:XTWindow x:Class="XTPdfMergeApp.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
        xmlns:conv="clr-namespace:XTPdfMergeApp.Converters"
        xmlns:local="clr-namespace:XTPdfMergeApp"
        xmlns:ctl="clr-namespace:XTPdfMergeApp.Controls"
        Title="XT PDF Reader" Width="1280" Height="820"
        MinWidth="760" MinHeight="520" TitleBarMode="Full"
        WindowStartupLocation="CenterScreen"
        TitleIcon="{DynamicResource Mat.FilePdfBox}" TitleIconBrush="{DynamicResource DangerBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Focusable="True"
        AllowDrop="True" DragOver="ReaderWindow_DragOver" Drop="ReaderWindow_Drop"
        PreviewKeyDown="ReaderWindow_PreviewKeyDown">

    <xt:XTWindow.TitleBarRightContent>
        <xt:XTToggleButton x:Name="ThemeToggleButton"
                           UncheckedText="Light" CheckedText="Dark"
                           VerticalAlignment="Center" Margin="0,0,8,0"
                           ToolTip="Đổi giao diện Light/Dark"
                           Checked="ThemeToggleButton_Changed"
                           Unchecked="ThemeToggleButton_Changed"/>
    </xt:XTWindow.TitleBarRightContent>

    <xt:XTWindow.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XTPdfMergeApp;component/Resources/ReaderResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 1 trang trong chế độ Cuộn liên tục — ảnh độ phân giải READER (nét hơn hẳn
                 thumbnail), Loaded lazy-load + VirtualizingStackPanel (xem ReaderContinuousList)
                 nên chỉ trang đang/gần hiện mới thật sự render. Đặt Ở ĐÂY (Resources của chính
                 ReaderWindow, có x:Class) chứ không phải ReaderResources.xaml dùng chung — vì có
                 Loaded="ReaderContinuousImage_Loaded" (event handler), cần code-behind mới compile
                 được. KHÔNG dùng DropShadowEffect (đã bỏ) — Border này bọc Canvas "sizer" có
                 Width/Height đổi theo MỖI nấc zoom; DropShadowEffect buộc WPF render lại 1 bitmap
                 đổ bóng bằng PHẦN MỀM mỗi khi kích thước phần tử đổi, tức TẤT CẢ trang đang hiện
                 trong viewport đều phải tính lại bóng ở MỖI nấc zoom — đây là nguyên nhân thật của
                 hiện tượng nhấp nháy lúc zoom continuous. Foxit/Chrome PDF không đổ bóng thời gian
                 thực khi đang tương tác — dùng viền tĩnh (BorderBrush/BorderThickness) thay thế.
                 Margin PHẢI scale theo zoom (ContinuousPageMarginConverter), KHÔNG để cố định —
                 ZoomContinuousAtPoint tính vị trí cuộn mới bằng công thức tỉ lệ thuần, giả định
                 TOÀN BỘ chiều cao nội dung (cả trang lẫn khoảng cách giữa các trang) scale đều
                 theo đúng 1 tỉ lệ; margin cố định phá vỡ giả định đó (đúng bug "zoom nhỏ rồi zoom
                 lại bắt nhầm trang" đã gặp). -->
            <DataTemplate x:Key="ReaderContinuousPageTemplate">
                <Border Background="White" HorizontalAlignment="Center"
                        Margin="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderContinuousZoom, Converter={StaticResource ContinuousPageMarginConverter}}"
                        BorderBrush="#33000000" BorderThickness="1">
                    <!-- Canvas = "sizer" — Width/Height = ĐÚNG kích thước Image đã tự đo được
                         (ActualWidth/ActualHeight, ElementName binding tới chính ContinuousPageImage
                         bên dưới) nhân zoom, để VirtualizingStackPanel xếp dọc biết đúng chiều cao
                         từng trang mà cuộn đúng. BẮT BUỘC dùng Canvas, KHÔNG Grid: Grid.MeasureOverride
                         TRUYỀN kích thước của CHÍNH NÓ xuống làm ràng buộc đo cho con — Width/Height
                         của Grid ở đây lại PHỤ THUỘC NGƯỢC vào Image.ActualHeight (ElementName binding),
                         tạo thành VÒNG LẶP TỰ THAM CHIẾU (đúng bug "màn hình đen, ~60 trang cùng lúc
                         visible" đã gặp khi dùng Grid). Canvas.MeasureOverride LUÔN đo con với kích
                         thước VÔ HẠN, không truyền kích thước của chính nó xuống — an toàn. -->
                    <Canvas>
                        <Canvas.Width>
                            <MultiBinding Converter="{StaticResource ContinuousPageSizeConverter}">
                                <Binding ElementName="ContinuousPageImage" Path="ActualWidth"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=local:ReaderWindow}" Path="ReaderContinuousZoom"/>
                            </MultiBinding>
                        </Canvas.Width>
                        <Canvas.Height>
                            <MultiBinding Converter="{StaticResource ContinuousPageSizeConverter}">
                                <Binding ElementName="ContinuousPageImage" Path="ActualHeight"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=local:ReaderWindow}" Path="ReaderContinuousZoom"/>
                            </MultiBinding>
                        </Canvas.Height>
                        <!-- Image giữ kích thước NATIVE CỐ ĐỊNH (không đổi theo zoom) + RenderTransform
                             scale từ góc (0,0) — bắt buộc phải vậy: ZoomContinuousAtPoint neo điểm zoom
                             bằng TranslatePoint vào toạ độ CỤC BỘ của chính Image này (localAnchor); nếu
                             Width/Height của Image đổi theo zoom thì hệ toạ độ cục bộ đó TRÔI theo zoom
                             → neo sai, nhảy lệch khi đổi hướng zoom. Canvas.Left/Top mặc định = 0,0 nên
                             Image nằm đúng góc trên-trái Canvas, khớp RenderTransformOrigin=0,0. -->
                        <Image x:Name="ContinuousPageImage" Source="{Binding ReaderDisplayBitmap}"
                               Width="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderPageBaseWidth}"
                               Stretch="Uniform"
                               RenderTransformOrigin="0,0"
                               RenderOptions.BitmapScalingMode="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderBitmapScalingMode}"
                               Loaded="ReaderContinuousImage_Loaded">
                            <!-- Chưa có bitmap thật (Thumbnail lẫn ReaderBitmap đều null) → giữ chỗ 1
                                 chiều cao NATIVE ước lượng (tỉ lệ A-series) thay vì để co về 0 — nếu
                                 không, Canvas (lấy kích thước thẳng từ ActualHeight của chính Image này)
                                 cũng co về 0 theo, hàng loạt trang chưa tải dồn hết vào 1 màn hình cùng
                                 lúc. Đã có bitmap thật thì converter trả NaN (=Auto) để Stretch=Uniform
                                 tự đo đúng theo bitmap như bình thường. -->
                            <Image.Height>
                                <MultiBinding Converter="{StaticResource ContinuousPagePlaceholderHeightConverter}">
                                    <Binding Path="ReaderDisplayBitmap"/>
                                    <Binding RelativeSource="{RelativeSource AncestorType=local:ReaderWindow}" Path="ReaderPageBaseWidth"/>
                                    <Binding Path="AspectRatio"/>
                                </MultiBinding>
                            </Image.Height>
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderContinuousZoom}"
                                                ScaleY="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderContinuousZoom}"/>
                            </Image.RenderTransform>
                        </Image>
                        <!-- Retain the previous resolution underneath incoming sharp tiles.
                             Both layers use the same top-left page origin. -->
                        <Canvas x:Name="ContinuousTileCanvas" Width="0" Height="0"
                                RenderTransformOrigin="0,0"
                                ClipToBounds="True" IsHitTestVisible="False"
                                Panel.ZIndex="2"
                                Visibility="Collapsed">
                            <!-- BẮT BUỘC có x:Name: ScaleTransform khai báo TĨNH (không binding) và
                                 KHÔNG tên trong DataTemplate bị WPF tự đóng băng (Freeze) làm tối ưu —
                                 gán ScaleX/ScaleY sau đó (ConfigureContinuousTileCanvas) ném
                                 InvalidOperationException "read-only state" NGAY LẦN ĐẦU zoom vượt
                                 ngưỡng cần tile (đúng bug "tile không bao giờ hiện"). Đặt x:Name cho
                                 nó để WPF coi là đối tượng CÓ DANH TÍNH riêng từng instance template,
                                 không còn bị chia sẻ/đóng băng nữa. -->
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="ContinuousTileScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                        <Canvas x:Name="ContinuousTileCanvasB" Width="0" Height="0"
                                RenderTransformOrigin="0,0"
                                ClipToBounds="True" IsHitTestVisible="False"
                                Panel.ZIndex="2"
                                Visibility="Collapsed">
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="ContinuousTileScaleTransformB" ScaleX="1" ScaleY="1"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </xt:XTWindow.Resources>

    <!-- Toàn bộ nội dung dưới đây chuyển nguyên trạng từ MainWindow.xaml (Border "ReaderPanel",
         trước đó là panel nhúng cột 2 của MainContentGrid) — giữ NGUYÊN mọi x:Name/wiring sự
         kiện để phần code-behind (chuyển sang ReaderWindow.xaml.cs ở bước kế) không cần sửa gì
         thêm ngoài việc đổi tên class chứa. -->
    <Border Margin="6" BorderBrush="{DynamicResource XTChromeBorder}" BorderThickness="1"
            CornerRadius="4" Background="{DynamicResource PdfViewerBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ Ribbon 1 hàng mô phỏng tab Home của Foxit (không chia tab) ══
                 Nhóm: Công cụ · Xem · Chú thích · Sắp xếp trang. Thêm nhóm mới (Bookmark, Layer…)
                 bằng cách chép 1 khối DockPanel nhóm + 1 Border phân cách. Điều hướng trang/zoom nằm
                 ở thanh trạng thái dưới đáy như Foxit. -->
            <Border Grid.Row="0" Background="{DynamicResource XTToolbarBackground}"
                    BorderBrush="{DynamicResource XTChromeBorder}" BorderThickness="0,0,0,1"
                    TextElement.Foreground="{DynamicResource XTChromeText}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Orientation="Horizontal" Margin="4,3,4,0">

                        <!-- Công cụ -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="Công cụ" Style="{StaticResource PdfRibbonGroupLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <xt:XTButton Style="{StaticResource PdfRibbonLargeButton}"
                                             Icon="{StaticResource PdfUi.Open}" Text="Mở"
                                             ToolTip="Mở file PDF (hoặc kéo-thả file vào cửa sổ)" Click="ReaderOpenFiles_Click"/>
                                <xt:XTButton x:Name="ReaderHandToolButton" Style="{StaticResource PdfRibbonLargeButton}"
                                             Icon="{StaticResource PdfUi.Hand}" Text="Hand" Tag="Active"
                                             ToolTip="Kéo để cuộn trang (Esc để quay về công cụ này)" Click="ReaderHandTool_Click"/>
                                <StackPanel VerticalAlignment="Top">
                                    <xt:XTButton Style="{StaticResource PdfRibbonSmallButton}" Icon="{StaticResource PdfUi.Undo}"
                                                 Text="Hoàn tác" ToolTip="Hoàn tác (Ctrl+Z)" Click="ReaderUndo_Click"/>
                                    <xt:XTButton Style="{StaticResource PdfRibbonSmallButton}" Icon="{StaticResource PdfUi.Redo}"
                                                 Text="Làm lại" ToolTip="Làm lại (Ctrl+Y)" Click="ReaderRedo_Click"/>
                                    <xt:XTButton Style="{StaticResource PdfRibbonSmallButton}" Icon="{StaticResource PdfUi.OpenExternal}"
                                                 Text="Mở bằng app khác" ToolTip="Mở file bằng ứng dụng PDF mặc định"
                                                 Click="ReaderOpenExternal_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource PdfRibbonGroupSeparator}"/>

                        <!-- Xem (chỉ đổi cách xem, không sửa file) -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="Xem" Style="{StaticResource PdfRibbonGroupLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <xt:XTButton x:Name="ReaderContinuousToggle" Style="{StaticResource PdfRibbonLargeButton}"
                                             Icon="{StaticResource PdfUi.Continuous}" Text="Cuộn liên tục"
                                             ToolTip="Xem cuộn liên tục (lăn chuột cuộn qua các trang, Ctrl+lăn chuột để zoom)"
                                             Click="ReaderContinuousToggle_Click"/>
                                <StackPanel VerticalAlignment="Top">
                                    <xt:XTButton Style="{StaticResource PdfRibbonSmallButton}" Icon="{StaticResource PdfUi.FitPage}"
                                                 Text="Vừa trang" ToolTip="Fit page" Click="ReaderFitPage_Click"/>
                                    <xt:XTButton Style="{StaticResource PdfRibbonSmallButton}" Icon="{StaticResource PdfUi.FitWidth}"
                                                 Text="Vừa chiều rộng" ToolTip="Fit width" Click="ReaderFitWidth_Click"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Top">
                                    <xt:XTButton Style="{StaticResource PdfRibbonSmallButton}" Icon="{StaticResource PdfEdit.RotatePageLeft}"
                                                 Text="Xoay trái" ToolTip="Xoay khung nhìn sang trái (chỉ xem, không đổi file)"
                                                 Click="ReaderRotateLeft_Click"/>
                                    <xt:XTButton Style="{StaticResource PdfRibbonSmallButton}" Icon="{StaticResource PdfEdit.RotatePageRight}"
                                                 Text="Xoay phải" ToolTip="Xoay khung nhìn sang phải (chỉ xem, không đổi file)"
                                                 Click="ReaderRotateRight_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource PdfRibbonGroupSeparator}"/>

                        <!-- Chú thích: bấm để bật công cụ, bấm lại (hoặc Hand/Esc) để tắt -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="Chú thích" Style="{StaticResource PdfRibbonGroupLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <xt:XTButton x:Name="ReaderTypewriterToolButton" Style="{StaticResource PdfRibbonLargeButton}"
                                             Icon="{StaticResource PdfEdit.Typewriter}" Text="Typewriter"
                                             ToolTip="Gõ chữ lên trang: bấm vào chỗ cần ghi, gõ rồi Enter (Shift+Enter xuống dòng). Bấm vào chữ đã ghi để sửa."
                                             Click="ReaderTypewriterTool_Click"/>
                                <xt:XTButton x:Name="ReaderCommentToolButton" Style="{StaticResource PdfRibbonLargeButton}"
                                             Icon="{StaticResource PdfEdit.Comment}" Text="Ghi chú"
                                             ToolTip="Ghi chú dán (sticky note): bấm vào trang, gõ nội dung rồi Enter. Rê chuột lên icon để xem, bấm để sửa."
                                             Click="ReaderCommentTool_Click"/>
                                <xt:XTButton x:Name="ReaderHighlightToolButton" Style="{StaticResource PdfRibbonLargeButton}"
                                             Icon="{StaticResource PdfEdit.Highlight}" Text="Highlight"
                                             ToolTip="Kéo 1 vùng chữ nhật để tô vàng"
                                             Click="ReaderHighlightTool_Click"/>
                            </StackPanel>
                        </DockPanel>
                        <Border Style="{StaticResource PdfRibbonGroupSeparator}"/>

                        <!-- Sắp xếp trang: xoay LƯU file; chèn/xoá đổi workspace (Lưu để ghi ra file) -->
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="Sắp xếp trang" Style="{StaticResource PdfRibbonGroupLabel}"/>
                            <StackPanel Orientation="Horizontal">
                                <xt:XTButton x:Name="ReaderRotatePagesButton" Style="{StaticResource PdfRibbonLargeButton}"
                                             Icon="{StaticResource PdfEdit.RotatePageRight}" Text="Xoay trang ▾"
                                             ToolTip="Xoay THẬT trang đang xem (hoặc các trang đang chọn) và LƯU vào file nguồn"
                                             Click="ReaderRotatePagesMenu_Click">
                                    <xt:XTButton.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Xoay trái 90°" Click="ReaderPageRotateLeft_Click"/>
                                            <MenuItem Header="Xoay phải 90°" Click="ReaderPageRotateRight_Click"/>
                                        </ContextMenu>
                                    </xt:XTButton.ContextMenu>
                                </xt:XTButton>
                                <StackPanel VerticalAlignment="Top">
                                    <xt:XTButton Style="{StaticResource PdfRibbonSmallButton}" Icon="{StaticResource PdfEdit.InsertPages}"
                                                 Text="Chèn" ToolTip="Chèn trang từ file PDF khác vào sau trang đang xem"
                                                 Click="ReaderInsertPages_Click"/>
                                    <xt:XTButton Style="{StaticResource PdfRibbonSmallButton}" Icon="{StaticResource PdfUi.Delete}"
                                                 Text="Xoá" ToolTip="Xoá trang đang xem (hoặc các trang đang chọn) khỏi window này — có thể Undo"
                                                 Click="ReaderDeletePages_Click"/>
                                    <xt:XTButton Style="{StaticResource PdfRibbonSmallButton}" Icon="{StaticResource PdfEdit.ExtractPages}"
                                                 Text="Trích xuất" ToolTip="Xuất trang đang xem (hoặc các trang đang chọn) ra file PDF mới"
                                                 Click="ReaderExtractPages_Click"/>
                                </StackPanel>
                                <xt:XTButton Style="{StaticResource PdfRibbonLargeButton}"
                                             Icon="{StaticResource PdfUi.Merge}" Text="Ghép nhiều file…"
                                             ToolTip="Mở cửa sổ ghép nhiều file (kéo-thả trang giữa các file, ghép/tách, lưu từng nhóm) — có sẵn các file đang mở"
                                             Click="ReaderShowMergeWindow_Click"/>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Tab các file đang mở (như Foxit). Bấm tab = chuyển file, × = đóng file. -->
            <ListBox x:Name="ReaderDocumentTabs" Grid.Row="1" BorderThickness="0,0,0,1" Padding="4,3,4,0"
                     BorderBrush="{DynamicResource XTChromeBorder}" Background="{DynamicResource XTToolbarBackground}"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="ReaderDocumentTabs_SelectionChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="TabBorder" Margin="0,0,2,0" Padding="10,4,4,4" CornerRadius="3,3,0,0"
                                            BorderThickness="1,1,1,0" BorderBrush="Transparent" Background="Transparent">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource XTChromeHoverBackground}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource XTPanelBackground}"/>
                                            <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource XTChromeBorder}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" MaxWidth="260" ToolTip="{Binding SourcePath}">
                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                       VerticalAlignment="Center" Foreground="{DynamicResource XTChromeText}"/>
                            <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{StaticResource PdfUi.Close}"
                                         Width="20" Height="20" MinWidth="20" IconSize="10" Margin="6,0,0,0"
                                         ToolTip="Đóng file" Click="ReaderCloseDocument_Click"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ReaderSidePanelColumn" Width="230" MinWidth="120" MaxWidth="480"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ctl:ReaderSidePanel x:Name="ReaderSidePanel" Grid.Column="0"/>
                <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="{DynamicResource XTChromeBorder}"/>

            <!-- Vùng xem trang + lớp tương tác (ReaderInteractionLayer) phủ trên cả 2 chế độ xem. -->
            <Grid x:Name="ReaderContentHost" Grid.Column="2" ClipToBounds="True"
                  PreviewMouseLeftButtonDown="ReaderContentHost_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="ReaderContentHost_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="ReaderContentHost_PreviewMouseLeftButtonUp"
                  MouseLeave="ReaderContentHost_MouseLeave"
                  LayoutUpdated="ReaderContentHost_LayoutUpdated">
            <ScrollViewer x:Name="ReaderScrollViewer"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource PdfViewerBackgroundBrush}" Padding="16"
                          PreviewMouseWheel="ReaderScrollViewer_PreviewMouseWheel"
                          ScrollChanged="ReaderScrollViewer_ScrollChanged"
                          SizeChanged="ReaderScrollViewer_SizeChanged">
                <Grid>
                    <TextBlock x:Name="ReaderEmptyText" Text="Chọn một trang để xem"
                               Foreground="#BCC6D2" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- ReaderContentCanvas = "sizer" cấp kích thước cuộn CHÍNH XÁC cho
                         ScrollViewer (Width/Height set thẳng bằng code theo công thức, KHÔNG
                         dựa vào WPF tự đo qua LayoutTransform nữa) — Image/tile bên trong định vị
                         bằng Canvas.Left/Top tính sẵn + RenderTransform (Scale/Rotate) chỉ tác
                         động lúc VẼ, không kéo theo 1 lượt đo layout nào khi đổi zoom. Xem
                         ApplyReaderLayout/ZoomReaderAtPoint (ReaderWindow.xaml.cs) — đây là cách
                         các trình xem PDF/ảnh hiện đại (Chrome PDF viewer, Acrobat) giữ zoom mượt
                         và neo đúng điểm con trỏ: KHÔNG đo lại vị trí sau khi zoom, tính trước
                         bằng công thức rồi áp 1 lần duy nhất. -->
                    <Canvas x:Name="ReaderContentCanvas">
                        <Image x:Name="ReaderImage" Stretch="Fill"
                               RenderTransformOrigin="0.5,0.5"
                               RenderOptions.BitmapScalingMode="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderBitmapScalingMode}" Cursor="Hand"
                               MouseLeftButtonDown="ReaderImage_MouseLeftButtonDown"
                               MouseDown="ReaderImage_MouseDown"
                               MouseUp="ReaderImage_MouseUp"
                               MouseMove="ReaderImage_MouseMove"
                               MouseLeftButtonUp="ReaderImage_MouseLeftButtonUp"
                               LostMouseCapture="ReaderImage_LostMouseCapture">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ReaderScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ReaderRotateTransform" Angle="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <!-- Two independent coordinate spaces: old imagery remains visible
                             underneath each new tile until refinement is complete. -->
                        <Canvas x:Name="ReaderTileCanvas" Width="0" Height="0"
                                RenderTransformOrigin="0.5,0.5"
                                ClipToBounds="True" IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ReaderTileScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ReaderTileRotateTransform" Angle="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                        <Canvas x:Name="ReaderTileCanvasB" Width="0" Height="0"
                                RenderTransformOrigin="0.5,0.5"
                                ClipToBounds="True" IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ReaderTileScaleTransformB" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ReaderTileRotateTransformB" Angle="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <!-- Chế độ Cuộn liên tục — TẤT CẢ trang của window đang xem xếp dọc, cuộn
                 mượt qua lại thay vì bấm Trang trước/sau từng cái. KHÔNG bọc ScrollViewer
                 ngoài (giống các ListBox trang bên MainWindow) — dùng thẳng ScrollViewer nội bộ
                 của chính ListBox để ScrollIntoView/virtualization hoạt động đúng, tránh
                 lặp lại bug "2 ScrollViewer giẫm chân nhau" đã gặp trước đó. -->
            <ListBox x:Name="ReaderContinuousList"
                     Background="{DynamicResource PdfViewerBackgroundBrush}" BorderThickness="0" Padding="16"
                     Visibility="Collapsed"
                     ItemTemplate="{StaticResource ReaderContinuousPageTemplate}"
                     HorizontalContentAlignment="Center"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     PreviewMouseWheel="ReaderContinuousList_PreviewMouseWheel"
                     PreviewMouseLeftButtonDown="ReaderContinuousList_MouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="ReaderContinuousList_MouseLeftButtonUp"
                     PreviewMouseMove="ReaderContinuousList_MouseMove"
                     LostMouseCapture="ReaderContinuousList_LostMouseCapture"
                     ScrollViewer.ScrollChanged="ReaderContinuousList_ScrollChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

                <!-- Lớp tương tác chung của Typewriter/Ghi chú/Highlight: không Background nên không
                     chặn chuột; chỉ ô nhập chữ, khung kéo highlight, popup xem ghi chú nằm ở đây. -->
                <Canvas x:Name="ReaderInteractionLayer">
                    <Rectangle x:Name="ReaderHighlightRubberBand" Visibility="Collapsed" IsHitTestVisible="False"
                               Fill="#66FFE600" Stroke="#FFC9A800" StrokeThickness="1"/>
                    <Border x:Name="ReaderCommentHoverPopup" Visibility="Collapsed" IsHitTestVisible="False"
                            MaxWidth="280" Padding="8,6" CornerRadius="3"
                            Background="#FFFFF6C4" BorderBrush="#FFC9A800" BorderThickness="1">
                        <TextBlock x:Name="ReaderCommentHoverText" TextWrapping="Wrap" Foreground="#FF222222" FontSize="12"/>
                    </Border>
                    <TextBox x:Name="ReaderAnnotationEditor" Visibility="Collapsed"
                             AcceptsReturn="True" TextWrapping="NoWrap" MinWidth="120"
                             Padding="1" BorderThickness="1"
                             BorderBrush="{DynamicResource XTSelectionBlue}" Foreground="Black"
                             PreviewKeyDown="ReaderAnnotationEditor_PreviewKeyDown"
                             LostKeyboardFocus="ReaderAnnotationEditor_LostKeyboardFocus"/>
                </Canvas>
            </Grid>
            </Grid>

            <!-- Thanh trạng thái kiểu Foxit: tên trang · điều hướng trang (giữa) · zoom (phải) -->
            <Grid Grid.Row="3" Background="{DynamicResource XTToolbarBackground}" Height="30"
                  TextElement.Foreground="{DynamicResource XTChromeText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ReaderTitleText" Grid.Column="0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Margin="8,0,12,0" Foreground="{DynamicResource XTTextSecondary}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{StaticResource PdfUi.ChevronLeft}"
                                 Height="26" Width="26" ToolTip="Trang trước" Click="ReaderPreviousPage_Click"/>
                    <TextBox x:Name="ReaderPageBox" Width="46" Height="22" Margin="3,0,0,0"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             KeyDown="ReaderPageBox_KeyDown" LostFocus="ReaderPageBox_LostFocus"/>
                    <TextBlock x:Name="ReaderPageTotalText" MinWidth="44" Margin="4,0,6,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource XTTextSecondary}"/>
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{StaticResource PdfUi.ChevronRight}"
                                 Height="26" Width="26" ToolTip="Trang sau" Click="ReaderNextPage_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{StaticResource PdfUi.Minus}"
                                 Height="26" Width="26" ToolTip="Thu nhỏ" Click="ReaderZoomOut_Click"/>
                    <TextBlock x:Name="ReaderZoomText" Width="46" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource XTTextSecondary}"/>
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{StaticResource PdfUi.Plus}"
                                 Height="26" Width="26" ToolTip="Phóng to" Click="ReaderZoomIn_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</xt:XTWindow>
