<UserControl x:Class="XTPdfMergeApp.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xt="clr-namespace:XTCADStyle.Controls;assembly=XTCADStyle"
        xmlns:conv="clr-namespace:XTPdfMergeApp.Converters"
        xmlns:local="clr-namespace:XTPdfMergeApp"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Focusable="True"
        PreviewKeyDown="ReaderWindow_PreviewKeyDown">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XTPdfMergeApp;component/Resources/ReaderResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 1 trang trong chế độ Cuộn liên tục — ảnh độ phân giải READER (nét hơn hẳn
                 thumbnail), Loaded lazy-load + VirtualizingStackPanel (xem ReaderContinuousList)
                 nên chỉ trang đang/gần hiện mới thật sự render. Đặt Ở ĐÂY (Resources của chính
                 ReaderWindow, có x:Class) chứ không phải ReaderResources.xaml dùng chung — vì có
                 Loaded="ReaderContinuousImage_Loaded" (event handler), cần code-behind mới compile
                 được. KHÔNG dùng DropShadowEffect (đã bỏ) — Border này bọc Canvas "sizer" có
                 Width/Height đổi theo MỖI nấc zoom; DropShadowEffect buộc WPF render lại 1 bitmap
                 đổ bóng bằng PHẦN MỀM mỗi khi kích thước phần tử đổi, tức TẤT CẢ trang đang hiện
                 trong viewport đều phải tính lại bóng ở MỖI nấc zoom — đây là nguyên nhân thật của
                 hiện tượng nhấp nháy lúc zoom continuous. Foxit/Chrome PDF không đổ bóng thời gian
                 thực khi đang tương tác — dùng viền tĩnh (BorderBrush/BorderThickness) thay thế.
                 Margin PHẢI scale theo zoom (ContinuousPageMarginConverter), KHÔNG để cố định —
                 ZoomContinuousAtPoint tính vị trí cuộn mới bằng công thức tỉ lệ thuần, giả định
                 TOÀN BỘ chiều cao nội dung (cả trang lẫn khoảng cách giữa các trang) scale đều
                 theo đúng 1 tỉ lệ; margin cố định phá vỡ giả định đó (đúng bug "zoom nhỏ rồi zoom
                 lại bắt nhầm trang" đã gặp). -->
            <DataTemplate x:Key="ReaderContinuousPageTemplate">
                <Border Background="White" HorizontalAlignment="Center"
                        Margin="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderContinuousZoom, Converter={StaticResource ContinuousPageMarginConverter}}"
                        BorderBrush="#33000000" BorderThickness="1">
                    <!-- Canvas = "sizer" — Width/Height = ĐÚNG kích thước Image đã tự đo được
                         (ActualWidth/ActualHeight, ElementName binding tới chính ContinuousPageImage
                         bên dưới) nhân zoom, để VirtualizingStackPanel xếp dọc biết đúng chiều cao
                         từng trang mà cuộn đúng. BẮT BUỘC dùng Canvas, KHÔNG Grid: Grid.MeasureOverride
                         TRUYỀN kích thước của CHÍNH NÓ xuống làm ràng buộc đo cho con — Width/Height
                         của Grid ở đây lại PHỤ THUỘC NGƯỢC vào Image.ActualHeight (ElementName binding),
                         tạo thành VÒNG LẶP TỰ THAM CHIẾU (đúng bug "màn hình đen, ~60 trang cùng lúc
                         visible" đã gặp khi dùng Grid). Canvas.MeasureOverride LUÔN đo con với kích
                         thước VÔ HẠN, không truyền kích thước của chính nó xuống — an toàn. -->
                    <Canvas>
                        <Canvas.Width>
                            <MultiBinding Converter="{StaticResource ContinuousPageSizeConverter}">
                                <Binding ElementName="ContinuousPageImage" Path="ActualWidth"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=local:ReaderWindow}" Path="ReaderContinuousZoom"/>
                            </MultiBinding>
                        </Canvas.Width>
                        <Canvas.Height>
                            <MultiBinding Converter="{StaticResource ContinuousPageSizeConverter}">
                                <Binding ElementName="ContinuousPageImage" Path="ActualHeight"/>
                                <Binding RelativeSource="{RelativeSource AncestorType=local:ReaderWindow}" Path="ReaderContinuousZoom"/>
                            </MultiBinding>
                        </Canvas.Height>
                        <!-- Image giữ kích thước NATIVE CỐ ĐỊNH (không đổi theo zoom) + RenderTransform
                             scale từ góc (0,0) — bắt buộc phải vậy: ZoomContinuousAtPoint neo điểm zoom
                             bằng TranslatePoint vào toạ độ CỤC BỘ của chính Image này (localAnchor); nếu
                             Width/Height của Image đổi theo zoom thì hệ toạ độ cục bộ đó TRÔI theo zoom
                             → neo sai, nhảy lệch khi đổi hướng zoom. Canvas.Left/Top mặc định = 0,0 nên
                             Image nằm đúng góc trên-trái Canvas, khớp RenderTransformOrigin=0,0. -->
                        <Image x:Name="ContinuousPageImage" Source="{Binding ReaderDisplayBitmap}"
                               Width="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderPageBaseWidth}"
                               Stretch="Uniform"
                               RenderTransformOrigin="0,0"
                               RenderOptions.BitmapScalingMode="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderBitmapScalingMode}"
                               Loaded="ReaderContinuousImage_Loaded">
                            <!-- Chưa có bitmap thật (Thumbnail lẫn ReaderBitmap đều null) → giữ chỗ 1
                                 chiều cao NATIVE ước lượng (tỉ lệ A-series) thay vì để co về 0 — nếu
                                 không, Canvas (lấy kích thước thẳng từ ActualHeight của chính Image này)
                                 cũng co về 0 theo, hàng loạt trang chưa tải dồn hết vào 1 màn hình cùng
                                 lúc. Đã có bitmap thật thì converter trả NaN (=Auto) để Stretch=Uniform
                                 tự đo đúng theo bitmap như bình thường. -->
                            <Image.Height>
                                <MultiBinding Converter="{StaticResource ContinuousPagePlaceholderHeightConverter}">
                                    <Binding Path="ReaderDisplayBitmap"/>
                                    <Binding RelativeSource="{RelativeSource AncestorType=local:ReaderWindow}" Path="ReaderPageBaseWidth"/>
                                    <Binding Path="AspectRatio"/>
                                </MultiBinding>
                            </Image.Height>
                            <Image.RenderTransform>
                                <ScaleTransform ScaleX="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderContinuousZoom}"
                                                ScaleY="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderContinuousZoom}"/>
                            </Image.RenderTransform>
                        </Image>
                        <!-- Retain the previous resolution underneath incoming sharp tiles.
                             Both layers use the same top-left page origin. -->
                        <Canvas x:Name="ContinuousTileCanvas" Width="0" Height="0"
                                RenderTransformOrigin="0,0"
                                ClipToBounds="True" IsHitTestVisible="False"
                                Panel.ZIndex="2"
                                Visibility="Collapsed">
                            <!-- BẮT BUỘC có x:Name: ScaleTransform khai báo TĨNH (không binding) và
                                 KHÔNG tên trong DataTemplate bị WPF tự đóng băng (Freeze) làm tối ưu —
                                 gán ScaleX/ScaleY sau đó (ConfigureContinuousTileCanvas) ném
                                 InvalidOperationException "read-only state" NGAY LẦN ĐẦU zoom vượt
                                 ngưỡng cần tile (đúng bug "tile không bao giờ hiện"). Đặt x:Name cho
                                 nó để WPF coi là đối tượng CÓ DANH TÍNH riêng từng instance template,
                                 không còn bị chia sẻ/đóng băng nữa. -->
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="ContinuousTileScaleTransform" ScaleX="1" ScaleY="1"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                        <Canvas x:Name="ContinuousTileCanvasB" Width="0" Height="0"
                                RenderTransformOrigin="0,0"
                                ClipToBounds="True" IsHitTestVisible="False"
                                Panel.ZIndex="2"
                                Visibility="Collapsed">
                            <Canvas.RenderTransform>
                                <ScaleTransform x:Name="ContinuousTileScaleTransformB" ScaleX="1" ScaleY="1"/>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Toàn bộ nội dung dưới đây chuyển nguyên trạng từ MainWindow.xaml (Border "ReaderPanel",
         trước đó là panel nhúng cột 2 của MainContentGrid) — giữ NGUYÊN mọi x:Name/wiring sự
         kiện để phần code-behind (chuyển sang ReaderWindow.xaml.cs ở bước kế) không cần sửa gì
         thêm ngoài việc đổi tên class chứa. -->
    <Border Margin="6" BorderBrush="{DynamicResource CadChromeBorder}" BorderThickness="1"
            CornerRadius="4" Background="{DynamicResource PdfViewerBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0" LastChildFill="True" TextElement.Foreground="{DynamicResource CadChromeText}"
                       Background="{DynamicResource CadToolbarBackground}">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{DynamicResource Mat.ChevronLeft}"
                                 ToolTip="Trang trước" Click="ReaderPreviousPage_Click"/>
                    <TextBox x:Name="ReaderPageBox" Width="46" Height="24" Margin="3,0,0,0"
                             TextAlignment="Center" VerticalContentAlignment="Center"
                             KeyDown="ReaderPageBox_KeyDown" LostFocus="ReaderPageBox_LostFocus"/>
                    <TextBlock x:Name="ReaderPageTotalText" MinWidth="44" Margin="4,0,6,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource CadTextSecondary}"/>
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{DynamicResource Mat.ChevronRight}"
                                 ToolTip="Trang sau" Click="ReaderNextPage_Click"/>
                    <xt:XTButton x:Name="ReaderContinuousToggle" Style="{StaticResource PdfViewerIconButton}"
                                 Icon="{DynamicResource Mat.ViewSequential}"
                                 ToolTip="Xem cuộn liên tục (lăn chuột cuộn qua các trang, Ctrl+lăn chuột để zoom)"
                                 Click="ReaderContinuousToggle_Click"/>
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{DynamicResource Mat.FitToPageOutline}"
                                 ToolTip="Fit page" Click="ReaderFitPage_Click"/>
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{DynamicResource Mat.FitToScreenOutline}"
                                 ToolTip="Fit width" Click="ReaderFitWidth_Click"/>
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{DynamicResource Mat.Minus}"
                                 ToolTip="Thu nhỏ" Click="ReaderZoomOut_Click"/>
                    <TextBlock x:Name="ReaderZoomText" Width="46" TextAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource CadTextSecondary}"/>
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{DynamicResource Mat.Plus}"
                                 ToolTip="Phóng to" Click="ReaderZoomIn_Click"/>
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{DynamicResource Mat.RotateLeft}"
                                 ToolTip="Xoay trái (chỉ xem, không đổi file gốc)" Click="ReaderRotateLeft_Click"/>
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{DynamicResource Mat.RotateRight}"
                                 ToolTip="Xoay phải (chỉ xem, không đổi file gốc)" Click="ReaderRotateRight_Click"/>
                    <xt:XTButton Style="{StaticResource PdfViewerIconButton}" Icon="{DynamicResource Mat.OpenInNew}"
                                 ToolTip="Mở file bằng ứng dụng PDF mặc định" Click="ReaderOpenExternal_Click"/>
                </StackPanel>
                <TextBlock x:Name="ReaderTitleText" VerticalAlignment="Center"
                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="8,0,12,0"/>
            </DockPanel>

            <ScrollViewer x:Name="ReaderScrollViewer" Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          Background="{DynamicResource PdfViewerBackgroundBrush}" Padding="16"
                          PreviewMouseWheel="ReaderScrollViewer_PreviewMouseWheel"
                          ScrollChanged="ReaderScrollViewer_ScrollChanged"
                          SizeChanged="ReaderScrollViewer_SizeChanged">
                <Grid>
                    <TextBlock x:Name="ReaderEmptyText" Text="Chọn một trang để xem"
                               Foreground="#BCC6D2" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <!-- ReaderContentCanvas = "sizer" cấp kích thước cuộn CHÍNH XÁC cho
                         ScrollViewer (Width/Height set thẳng bằng code theo công thức, KHÔNG
                         dựa vào WPF tự đo qua LayoutTransform nữa) — Image/tile bên trong định vị
                         bằng Canvas.Left/Top tính sẵn + RenderTransform (Scale/Rotate) chỉ tác
                         động lúc VẼ, không kéo theo 1 lượt đo layout nào khi đổi zoom. Xem
                         ApplyReaderLayout/ZoomReaderAtPoint (ReaderWindow.xaml.cs) — đây là cách
                         các trình xem PDF/ảnh hiện đại (Chrome PDF viewer, Acrobat) giữ zoom mượt
                         và neo đúng điểm con trỏ: KHÔNG đo lại vị trí sau khi zoom, tính trước
                         bằng công thức rồi áp 1 lần duy nhất. -->
                    <Canvas x:Name="ReaderContentCanvas">
                        <Image x:Name="ReaderImage" Stretch="Fill"
                               RenderTransformOrigin="0.5,0.5"
                               RenderOptions.BitmapScalingMode="{Binding RelativeSource={RelativeSource AncestorType=local:ReaderWindow}, Path=ReaderBitmapScalingMode}" Cursor="Hand"
                               MouseLeftButtonDown="ReaderImage_MouseLeftButtonDown"
                               MouseDown="ReaderImage_MouseDown"
                               MouseUp="ReaderImage_MouseUp"
                               MouseMove="ReaderImage_MouseMove"
                               MouseLeftButtonUp="ReaderImage_MouseLeftButtonUp"
                               LostMouseCapture="ReaderImage_LostMouseCapture">
                            <Image.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ReaderScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ReaderRotateTransform" Angle="0"/>
                                </TransformGroup>
                            </Image.RenderTransform>
                        </Image>
                        <!-- Two independent coordinate spaces: old imagery remains visible
                             underneath each new tile until refinement is complete. -->
                        <Canvas x:Name="ReaderTileCanvas" Width="0" Height="0"
                                RenderTransformOrigin="0.5,0.5"
                                ClipToBounds="True" IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ReaderTileScaleTransform" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ReaderTileRotateTransform" Angle="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                        <Canvas x:Name="ReaderTileCanvasB" Width="0" Height="0"
                                RenderTransformOrigin="0.5,0.5"
                                ClipToBounds="True" IsHitTestVisible="False"
                                Visibility="Collapsed">
                            <Canvas.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="ReaderTileScaleTransformB" ScaleX="1" ScaleY="1"/>
                                    <RotateTransform x:Name="ReaderTileRotateTransformB" Angle="0"/>
                                </TransformGroup>
                            </Canvas.RenderTransform>
                        </Canvas>
                    </Canvas>
                </Grid>
            </ScrollViewer>

            <!-- Chế độ Cuộn liên tục — TẤT CẢ trang của window đang xem xếp dọc, cuộn
                 mượt qua lại thay vì bấm Trang trước/sau từng cái. KHÔNG bọc ScrollViewer
                 ngoài (giống các ListBox trang bên MainWindow) — dùng thẳng ScrollViewer nội bộ
                 của chính ListBox để ScrollIntoView/virtualization hoạt động đúng, tránh
                 lặp lại bug "2 ScrollViewer giẫm chân nhau" đã gặp trước đó. -->
            <ListBox x:Name="ReaderContinuousList" Grid.Row="1"
                     Background="{DynamicResource PdfViewerBackgroundBrush}" BorderThickness="0" Padding="16"
                     Visibility="Collapsed"
                     ItemTemplate="{StaticResource ReaderContinuousPageTemplate}"
                     HorizontalContentAlignment="Center"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling"
                     VirtualizingPanel.ScrollUnit="Pixel"
                     PreviewMouseWheel="ReaderContinuousList_PreviewMouseWheel"
                     PreviewMouseLeftButtonDown="ReaderContinuousList_MouseLeftButtonDown"
                     PreviewMouseLeftButtonUp="ReaderContinuousList_MouseLeftButtonUp"
                     PreviewMouseMove="ReaderContinuousList_MouseMove"
                     LostMouseCapture="ReaderContinuousList_LostMouseCapture"
                     ScrollViewer.ScrollChanged="ReaderContinuousList_ScrollChanged">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel Orientation="Vertical"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>
    </Border>
</UserControl>
