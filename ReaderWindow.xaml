<!-- Cửa sổ CHÍNH của app (App.OnStartup tạo và đặt làm Application.MainWindow): ribbon + tab file +
     panel trái + vùng đọc. Sở hữu DocumentSession (các file đang mở, undo/redo) và mở cửa sổ ghép phụ
     MergeWorkspaceWindow khi bấm "Ghép nhiều file…". -->
<xt:XTWindow x:Class="XTPdfMergeApp.ReaderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
        xmlns:conv="clr-namespace:XTPdfMergeApp.Converters"
        xmlns:local="clr-namespace:XTPdfMergeApp"
        xmlns:ctl="clr-namespace:XTPdfMergeApp.Controls"
        Title="PDF Reader Pro" Width="1280"
        TitleIcon="{StaticResource App.Icon.Logo}" TitleIconBrush="{DynamicResource Ui.Accent}" Height="820"
        MinWidth="760" MinHeight="520" TitleBarMode="Full"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Focusable="True"
        AllowDrop="True" DragOver="ReaderWindow_DragOver" Drop="ReaderWindow_Drop"
        PreviewKeyDown="ReaderWindow_PreviewKeyDown">

    <xt:XTWindow.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
            <!-- Chiều cao title bar lấy từ XTStyle (36 DIP, tương đương nhịp title bar VS Code). -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XTPdfMergeApp;component/Resources/ReaderResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
    </xt:XTWindow.Resources>

    <xt:XTWindow.TitleBarLeftContent>
        <!-- Quick access: bậc 3 icon (nhỏ hơn ribbon và thanh trái, lớn hơn icon trong trang panel — không nhỏ quá). -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
            <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.newdoc}" Width="26" Height="26" IconSize="17" ToolTip="New blank PDF (Ctrl+N)" Click="ReaderNew_Click"/>
            <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.folder}" Width="26" Height="26" IconSize="17" ToolTip="Open (Ctrl+O)" Click="ReaderOpenFiles_Click"/>
            <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.save}" Width="26" Height="26" IconSize="17" ToolTip="Save (Ctrl+S)" Click="ReaderTabSave_Click"/>
            <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.saveas}" Width="26" Height="26" IconSize="17" ToolTip="Save as… (Ctrl+Shift+S)" Click="ReaderTabSaveAs_Click"/>
            <Border Width="1" Height="16" Margin="6,0" Background="{DynamicResource Ui.Border}"/>
            <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.undo}" Width="26" Height="26" IconSize="17" ToolTip="Undo (Ctrl+Z)" Click="ReaderUndo_Click"/>
            <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.redo}" Width="26" Height="26" IconSize="17" ToolTip="Redo (Ctrl+Y)" Click="ReaderRedo_Click"/>
        </StackPanel>
    </xt:XTWindow.TitleBarLeftContent>

    <xt:XTWindow.TitleBarRightContent>
        <!-- Title bar chỉ giữ lệnh toàn cục: kính lúp mở Command Palette (Ctrl+K), Find nội dung vẫn ở ribbon/Ctrl+F. -->
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
            <!-- Wide search box: a click (or Ctrl+K) drops the command palette down right under it. -->
            <xt:XTButton x:Name="TitleSearchButton" Style="{StaticResource UiGhostButton}" Icon="{StaticResource Ui.Icon.search}" Width="260" Height="28"
                         Text="Search commands and files…   Ctrl+K" Margin="0,0,8,0" ToolTip="Command palette (Ctrl+K)" Click="ReaderMore_Click"/>
            <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.settings}" Width="30" Height="30" IconSize="18"
                         ToolTip="Settings" Click="RibbonSettings_Click"/>
            <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.info}" Width="30" Height="30" IconSize="18"
                         ToolTip="About PDF Reader Pro" Click="RibbonAbout_Click"/>
        </StackPanel>
    </xt:XTWindow.TitleBarRightContent>

    <!-- Toàn bộ nội dung dưới đây chuyển nguyên trạng từ MainWindow.xaml (Border "ReaderPanel",
         trước đó là panel nhúng cột 2 của MainContentGrid) — giữ NGUYÊN mọi x:Name/wiring sự
         kiện để phần code-behind (chuyển sang ReaderWindow.xaml.cs ở bước kế) không cần sửa gì
         thêm ngoài việc đổi tên class chứa. -->
    <Grid Background="{DynamicResource Ui.Bg}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ══ Toolbar 1 hàng, nhóm bằng vạch + tên nhóm (Tools/Page view/Comment/Rotate view/Organize/Document),
                 không có tab để bấm chuyển — theo yêu cầu dùng gộp lại 1 hàng thay vì nhiều tab ribbon. Nhóm Document đi ngay
                 sau các nhóm khác, để vùng trống bên phải tự co giãn. Xoay ở nhóm "Rotate view" là xoay KHUNG NHÌN; xoay THẬT nằm ở nhóm Organize.
                 Tag="Active" = công cụ đang bật. ══ -->
            <Border x:Name="ReaderToolbarBar" Grid.Row="0" Height="80" Background="{DynamicResource Ui.Surface}"
                    BorderBrush="{DynamicResource Ui.ToolbarBorder}" BorderThickness="0,0,0,1">
                <DockPanel Margin="8,0">
                    <!-- Same two-row shape as the other groups (button row + caption row, caption invisible), so the icon and the label sit on the
                         same lines as the neighbouring commands instead of being centred in the whole bar. -->
                    <StackPanel DockPanel.Dock="Right" Margin="6,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding Visibility, ElementName=ReaderToolbarMore}">
                        <xt:XTButton x:Name="ReaderToolbarMore" Style="{StaticResource UiRibbonButton}"
                                     Icon="{StaticResource Ui.Icon.tablist}" Text="More tools"
                                     Visibility="Collapsed" ToolTip="Tools that do not fit the window width" Click="ReaderToolbarMore_Click"/>
                        <TextBlock Style="{StaticResource UiGroupCaption}" Text="Tools" Visibility="Hidden"/>
                    </StackPanel>
                    <ScrollViewer x:Name="ReaderToolsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Tools -->
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <xt:XTButton x:Name="ReaderHandToolButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.hand}" Text="Hand"
                                                 ToolTip="Drag to scroll the page (Esc returns to this tool)" Click="ReaderHandTool_Click" Tag="Active"/>
                                    <xt:XTButton x:Name="ReaderSelectToolButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.select}" Text="Select"
                                                 ToolTip="Drag across text to select it, Ctrl+C to copy" Click="ReaderSelectTool_Click"/>
                                    <xt:XTButton x:Name="ReaderMeasureToolButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.ruler}" Text="Measure"
                                                 ToolTip="Drag between two points: the real length at the sheet's scale (Esc clears)" Click="ReaderMeasureTool_Click"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource UiGroupCaption}" Text="Tools"/>
                            </StackPanel>
                            <Border Style="{StaticResource UiToolbarSeparator}"/>
                            <!-- Capture: the screen, kept in the Captures store -->
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <xt:XTButton x:Name="ReaderCaptureButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.capture}" Text="Capture"
                                                 ToolTip="Capture the screen with XT Capture: pick a window, a rectangle, a circle or a polygon. XT Capture also runs from the tray, with its own shortcut." Click="ReaderCapture_Click"/>
                                    <xt:XTButton x:Name="ReaderCapturesButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.captures}" Text="Store"
                                                 ToolTip="The Store of XT Capture: every capture is kept there" Click="ReaderCaptures_Click"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource UiGroupCaption}" Text="Capture"/>
                            </StackPanel>
                            <Border Style="{StaticResource UiToolbarSeparator}"/>
                            <!-- Page view -->
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <xt:XTButton Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.actual}" Text="Actual size"
                                                 ToolTip="Actual size (100%)" Click="ReaderActualSize_Click"/>
                                    <StackPanel VerticalAlignment="Center">
                                        <xt:XTButton Style="{StaticResource UiMiniIconButton}" Width="80" Icon="{StaticResource Ui.Icon.fitp}" Text="Fit page"
                                                     ToolTip="Fit page" Click="ReaderFitPage_Click"/>
                                        <xt:XTButton Style="{StaticResource UiMiniIconButton}" Width="80" Icon="{StaticResource Ui.Icon.fitw}" Text="Fit width"
                                                     ToolTip="Fit width" Click="ReaderFitWidth_Click"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBlock Style="{StaticResource UiGroupCaption}" Text="Page view"/>
                            </StackPanel>
                            <Border Style="{StaticResource UiToolbarSeparator}"/>
                            <!-- Rotate view -->
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <xt:XTButton Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.rotl}" Text="Rotate left"
                                                 ToolTip="Rotate the view left (view only, the file is not changed)" Click="ReaderRotateLeft_Click"/>
                                    <xt:XTButton Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.rotr}" Text="Rotate right"
                                                 ToolTip="Rotate the view right (view only, the file is not changed)" Click="ReaderRotateRight_Click"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource UiGroupCaption}" Text="Rotate view"/>
                            </StackPanel>
                            <Border Style="{StaticResource UiToolbarSeparator}"/>
                            <!-- Comment -->
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <xt:XTButton x:Name="ReaderTypewriterToolButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.type}" Text="Typewriter"
                                                 ToolTip="Type text on the page: click where it goes, type, then Enter (Shift+Enter for a new line). Click existing text to edit." Click="ReaderTypewriterTool_Click"/>
                                    <xt:XTButton x:Name="ReaderCommentToolButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.note}" Text="Note"
                                                 ToolTip="Sticky note: click the page, type, then Enter. Hover the icon to read it, click to edit." Click="ReaderCommentTool_Click"/>
                                    <xt:XTButton x:Name="ReaderCalloutToolButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.callout}" Text="Callout"
                                                 ToolTip="Callout: click the point to highlight, then enter the note text" Click="ReaderCalloutTool_Click"/>
                                    <xt:XTButton x:Name="ReaderPencilToolButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.pencil}" Text="Pencil"
                                                 ToolTip="Draw a freehand PDF Ink stroke. It remains editable/selectable and is saved with the PDF." Click="ReaderPencilTool_Click"/>
                                    <xt:XTButton x:Name="ReaderHighlightTextButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.hl_text}" Text="Highlight text"
                                                 ToolTip="Drag across text to highlight it (needs selectable text)" Click="ReaderHighlightText_Click"/>
                                    <xt:XTButton x:Name="ReaderHighlightAreaButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.hl_area}" Text="Highlight area"
                                                 ToolTip="Drag a rectangle to highlight an area (also works on scanned pages and drawings)" Click="ReaderHighlightArea_Click"/>
                                    <!-- Markup tools stay in a compact 2×2 grid, avoiding a flyout during day-to-day reviewing. -->
                                    <Grid VerticalAlignment="Center">
                                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="82"/><ColumnDefinition Width="62"/></Grid.ColumnDefinitions>
                                        <xt:XTButton x:Name="ReaderUnderlineToolButton" Grid.Row="0" Grid.Column="0" Style="{StaticResource UiMiniIconButton}" Width="82" Icon="{StaticResource Ui.Icon.underline}" Text="Underline"
                                                     ToolTip="Underline: drag across text" Click="ReaderUnderlineTool_Click"/>
                                        <xt:XTButton x:Name="ReaderStrikethroughToolButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource UiMiniIconButton}" Icon="{StaticResource Ui.Icon.strike}" Text="Strike"
                                                     ToolTip="Strikethrough: drag across text" Click="ReaderStrikethroughTool_Click"/>
                                        <xt:XTButton x:Name="ReaderSquigglyToolButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource UiMiniIconButton}" Width="82" Icon="{StaticResource Ui.Icon.squiggly}" Text="Squiggly"
                                                     ToolTip="Squiggly underline: drag across text" Click="ReaderSquigglyTool_Click"/>
                                        <xt:XTButton x:Name="ReaderEraserToolButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource UiMiniIconButton}" Icon="{StaticResource Ui.Icon.eraser}" Text="Eraser"
                                                     ToolTip="Delete an annotation: click it. Undo restores it." Click="ReaderEraserTool_Click"/>
                                    </Grid>
                                </StackPanel>
                                <TextBlock Style="{StaticResource UiGroupCaption}" Text="Comment"/>
                            </StackPanel>
                            <Border Style="{StaticResource UiToolbarSeparator}"/>
                            <!-- Shapes: lưới nhỏ 3 cột x 2 hàng (kiểu Foxit) thay vì mỗi hình 1 nút to riêng — không cần bung popup chọn trước.
                                 2 hàng (thay vì 3) để tên nhóm "Shapes" thẳng hàng với tên các nhóm khác trong ribbon. -->
                            <StackPanel VerticalAlignment="Bottom">
                                <Grid VerticalAlignment="Center">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="64"/><ColumnDefinition Width="68"/></Grid.ColumnDefinitions>
                                    <xt:XTButton x:Name="ReaderShapeRectButton" Grid.Row="0" Grid.Column="0" Style="{StaticResource UiMiniIconButton}"
                                                 Icon="{StaticResource Ui.Icon.shape_rect}" Text="Rect" ToolTip="Rectangle" Click="ReaderShapeRect_Click"/>
                                    <xt:XTButton x:Name="ReaderShapeCloudButton" Grid.Row="0" Grid.Column="1" Style="{StaticResource UiMiniIconButton}"
                                                 Icon="{StaticResource Ui.Icon.shape_cloud}" Text="Cloud" ToolTip="Cloud" Click="ReaderShapeCloud_Click"/>
                                    <xt:XTButton x:Name="ReaderShapeOvalButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource UiMiniIconButton}"
                                                 Icon="{StaticResource Ui.Icon.shape_oval}" Text="Oval" ToolTip="Oval" Click="ReaderShapeOval_Click"/>
                                    <xt:XTButton x:Name="ReaderShapeArrowButton" Grid.Row="1" Grid.Column="0" Style="{StaticResource UiMiniIconButton}"
                                                 Icon="{StaticResource Ui.Icon.shape_arrow}" Text="Arrow" ToolTip="Arrow" Click="ReaderShapeArrow_Click"/>
                                    <xt:XTButton x:Name="ReaderShapeLineButton" Grid.Row="1" Grid.Column="1" Style="{StaticResource UiMiniIconButton}"
                                                 Icon="{StaticResource Ui.Icon.shape_line}" Text="Line" ToolTip="Line" Click="ReaderShapeLine_Click"/>
                                    <xt:XTButton x:Name="ReaderStampToolButton" Grid.Row="1" Grid.Column="2" Style="{StaticResource UiMiniIconButton}"
                                                 Icon="{StaticResource Ui.Icon.stamp}" Text="Stamp" ToolTip="Stamp" Click="ReaderStampTool_Click"/>
                                </Grid>
                                <TextBlock Style="{StaticResource UiGroupCaption}" Text="Shapes"/>
                            </StackPanel>
                            <Border Style="{StaticResource UiToolbarSeparator}"/>
                            <!-- Organize: thao tác trang thật — cùng handler với panel Pages. Merge cũng chỉ là 1 thao tác tổ chức
                                 file, không cần nút to riêng — gộp chung vào đây, đổi icon khác Icon.merge cho khỏi trùng ý xoay/luồng. -->
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <xt:XTButton Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.insert}" Text="Insert"
                                                 ToolTip="Insert pages after the current one" Click="ReaderInsertMenu_Click"/>
                                    <xt:XTButton Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.trash}" Text="Delete"
                                                 ToolTip="Delete the selected page(s)" Click="ReaderDeletePages_Click"/>
                                    <xt:XTButton Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.pagerotl}" Text="Turn left"
                                                 ToolTip="Rotate the page(s) 90° left — saved to the file" Click="ReaderPageRotateLeft_Click"/>
                                    <xt:XTButton Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.pagerotr}" Text="Turn right"
                                                 ToolTip="Rotate the page(s) 90° right — saved to the file" Click="ReaderPageRotateRight_Click"/>
                                    <xt:XTButton Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.extract}" Text="Extract"
                                                 ToolTip="Extract the selected page(s) to a new file" Click="ReaderExtractPages_Click"/>
                                    <xt:XTButton x:Name="ReaderMergeButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.layers}" Text="Merge"
                                                 ToolTip="Open the Merge window: move or copy pages between files, merge, split and save" Click="ReaderShowMergeWindow_Click"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource UiGroupCaption}" Text="Organize"/>
                            </StackPanel>
                            <Border Style="{StaticResource UiToolbarSeparator}"/>
                            <!-- Edit: sửa chữ thật của PDF có lớp chữ (Edit Text); Edit Object (chọn / copy / xoá nét vẽ, hình, ảnh) thêm sau. -->
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <xt:XTButton x:Name="ReaderEditTextToolButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.textbox}" Text="Edit Text"
                                                 ToolTip="Edit the real text of the page: click a piece of text, type, then Enter. Only for pages with a text layer. Ctrl+S saves it into the file." Click="ReaderEditTextTool_Click"/>
                                    <xt:XTButton x:Name="ReaderEditObjectButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.shapes}" Text="Edit Object ▾"
                                                 ToolTip="Drawings and scans: select a line, shape or image (or drag an area), then copy it or delete it from the file." Click="ReaderEditObject_Click"/>
                                    <xt:XTButton x:Name="ReaderBatchFindButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.search}" Text="Find in Area"
                                                 ToolTip="Draw an area on a page, find the text inside it on many pages, then replace or delete it." Click="ReaderBatchFind_Click"/>
                                    <xt:XTButton x:Name="ReaderStampPagesButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.stamp}" Text="Stamp Pages"
                                                 ToolTip="Put your signature or a stamp at the same place on many pages." Click="ReaderStampPages_Click"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource UiGroupCaption}" Text="Edit"/>
                            </StackPanel>
                            <Border Style="{StaticResource UiToolbarSeparator}"/>
                            <!-- Document: đặt sát các nhóm ribbon, không ghim xa bên phải để vùng trống tự co giãn. -->
                            <StackPanel VerticalAlignment="Bottom">
                                <StackPanel Orientation="Horizontal">
                                    <xt:XTButton x:Name="ReaderFindButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.search}" Text="Find"
                                                 ToolTip="Find in document (Ctrl+F)" Click="ReaderFind_Click"/>
                                    <xt:XTButton x:Name="ReaderPrintButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.print}" Text="Print"
                                                 ToolTip="Print (Ctrl+P)" Click="ReaderPrint_Click"/>
                                    <xt:XTButton x:Name="ReaderSecurityButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.lock}" Text="Protect"
                                                 ToolTip="Show document encryption and permissions" Click="ReaderSecurity_Click"/>
                                    <xt:XTButton x:Name="ReaderOcrButton" Style="{StaticResource UiRibbonButton}" Icon="{StaticResource Ui.Icon.selecttext}" Text="OCR"
                                                 ToolTip="Read the text of scanned pages (Vietnamese and Latin letters) into a searchable copy" Click="ReaderOcr_Click"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource UiGroupCaption}" Text="Document"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Tab các file đang mở, dưới toolbar. Bấm tab = chuyển file, × = đóng file, + = mở thêm file. -->
            <StackPanel x:Name="ReaderDocumentTabsRow" Grid.Row="1">
            <Border Height="36" Background="{DynamicResource Ui.TabStrip}" BorderBrush="{DynamicResource Ui.ToolbarBorder}" BorderThickness="0,0,0,1">
            <Grid x:Name="ReaderDocumentTabsStrip" ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <xt:XTButton x:Name="ReaderStartButton" Style="{StaticResource UiTabButton}" Icon="{StaticResource Ui.Icon.home}" Text="Start"
                             Width="76" VerticalAlignment="Bottom" ToolTip="Home: recent files and quick tools" Tag="Active" Click="StartButton_Click"/>
            <!-- Host báo "rộng 0" cho cha nên bề ngang nó nhận được luôn là chỗ còn lại thật, không bị chính các tab làm phình (xem ReaderTabsHost). -->
            <local:ReaderTabsHost x:Name="ReaderTabsHost" Grid.Column="1" ClipToBounds="True" SizeChanged="ReaderTabsHost_SizeChanged">
            <StackPanel Orientation="Horizontal">
            <ListBox x:Name="ReaderDocumentTabs" Height="35" BorderThickness="0" Padding="0"
                     BorderBrush="{DynamicResource Ui.ToolbarBorder}" Background="{DynamicResource Ui.TabStrip}"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="ReaderDocumentTabs_SelectionChanged"
                     AllowDrop="True" PreviewDragOver="ReaderTabs_PreviewDragOver" DragLeave="ReaderTabs_DragLeave" Drop="ReaderTabs_Drop">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter/>
                        </Border>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource UiTabItem}"/>
                </ListBox.ItemContainerStyle>
                <!-- Độ rộng ListBox do UpdateDocumentTabs tính (xem ReaderWindow.DocumentTabs.cs) nên UniformGrid chia đều vừa khít, không dư. -->
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Background="Transparent" ToolTip="{Binding SourcePath}"
                                    PreviewMouseRightButtonDown="ReaderTab_PreviewMouseRightButtonDown"
                                    PreviewMouseLeftButtonDown="ReaderTab_PreviewMouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Save" InputGestureText="Ctrl+S" Click="ReaderTabSave_Click"/>
                                    <MenuItem Header="Save as…" InputGestureText="Ctrl+Shift+S" Click="ReaderTabSaveAs_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Open in default app" Click="ReaderOpenExternal_Click"/>
                                    <MenuItem Header="Replace sheets from revision…" ToolTip="Replace the drawings of this file with the revised ones from another XT plot"
                                              Click="ReaderTabReplaceSheets_Click"/>
                                    <MenuItem Header="Compare with another version…" ToolTip="Overlay the drawings of two versions: red = only in the old one, blue = only in the new one"
                                              Click="ReaderTabCompare_Click"/>
                                    <MenuItem Header="Open file location" Click="ReaderTabOpenLocation_Click"/>
                                    <MenuItem Header="Copy file" Click="ReaderTabCopyFile_Click"/>
                                    <MenuItem Header="Copy as path" Click="ReaderTabCopyPath_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Close" Click="ReaderCloseDocument_Click"/>
                                    <MenuItem Header="Close all tabs" Click="ReaderTabCloseAll_Click"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <Viewbox Width="15" Height="15" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Ui.Icon.documentF}" Fill="{DynamicResource Ui.Brand}"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Grid.Column="1" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            <Ellipse Grid.Column="2" Width="7" Height="7" Margin="8,0,0,0" VerticalAlignment="Center" Fill="{DynamicResource Ui.Warn}"
                                     ToolTip="Unsaved changes (Ctrl+S to save)"
                                     Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                            <xt:XTButton Grid.Column="3" Style="{StaticResource UiTabCloseButton}" Icon="{StaticResource Ui.Icon.close}" Width="20" Height="20"
                                         IconSize="11" Margin="8,0,0,0" ToolTip="Close file" Click="ReaderCloseDocument_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                <xt:XTButton x:Name="ReaderAddTabButton" Style="{StaticResource UiTabAddButton}"
                             Icon="{StaticResource Ui.Icon.plus}" Width="32" Height="34" IconSize="16" ToolTip="Open another file (Ctrl+O)"
                             Click="ReaderOpenFiles_Click"/>
            </StackPanel>
            </local:ReaderTabsHost>
                <!-- Vạch báo vị trí khi kéo tab file này lên tab khác để ghép (trước / sau tab đích). -->
                <Border x:Name="ReaderTabDropLine" Grid.ColumnSpan="3" Width="3" Height="26" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="0,0,0,4" CornerRadius="1.5" Background="{DynamicResource Ui.Accent}" IsHitTestVisible="False" Visibility="Collapsed"
                        Panel.ZIndex="10"/>
                <xt:XTButton x:Name="ReaderTabsOverflowButton" Grid.Column="2" Style="{StaticResource UiTabAddButton}"
                             Icon="{StaticResource Ui.Icon.tablist}" Width="32" Height="34" IconSize="18" Visibility="Collapsed"
                             ToolTip="All open tabs" Click="ReaderTabsOverflow_Click"/>
            </Grid>
            </Border>

            <!-- Thanh vàng: file đang xem đã bị đổi trên đĩa (Reload / Ignore). -->
            <Border x:Name="DiskChangedBanner" Visibility="Collapsed" Height="40" Padding="16,0"
                    Background="{DynamicResource Ui.WarnSoft}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <xt:XTButton DockPanel.Dock="Right" Style="{StaticResource UiGhostButton}" Text="Ignore" Height="26" Padding="10,0" Margin="8,0,0,0" Click="BannerIgnore_Click"/>
                    <xt:XTButton DockPanel.Dock="Right" Style="{StaticResource UiGhostButton}" Text="Reload" Height="26" Padding="10,0" Click="BannerReload_Click"/>
                    <Viewbox DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,10,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Ui.Icon.alert}" Fill="{DynamicResource Ui.Warn}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="DiskChangedText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ui.Text}"/>
                </DockPanel>
            </Border>
            </StackPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ReaderSidePanelColumn" Width="364" MinWidth="304" MaxWidth="640"/>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ctl:ReaderSidePanel x:Name="ReaderSidePanel" Grid.Column="0"/>
                <GridSplitter x:Name="ReaderPanelSplitter" Grid.Column="1" Width="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              ResizeBehavior="PreviousAndNext" Background="{DynamicResource Ui.Border}"/>

            <!-- Vùng xem trang + lớp tương tác (ReaderInteractionLayer) phủ trên cả 2 chế độ xem. -->
            <Grid x:Name="ReaderContentHost" Grid.Column="2" ClipToBounds="True"
                  PreviewMouseLeftButtonDown="ReaderContentHost_PreviewMouseLeftButtonDown"
                  PreviewMouseMove="ReaderContentHost_PreviewMouseMove"
                  PreviewMouseLeftButtonUp="ReaderContentHost_PreviewMouseLeftButtonUp"
                  PreviewMouseRightButtonUp="ReaderContent_AnnotationContextMenu"
                  MouseLeave="ReaderContentHost_MouseLeave"
                  LayoutUpdated="ReaderContentHost_LayoutUpdated">
            <TextBlock x:Name="ReaderEmptyText" Text="Select a page to view" Foreground="{DynamicResource Ui.Muted}" FontSize="14"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>

            <!-- Chế độ Cuộn liên tục kiểu Foxit: MỘT vùng vẽ tự vẽ mọi trang đang hiện (Controls/ContinuousPdfView) —
                 không ListBox/phần tử cho từng trang. Cuộn/zoom chỉ đổi vài con số rồi vẽ lại ngay bằng ảnh đang có. -->
            <ctl:ContinuousPdfView x:Name="ReaderContinuousView"
                                   Background="{DynamicResource PdfViewerBackgroundBrush}"/>

                <!-- Lớp tương tác chung của Typewriter/Ghi chú/Highlight: không Background nên không
                     chặn chuột; chỉ ô nhập chữ, khung kéo highlight, popup xem ghi chú nằm ở đây. -->
                <Canvas x:Name="ReaderInteractionLayer">
                    <Canvas.Resources>
                        <Style x:Key="ShapeGrip" TargetType="Rectangle">
                            <Setter Property="Width" Value="8"/>
                            <Setter Property="Height" Value="8"/>
                            <Setter Property="Fill" Value="White"/>
                            <Setter Property="Stroke" Value="{DynamicResource Ui.Accent}"/>
                            <Setter Property="StrokeThickness" Value="1.5"/>
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Setter Property="Panel.ZIndex" Value="5"/>
                        </Style>
                    </Canvas.Resources>
                    <Polyline x:Name="ReaderInkPreview" Stroke="{DynamicResource Ui.Accent}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                              IsHitTestVisible="False" Visibility="Collapsed"/>
                    <Border x:Name="AnnotationSelectionBox" Visibility="Collapsed" IsHitTestVisible="False" BorderThickness="1.5" CornerRadius="3"
                            BorderBrush="{DynamicResource Ui.Accent}" Background="#1A2563EB"/>
                    <!-- Vẽ/resize hình (Rect/Cloud dùng Rectangle bo góc, Oval dùng Ellipse, Line/Arrow dùng Line + mũi tên): xem trước bằng
                         chính màu/nét sẽ ghi vào PDF ngay khi kéo, không đợi thả chuột mới hiện. -->
                    <Rectangle x:Name="ReaderShapeRubber" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Ellipse x:Name="ReaderShapeOvalPreview" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Line x:Name="ReaderShapeRubberLine" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <Polygon x:Name="ReaderShapeArrowHead" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <!-- Công cụ Measure: đoạn đo + nhãn độ dài thật (không ghi vào PDF). -->
                    <Line x:Name="ReaderMeasureLine" Visibility="Collapsed" IsHitTestVisible="False" Stroke="#E67E22" StrokeThickness="2" StrokeDashArray="5,3"/>
                    <Border x:Name="ReaderMeasureLabel" Visibility="Collapsed" IsHitTestVisible="False" Background="#E6222B38" CornerRadius="4" Padding="8,3">
                        <TextBlock x:Name="ReaderMeasureText" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                    </Border>
                    <!-- Grip resize hình đã chọn (kiểu Foxit): 8 ô ở góc/cạnh, kéo trực tiếp để đổi kích thước. -->
                    <Rectangle x:Name="GripNW" Style="{StaticResource ShapeGrip}" Cursor="SizeNWSE" Tag="NW" PreviewMouseLeftButtonDown="Grip_MouseDown"/>
                    <Rectangle x:Name="GripN" Style="{StaticResource ShapeGrip}" Cursor="SizeNS" Tag="N" PreviewMouseLeftButtonDown="Grip_MouseDown"/>
                    <Rectangle x:Name="GripNE" Style="{StaticResource ShapeGrip}" Cursor="SizeNESW" Tag="NE" PreviewMouseLeftButtonDown="Grip_MouseDown"/>
                    <Rectangle x:Name="GripE" Style="{StaticResource ShapeGrip}" Cursor="SizeWE" Tag="E" PreviewMouseLeftButtonDown="Grip_MouseDown"/>
                    <Rectangle x:Name="GripSE" Style="{StaticResource ShapeGrip}" Cursor="SizeNWSE" Tag="SE" PreviewMouseLeftButtonDown="Grip_MouseDown"/>
                    <Rectangle x:Name="GripS" Style="{StaticResource ShapeGrip}" Cursor="SizeNS" Tag="S" PreviewMouseLeftButtonDown="Grip_MouseDown"/>
                    <Rectangle x:Name="GripSW" Style="{StaticResource ShapeGrip}" Cursor="SizeNESW" Tag="SW" PreviewMouseLeftButtonDown="Grip_MouseDown"/>
                    <Rectangle x:Name="GripW" Style="{StaticResource ShapeGrip}" Cursor="SizeWE" Tag="W" PreviewMouseLeftButtonDown="Grip_MouseDown"/>
                    <!-- Line/Arrow: 2 grip đầu mút thay cho 8 ô (kéo tự do, không giữ khung chữ nhật). -->
                    <Rectangle x:Name="GripLineA" Style="{StaticResource ShapeGrip}" Cursor="Cross" Tag="LineA" PreviewMouseLeftButtonDown="GripLine_MouseDown"/>
                    <Rectangle x:Name="GripLineB" Style="{StaticResource ShapeGrip}" Cursor="Cross" Tag="LineB" PreviewMouseLeftButtonDown="GripLine_MouseDown"/>
                    <Rectangle x:Name="ReaderHighlightRubberBand" Visibility="Collapsed" IsHitTestVisible="False"
                               Fill="#66FFE600" Stroke="#FFC9A800" StrokeThickness="1"/>
                    <Rectangle x:Name="TextSelectDragRubber" Visibility="Collapsed" IsHitTestVisible="False"
                               Fill="#332563EB" IsEnabled="False"/>
                    <Border x:Name="ReaderCommentHoverPopup" Visibility="Collapsed" IsHitTestVisible="False"
                            MaxWidth="280" Padding="8,6" CornerRadius="3"
                            Background="#FFFFF6C4" BorderBrush="#FFC9A800" BorderThickness="1">
                        <TextBlock x:Name="ReaderCommentHoverText" TextWrapping="Wrap" Foreground="#FF222222" FontSize="12"/>
                    </Border>
                    <TextBox x:Name="ReaderAnnotationEditor" Visibility="Collapsed"
                             AcceptsReturn="True" TextWrapping="NoWrap" MinWidth="120"
                             Padding="1" BorderThickness="1"
                             BorderBrush="{DynamicResource XTSelectionBlue}" Foreground="Black"
                             PreviewKeyDown="ReaderAnnotationEditor_PreviewKeyDown"
                             TextChanged="ReaderAnnotationEditor_TextChanged"
                             LostKeyboardFocus="ReaderAnnotationEditor_LostKeyboardFocus" SizeChanged="ReaderAnnotationEditor_SizeChanged"/>
                    <!-- Text box chrome like Edge's PDF viewer: dashed outline, grip on the left (drag = move), circle on the right (drag = width). -->
                    <TextBlock x:Name="TextHint" Text="Start typing here…" Visibility="Collapsed" IsHitTestVisible="False" Foreground="#80000000" Panel.ZIndex="4"/>
                    <Rectangle x:Name="TextChromeBox" Visibility="Collapsed" IsHitTestVisible="False" Stroke="#FF2F6FED" StrokeThickness="1.5" StrokeDashArray="4 3" Fill="Transparent" RadiusX="2" RadiusY="2" Panel.ZIndex="5"/>
                    <Border x:Name="TextGrip" Tag="TextGrip" Visibility="Collapsed" Width="14" Height="28" CornerRadius="3" Background="#FF2F6FED" Cursor="SizeAll" Panel.ZIndex="6"
                            ToolTip="Drag to move" PreviewMouseLeftButtonDown="TextGrip_MouseDown">
                        <Viewbox Width="10" Height="14"><Canvas Width="10" Height="14">
                            <Path Fill="White" Data="M1,1 h3 v3 h-3 z M6,1 h3 v3 h-3 z M1,5.5 h3 v3 h-3 z M6,5.5 h3 v3 h-3 z M1,10 h3 v3 h-3 z M6,10 h3 v3 h-3 z"/>
                        </Canvas></Viewbox>
                    </Border>
                    <Border x:Name="ShapeTTop" Tag="Top" Visibility="Collapsed" Width="18" Height="18" CornerRadius="9" Background="#FF2F6FED" Cursor="Hand" Panel.ZIndex="6"
                            ToolTip="Add text to this side" PreviewMouseLeftButtonDown="ShapeT_MouseDown">
                        <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="ShapeTRight" Tag="Right" Visibility="Collapsed" Width="18" Height="18" CornerRadius="9" Background="#FF2F6FED" Cursor="Hand" Panel.ZIndex="6"
                            ToolTip="Add text to this side" PreviewMouseLeftButtonDown="ShapeT_MouseDown">
                        <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="ShapeTBottom" Tag="Bottom" Visibility="Collapsed" Width="18" Height="18" CornerRadius="9" Background="#FF2F6FED" Cursor="Hand" Panel.ZIndex="6"
                            ToolTip="Add text to this side" PreviewMouseLeftButtonDown="ShapeT_MouseDown">
                        <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Border x:Name="ShapeTLeft" Tag="Left" Visibility="Collapsed" Width="18" Height="18" CornerRadius="9" Background="#FF2F6FED" Cursor="Hand" Panel.ZIndex="6"
                            ToolTip="Add text to this side" PreviewMouseLeftButtonDown="ShapeT_MouseDown">
                        <TextBlock Text="T" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <Ellipse x:Name="TextWidthHandle" Tag="TextWidth" Visibility="Collapsed" Width="12" Height="12" Fill="White" Stroke="#FF2F6FED" StrokeThickness="2" Cursor="SizeWE" Panel.ZIndex="6"
                             ToolTip="Drag to change the width" PreviewMouseLeftButtonDown="TextWidthHandle_MouseDown"/>
                </Canvas>

                <!-- Định dạng Typewriter: font, cỡ, đậm/nghiêng, màu. Hiện khi chọn công cụ Typewriter hoặc chọn 1 đoạn chữ đã đặt. Không nhận focus để ô gõ không bị đóng. -->
                <Border x:Name="TextFormatBar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0" Panel.ZIndex="19"
                        Padding="8,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Surface}">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" Direction="270"/></Border.Effect>
                    <Border.Resources>
                        <Style x:Key="FmtToggle" TargetType="ToggleButton">
                            <Setter Property="Focusable" Value="False"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Width="28" Height="28" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/></Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>
                    <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ComboBox x:Name="FmtFont" Width="150" Height="28" Focusable="False" SelectionChanged="FmtControl_Changed" ToolTip="Font"/>
                        <ComboBox x:Name="FmtSize" Width="66" Height="28" Margin="6,0,0,0" Focusable="False" SelectionChanged="FmtControl_Changed" ToolTip="Font size (pt)"/>
                        <ToggleButton x:Name="FmtBold" Style="{StaticResource FmtToggle}" Margin="8,0,2,0" Click="FmtControl_Changed" ToolTip="Bold">
                            <TextBlock Text="B" FontWeight="Bold" Foreground="{DynamicResource Ui.Text}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FmtItalic" Style="{StaticResource FmtToggle}" Click="FmtControl_Changed" ToolTip="Italic">
                            <TextBlock Text="I" FontStyle="Italic" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FmtUnderline" Style="{StaticResource FmtToggle}" Click="FmtControl_Changed" ToolTip="Underline">
                            <TextBlock Text="U" TextDecorations="Underline" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}"/>
                        </ToggleButton>
                        <Border Width="1" Height="18" Margin="6,0" Background="{DynamicResource Ui.Border}"/>
                        <ToggleButton x:Name="FmtAlignLeft" Style="{StaticResource FmtToggle}" Click="FmtAlign_Click" Tag="0" ToolTip="Align left">
                            <Path Stroke="{DynamicResource Ui.Text}" StrokeThickness="1.6" Data="M2,4 h14 M2,9 h9 M2,14 h12" Width="18" Height="18"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FmtAlignCenter" Style="{StaticResource FmtToggle}" Click="FmtAlign_Click" Tag="1" ToolTip="Centre">
                            <Path Stroke="{DynamicResource Ui.Text}" StrokeThickness="1.6" Data="M2,4 h14 M4.5,9 h9 M3,14 h12" Width="18" Height="18"/>
                        </ToggleButton>
                        <ToggleButton x:Name="FmtAlignRight" Style="{StaticResource FmtToggle}" Click="FmtAlign_Click" Tag="2" ToolTip="Align right">
                            <Path Stroke="{DynamicResource Ui.Text}" StrokeThickness="1.6" Data="M2,4 h14 M7,9 h9 M4,14 h12" Width="18" Height="18"/>
                        </ToggleButton>
                        <Border Width="1" Height="18" Margin="6,0,8,0" Background="{DynamicResource Ui.Border}"/>
                        <StackPanel x:Name="FmtColors" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <ComboBox x:Name="FmtOpacityBox" Width="70" Height="28" Margin="8,0,0,0" Focusable="False" SelectionChanged="FmtOpacity_Changed" ToolTip="Text opacity"/>
                        <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource Ui.Border}"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.copy}" Width="28" Height="28" IconSize="16" ToolTip="Duplicate" Click="PropDuplicate_Click"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.up2}" Width="28" Height="28" IconSize="16" ToolTip="Bring to front" Click="PropFront_Click"/>
                    </StackPanel>
                    <!-- Callout only: the arrow and the box (line colour/width, arrow head, box fill, border). -->
                    <StackPanel x:Name="CalloutRow" Orientation="Horizontal" Margin="0,6,0,0" Visibility="Collapsed">
                        <TextBlock Text="Line" VerticalAlignment="Center" Margin="2,0,6,0" Foreground="{DynamicResource Ui.Muted}"/>
                        <StackPanel x:Name="CalloutLineColors" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CalloutWidthBox" Width="70" Height="28" Margin="8,0,0,0" Focusable="False" SelectionChanged="CalloutStyle_Changed" ToolTip="Line width"/>
                        <ComboBox x:Name="CalloutArrowBox" Width="86" Height="28" Margin="6,0,0,0" Focusable="False" SelectionChanged="CalloutStyle_Changed" ToolTip="Arrow head">
                            <ComboBoxItem Content="No arrow" Tag="0"/>
                            <ComboBoxItem Content="Open" Tag="1"/>
                            <ComboBoxItem Content="Closed" Tag="2"/>
                        </ComboBox>
                        <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource Ui.Border}"/>
                        <TextBlock Text="Fill" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Ui.Muted}"/>
                        <StackPanel x:Name="CalloutFillColors" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="CalloutBorderToggle" Style="{StaticResource FmtToggle}" Margin="8,0,0,0" Click="CalloutStyle_Changed" ToolTip="Box border">
                            <Path Stroke="{DynamicResource Ui.Text}" StrokeThickness="1.6" Data="M3,3 h12 v12 h-12 z" Width="18" Height="18"/>
                        </ToggleButton>
                    </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Màu của Highlight/Underline/Strikethrough: hiện khi chọn công cụ đó hoặc chọn 1 chú thích loại này đã có (double-click hoặc bấm chọn = xem "thuộc tính"). -->
                <Border x:Name="MarkupColorBar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0" Panel.ZIndex="19"
                        Padding="8,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Surface}">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" Direction="270"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Colour" VerticalAlignment="Center" Margin="2,0,10,0" Foreground="{DynamicResource Ui.Muted}"/>
                        <StackPanel x:Name="MarkupColorSwatches" Orientation="Horizontal" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- After dragging across text with the Select tool: one click to highlight / underline / strike / squiggle it, add a note at it, or copy it. -->
                <Border x:Name="TextSelectionBar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0" Panel.ZIndex="19"
                        Padding="4" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Surface}">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" Direction="270"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.hl_text}" Width="32" Height="32" IconSize="20" ToolTip="Highlight" Click="SelBarHighlight_Click"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.underline}" Width="32" Height="32" IconSize="20" ToolTip="Underline" Click="SelBarUnderline_Click"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.strike}" Width="32" Height="32" IconSize="20" ToolTip="Strikethrough" Click="SelBarStrike_Click"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.squiggly}" Width="32" Height="32" IconSize="20" ToolTip="Squiggly underline" Click="SelBarSquiggly_Click"/>
                        <Border Width="1" Height="20" Margin="4,0" Background="{DynamicResource Ui.Border}"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.note}" Width="32" Height="32" IconSize="20" ToolTip="Add a note at this text" Click="SelBarNote_Click"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.copy}" Width="32" Height="32" IconSize="20" ToolTip="Copy" Click="SelBarCopy_Click"/>
                    </StackPanel>
                </Border>

                <!-- Kiểu nét của hình vẽ: màu + độ dày. Hiện khi chọn công cụ Shapes hoặc chọn 1 hình đã vẽ. -->
                <Border x:Name="ShapeBar" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,14,0,0" Panel.ZIndex="19"
                        Padding="8,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Surface}">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" Direction="270"/></Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <StackPanel x:Name="ShapeColors" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource Ui.Border}"/>
                        <ComboBox x:Name="ShapeWidthBox" Width="80" Height="28" Focusable="False" SelectionChanged="ShapeWidth_Changed" ToolTip="Line width"/>
                        <ComboBox x:Name="ShapeDashBox" Width="80" Height="28" Margin="6,0,0,0" Focusable="False" SelectionChanged="ShapeDash_Changed" ToolTip="Line style"/>
                        <ComboBox x:Name="ShapeFillBox" Width="104" Height="28" Margin="6,0,0,0" Focusable="False" SelectionChanged="ShapeFill_Changed" ToolTip="Fill colour"/>
                        <ComboBox x:Name="ShapeOpacityBox" Width="70" Height="28" Margin="6,0,0,0" Focusable="False" SelectionChanged="ShapeOpacity_Changed" ToolTip="Opacity"/>
                        <Border Width="1" Height="18" Margin="8,0" Background="{DynamicResource Ui.Border}"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.copy}" Width="28" Height="28" IconSize="16" ToolTip="Duplicate" Click="PropDuplicate_Click"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.up2}" Width="28" Height="28" IconSize="16" ToolTip="Bring to front" Click="PropFront_Click"/>
                    </StackPanel>
                </Border>

                <!-- Popup Find kiểu Visual Studio (Ctrl+F): ô tìm, trước/sau, đóng; hàng 2: khớp hoa/thường, nguyên từ, phạm vi. -->
                <Border x:Name="FindBar" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,26,0" Panel.ZIndex="20"
                        Padding="4,6,8,6" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Surface}">
                    <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.2" Direction="270"/></Border.Effect>
                    <Border.Resources>
                        <Style x:Key="FindToggle" TargetType="ToggleButton">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Width="32" Height="28" CornerRadius="5" BorderThickness="1" BorderBrush="Transparent" Background="Transparent">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Border.Resources>
                    <DockPanel>
                        <xt:XTButton x:Name="FindBarExpand" DockPanel.Dock="Left" VerticalAlignment="Top" Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.chevd}"
                                     Width="24" Height="28" IconSize="14" ToolTip="Show / hide the search options" Click="FindBarExpand_Click"/>
                        <StackPanel>
                            <DockPanel>
                                <xt:XTButton DockPanel.Dock="Right" Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.close}" Width="28" Height="28" ToolTip="Close (Esc)" Click="FindClose_Click"/>
                                <xt:XTButton DockPanel.Dock="Right" Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.down2}" Width="28" Height="28" ToolTip="Next match (Enter / F3)" Click="FindNext_Click"/>
                                <xt:XTButton DockPanel.Dock="Right" Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.up2}" Width="28" Height="28" ToolTip="Previous match (Shift+Enter / Shift+F3)" Click="FindPrev_Click"/>
                                <Border Width="250" Height="28" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Bg}" Margin="0,0,4,0">
                                    <DockPanel>
                                        <Viewbox DockPanel.Dock="Right" Width="15" Height="15" Margin="0,0,8,0">
                                            <Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.search}" Fill="{DynamicResource Ui.Muted}"/></Canvas>
                                        </Viewbox>
                                        <TextBlock x:Name="FindBarCount" DockPanel.Dock="Right" Margin="6,0,6,0" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Muted}"/>
                                        <Grid>
                                            <TextBox x:Name="FindBarQuery" BorderThickness="0" Background="Transparent" Padding="8,0,0,0" VerticalContentAlignment="Center"
                                                     Foreground="{DynamicResource Ui.Text}" TextChanged="FindBarQuery_TextChanged" PreviewKeyDown="FindBarQuery_PreviewKeyDown"/>
                                            <TextBlock x:Name="FindBarHint" Text="Find…" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource Ui.Muted}"/>
                                        </Grid>
                                    </DockPanel>
                                </Border>
                            </DockPanel>
                            <StackPanel x:Name="FindBarOptions" Orientation="Horizontal" Margin="0,6,0,0">
                                <ToggleButton x:Name="FindBarCase" Style="{StaticResource FindToggle}" ToolTip="Match case" Click="FindBarOption_Click">
                                    <TextBlock Text="Ab" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}"/>
                                </ToggleButton>
                                <ToggleButton x:Name="FindBarWord" Style="{StaticResource FindToggle}" Margin="4,0,8,0" ToolTip="Whole word" Click="FindBarOption_Click">
                                    <TextBlock Text="ab" FontWeight="SemiBold" TextDecorations="Underline" Foreground="{DynamicResource Ui.Text}"/>
                                </ToggleButton>
                                <ComboBox x:Name="FindBarScope" Width="176" Height="28" SelectedIndex="0" SelectionChanged="FindBarOption_Click">
                                    <ComboBoxItem Content="This document"/>
                                    <ComboBoxItem Content="All open documents"/>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </Grid>
            </Grid>

            <!-- Màn hình Start (Recent, Quick locations, Quick tools): tự hiện khi chưa mở file nào. -->
            <ctl:StartPage x:Name="StartPage" Grid.Row="2" Visibility="Collapsed"/>

            <!-- Bảng lệnh Ctrl+K: phủ toàn cửa sổ, nền mờ; bấm ra ngoài hoặc Esc để đóng. -->
            <!-- Màn hình Merge: mỗi file một cửa sổ con (Controls/MergeView). -->

            <ctl:CommandPalette x:Name="Palette" Grid.RowSpan="4"/>

            <!-- Thanh trạng thái: đường dẫn · điều hướng trang (giữa) · zoom (phải) -->
            <Grid x:Name="ReaderStatusBar" Grid.Row="3" Background="{DynamicResource Ui.Panel}" Height="30"
                  TextElement.Foreground="{DynamicResource Ui.Muted}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.ColumnSpan="3" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="ReaderTitleText" Grid.Column="0" VerticalAlignment="Center" FontSize="12"
                           TextTrimming="CharacterEllipsis" Margin="12,0,12,0" Foreground="{DynamicResource Ui.Muted}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.chevl}"
                                 ToolTip="Previous page" Click="ReaderPreviousPage_Click"/>
                    <TextBox x:Name="ReaderPageBox" Style="{StaticResource UiStatusPageBox}" Width="42" Margin="3,0,0,0"
                             TextAlignment="Center" MaxLength="6" ToolTip="Type a page number, then press Enter"
                             KeyDown="ReaderPageBox_KeyDown" LostFocus="ReaderPageBox_LostFocus"/>
                    <TextBlock x:Name="ReaderPageTotalText" MinWidth="44" Margin="6,0,6,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Ui.Muted}"/>
                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.chevr}"
                                 ToolTip="Next page" Click="ReaderNextPage_Click"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock x:Name="ReaderPresenceText" Visibility="Collapsed" MaxWidth="220" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource Ui.Muted}"/>
                    <!-- Tiến độ nạp file vào bộ đệm (đọc nền) — hết khi nạp xong. Không chặn thao tác. -->
                    <TextBlock x:Name="ReaderLoadProgressText" Visibility="Collapsed" VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="{DynamicResource Ui.Muted}"
                               ToolTip="Reading the whole file into the cache. The page you are viewing is always read first."/>
                    <!-- Bố cục trang: cùng nút/handler với nhóm "Page view" trên ribbon, chỉ đồng bộ Tag="Active". -->
                    <xt:XTButton x:Name="ReaderStatusSingleButton" Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.singlepage}"
                                 ToolTip="Single page" Click="ReaderViewSingle_Click"/>
                    <xt:XTButton x:Name="ReaderStatusContinuousButton" Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.scroll}"
                                 Margin="2,0,0,0" ToolTip="Continuous scrolling" Click="ReaderViewContinuous_Click"/>
                    <xt:XTButton x:Name="ReaderStatusTwoPageButton" Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.twopage}"
                                 Margin="2,0,10,0" ToolTip="Two-page view" Click="ReaderViewTwoPage_Click"/>
                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.min}"
                                 ToolTip="Zoom out (-)" Click="ReaderZoomOut_Click"/>
                    <Slider x:Name="ReaderZoomSlider" Style="{StaticResource UiSlider}" Width="90" Margin="4,0" VerticalAlignment="Center"
                            Minimum="0.2236" Maximum="5.6569" IsSnapToTickEnabled="False" ValueChanged="ReaderZoomSlider_ValueChanged"/>
                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.plus}"
                                 ToolTip="Zoom in (+)" Click="ReaderZoomIn_Click"/>
                    <TextBlock x:Name="ReaderZoomText" Width="46" TextAlignment="Center" Margin="4,0,0,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.max}" Margin="10,0,0,0"
                                 ToolTip="Full screen (F11)" Click="ReaderFullScreen_Click"/>
                </StackPanel>
            </Grid>
    </Grid>
</xt:XTWindow>
