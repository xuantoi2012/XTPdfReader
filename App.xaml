<Application x:Class="XTPdfMergeApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XTStyle;component/Themes/Generic.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/XTStyle;component/Themes/Light.xaml"/>
                <ResourceDictionary Source="Resources/UiTokens.Light.xaml"/>
                <ResourceDictionary Source="Resources/UiIcons.xaml"/>
                <ResourceDictionary Source="Resources/AppBrand.xaml"/>
                <ResourceDictionary Source="Resources/UiStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
