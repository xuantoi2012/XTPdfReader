<UserControl x:Class="XTPdfMergeApp.Controls.FindPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
             xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
             FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <Style x:Key="OptionChip" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" CornerRadius="9" Height="24" Padding="9,0" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="Transparent">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border x:Name="Box" Width="14" Height="14" CornerRadius="3" BorderThickness="1.5" BorderBrush="{DynamicResource Ui.Muted}" Margin="0,0,6,0">
                                    <Viewbox Width="10" Height="10">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="Tick" Data="{StaticResource Ui.Icon.check}" Stroke="{DynamicResource Ui.OnAccent}" StrokeThickness="3.4"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <TextBlock Text="{TemplateBinding Content}" Foreground="{DynamicResource Ui.Text}"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Ui.Accent}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScopeItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Height="26" Padding="12,0" CornerRadius="5" Background="Transparent">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Muted}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XTPrimaryButtonBackground}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Ui.OnAccent}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dòng tiêu đề nhóm (Page N) không chọn được. -->
        <Style x:Key="FindRowItem" TargetType="ListBoxItem" BasedOn="{StaticResource UiRowItem}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Focusable" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type local:FindGroupHeader}">
            <StackPanel Orientation="Horizontal" Margin="14,10,10,2">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource Ui.Muted}" VerticalAlignment="Center"/>
                <Border Style="{StaticResource UiCountChip}" Margin="8,0,0,0" Padding="7,0">
                    <TextBlock Text="{Binding Count}" FontSize="11" Foreground="{DynamicResource Ui.Muted}"/>
                </Border>
            </StackPanel>
        </DataTemplate>
        <DataTemplate DataType="{x:Type local:FindHitRow}">
            <TextBlock Margin="16,6,10,6" TextWrapping="Wrap" LineHeight="17" Foreground="{DynamicResource Ui.Text}">
                <Run Text="{Binding Before, Mode=OneWay}"/><Run Text="{Binding Match, Mode=OneWay}" FontWeight="Bold" Background="#80FFC400"/><Run Text="{Binding After, Mode=OneWay}"/>
            </TextBlock>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8">
            <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Surface}" Height="32">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="16" Height="16" Margin="10,0,6,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Ui.Icon.search}" Stroke="{DynamicResource Ui.Muted}" Style="{StaticResource UiLineIconPath}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBox x:Name="QueryBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" FontSize="13"
                             Foreground="{DynamicResource Ui.Text}" CaretBrush="{DynamicResource Ui.Text}" TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown"/>
                    <TextBlock Grid.Column="1" Text="Find in document…" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0,0,0" Foreground="{DynamicResource Ui.Muted}" FontSize="13">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=QueryBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <xt:XTButton Grid.Column="2" x:Name="ClearButton" Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.close}" Width="24" Height="24"
                                 Margin="0,0,4,0" Visibility="Collapsed" ToolTip="Clear" Click="Clear_Click"/>
                </Grid>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="MatchCaseBox" Style="{StaticResource OptionChip}" Content="Match case" Margin="0,0,8,0" Checked="Option_Changed" Unchecked="Option_Changed"/>
                <CheckBox x:Name="WholeWordBox" Style="{StaticResource OptionChip}" Content="Whole word" Checked="Option_Changed" Unchecked="Option_Changed"/>
            </StackPanel>
            <Border CornerRadius="7" Background="{DynamicResource Ui.Chip}" Padding="2" Margin="0,10,0,0" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="ScopeThis" Style="{StaticResource ScopeItem}" GroupName="FindScope" Content="This file" IsChecked="True" Checked="Option_Changed"/>
                    <RadioButton x:Name="ScopeAll" Style="{StaticResource ScopeItem}" GroupName="FindScope" Content="All open files" Checked="Option_Changed"/>
                </StackPanel>
            </Border>
            <TextBlock x:Name="StatusText" Margin="2,10,0,0" Foreground="{DynamicResource Ui.Muted}"/>
            <Border x:Name="NoTextNote" Visibility="Collapsed" CornerRadius="8" Background="{DynamicResource Ui.AccentSoft}" Padding="12,10" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal">
                    <Viewbox Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,10,0">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Ui.Icon.info}" Stroke="{DynamicResource Ui.Accent}" Style="{StaticResource UiLineIconPath}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="NoTextText" TextWrapping="Wrap" Width="250" LineHeight="17" Foreground="{DynamicResource Ui.Text}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <ListBox x:Name="Results" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Ui.Border}" Background="Transparent" ItemContainerStyle="{StaticResource FindRowItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Results_SelectionChanged" VirtualizingPanel.IsVirtualizing="True"/>
    </DockPanel>
</UserControl>
