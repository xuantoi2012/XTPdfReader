<UserControl x:Class="XTPdfMergeApp.Controls.CommentsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
             xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
             FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <Style x:Key="StatusItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Height="28" Padding="10,0" CornerRadius="5" Background="Transparent">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Ui.Muted}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XTPrimaryButtonBackground}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Ui.OnAccent}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CommentRowItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHeader}" Value="True">
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="Focusable" Value="False"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type local:CommentGroupHeader}">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="14,10,10,2" Foreground="{DynamicResource Ui.Muted}"/>
        </DataTemplate>
        <!-- Avatar tròn: nền màu theo tác giả + chữ cái đầu, kiểu Word. -->
        <Style x:Key="CommentAvatar" TargetType="Border">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="{Binding AvatarBrush}"/>
        </Style>

        <!-- 1 reply trong thread: avatar nhỏ hơn, không viền/box riêng, chỉ ngăn bằng 1 gạch mảnh phía trên — kiểu Word. -->
        <DataTemplate x:Key="CommentReplyTemplate" DataType="{x:Type local:CommentPerson}">
            <Border BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Ui.Border}" Padding="0,8,0,0" Margin="0,8,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="11" Background="{Binding AvatarBrush}" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Initials}" FontSize="9" FontWeight="SemiBold" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="7,0,0,0">
                        <Grid>
                            <TextBlock Text="{Binding Author}" FontWeight="SemiBold" FontSize="11.5" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Text="{Binding DateText}" FontSize="10.5" HorizontalAlignment="Right" Foreground="{DynamicResource Ui.Muted}"/>
                        </Grid>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0,2,0,0" FontSize="11.5" Foreground="{DynamicResource Ui.Text}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:CommentCard}">
            <Border x:Name="Card" Margin="8,4,8,4" Padding="12,10" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Ui.Border}"
                    Background="{DynamicResource Ui.Surface}" Cursor="Hand">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CommentAvatar}">
                            <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Author}" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{DynamicResource Ui.Muted}"/>
                        </StackPanel>
                        <Viewbox Grid.Column="2" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Top" ToolTip="{Binding Info.Kind}">
                            <Canvas Width="24" Height="24">
                                <Path Data="{Binding Icon}" Fill="{DynamicResource Ui.Muted}"/>
                            </Canvas>
                        </Viewbox>
                        <Border Grid.Column="3" x:Name="Chip" CornerRadius="9" Padding="8,1" Cursor="Hand" ToolTip="Click to change the status" VerticalAlignment="Top"
                                Background="{DynamicResource Ui.AccentSoft}" MouseLeftButtonUp="Status_MouseLeftButtonUp">
                            <TextBlock x:Name="ChipText" Text="Open" FontSize="11" Foreground="{DynamicResource Ui.Accent}"/>
                        </Border>
                        <Button Grid.Column="4" Content="…" Tag="{Binding Info}" Margin="6,0,0,0" Padding="5,0" VerticalAlignment="Top" Click="MessageMenu_Click"/>
                    </Grid>
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="36,6,0,0" LineHeight="17" Foreground="{DynamicResource Ui.Text}"/>
                    <ItemsControl Margin="0" ItemsSource="{Binding Replies}" ItemTemplate="{StaticResource CommentReplyTemplate}"/>
                    <TextBox Tag="{Binding Info}" Margin="0,8,0,0" Height="28" VerticalContentAlignment="Center" Text="Reply"
                             Foreground="{DynamicResource Ui.Muted}" GotKeyboardFocus="ReplyBox_GotKeyboardFocus" PreviewKeyDown="ReplyBox_PreviewKeyDown"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Resolved}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Ui.Chip}"/>
                    <Setter TargetName="ChipText" Property="Text" Value="Resolved"/>
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" Padding="12,10">
            <xt:XTButton Style="{StaticResource UiGhostButton}" Icon="{StaticResource Ui.Icon.export}" Text="Export summary…" HorizontalAlignment="Stretch"
                         ToolTip="Save all comments of this document as a spreadsheet (CSV)" Click="Export_Click"/>
        </Border>
        <StackPanel DockPanel.Dock="Top" Margin="12,0,12,10">
            <Border CornerRadius="7" Background="{DynamicResource Ui.Chip}" Padding="2">
                <UniformGrid Rows="1">
                    <RadioButton x:Name="StatusAll" Style="{StaticResource StatusItem}" GroupName="CommentStatus" IsChecked="True" Checked="Filter_Changed"/>
                    <RadioButton x:Name="StatusOpen" Style="{StaticResource StatusItem}" GroupName="CommentStatus" Checked="Filter_Changed"/>
                    <RadioButton x:Name="StatusResolved" Style="{StaticResource StatusItem}" GroupName="CommentStatus" Checked="Filter_Changed"/>
                </UniformGrid>
            </Border>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="TypeBox" Height="30" SelectionChanged="Filter_SelectionChanged">
                    <ComboBoxItem Content="All types" Tag="" IsSelected="True"/>
                    <ComboBoxItem Content="Typewriter" Tag="Typewriter"/>
                    <ComboBoxItem Content="Note" Tag="Comment"/>
                    <ComboBoxItem Content="Highlight" Tag="Highlight"/>
                    <ComboBoxItem Content="Underline" Tag="Underline"/>
                    <ComboBoxItem Content="Strikethrough" Tag="StrikeOut"/>
                    <ComboBoxItem Content="Stamp" Tag="Stamp"/>
                    <ComboBoxItem Content="Shape" Tag="Shape"/>
                    <ComboBoxItem Content="Other" Tag="Other"/>
                </ComboBox>
                <ComboBox x:Name="AuthorBox" Grid.Column="2" Height="30" SelectionChanged="Filter_SelectionChanged"/>
            </Grid>
        </StackPanel>
        <Grid>
            <ListBox x:Name="Cards" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Ui.Border}" Background="Transparent" ItemContainerStyle="{StaticResource CommentRowItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Cards_SelectionChanged"/>
            <TextBlock x:Name="EmptyText" Margin="14" TextWrapping="Wrap" Foreground="{DynamicResource Ui.Muted}" Visibility="Collapsed"/>
        </Grid>
    </DockPanel>
</UserControl>
