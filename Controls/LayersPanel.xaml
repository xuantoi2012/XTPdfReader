<UserControl x:Class="XTPdfMergeApp.Controls.LayersPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
             xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
             FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <!-- Ô chọn 3 trạng thái (hiện / lẫn / ẩn) vẽ theo mockup; bấm vào ô thì xử lý ở Cb_MouseLeftButtonDown. -->
        <DataTemplate DataType="{x:Type local:LayerNode}">
            <Grid x:Name="RowGrid" Height="30" Margin="{Binding Indent}" Background="Transparent"
                  ToolTip="{Binding ToolTipText}" ToolTipService.ShowOnDisabled="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="Transparent" Visibility="{Binding ArrowVisibility}"
                        MouseLeftButtonDown="Arrow_MouseLeftButtonDown" Cursor="Hand">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="Chevron" Data="{StaticResource Ui.Icon.chevr.Bold}" Fill="{DynamicResource Ui.Muted}"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <Border x:Name="Cb" Grid.Column="1" Width="16" Height="16" CornerRadius="4" BorderThickness="1.5"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand" Background="Transparent"
                        BorderBrush="{DynamicResource Ui.Muted}" MouseLeftButtonDown="Cb_MouseLeftButtonDown">
                    <Viewbox Width="12" Height="12">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="CheckMark" Data="{StaticResource Ui.Icon.check.Bold}" Fill="{DynamicResource Ui.OnAccent}"
                                  Visibility="Collapsed"/>
                            <Path x:Name="MixedMark" Data="{StaticResource Ui.Icon.min.Bold}" Fill="{DynamicResource Ui.OnAccent}"
                                  Visibility="Collapsed"/>
                        </Canvas>
                    </Viewbox>
                </Border>

                <TextBlock x:Name="TitleText" Grid.Column="2" Text="{Binding Title}" FontWeight="{Binding TitleWeight}" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ui.Text}" Margin="2,0,6,0"/>

                <Border Grid.Column="3" Style="{StaticResource UiCountChip}" Visibility="{Binding ChipVisibility}" Padding="7,1">
                    <TextBlock Text="{Binding ChipText}" FontSize="10.5" Foreground="{DynamicResource Ui.Muted}"/>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                    <Setter TargetName="Chevron" Property="Data" Value="{StaticResource Ui.Icon.chevd}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="True">
                    <Setter TargetName="Cb" Property="Background" Value="{DynamicResource Ui.Accent}"/>
                    <Setter TargetName="Cb" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="{x:Null}">
                    <Setter TargetName="Cb" Property="Background" Value="{DynamicResource Ui.Accent}"/>
                    <Setter TargetName="Cb" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                    <Setter TargetName="MixedMark" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDimmed}" Value="True">
                    <Setter TargetName="TitleText" Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding CanToggle}" Value="False">
                    <Setter TargetName="Cb" Property="Opacity" Value="0.45"/>
                    <Setter TargetName="Cb" Property="Cursor" Value="Arrow"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Nút chọn View: viền mảnh, tên bên trái, mũi tên bên phải. -->
        <Style x:Key="ViewPickerButton" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}"
                                Background="{DynamicResource Ui.Surface}" Padding="10,0,8,0">
                            <DockPanel>
                                <Viewbox DockPanel.Dock="Right" Width="14" Height="14" Margin="6,0,0,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource Ui.Icon.chevd.Bold}" Fill="{DynamicResource Ui.Muted}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{TemplateBinding Content}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Ui.Text}"/>
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <DockPanel x:Name="ContentRoot">
            <!-- View đã lưu -->
            <StackPanel DockPanel.Dock="Top" Margin="12,0,12,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="View" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Muted}" Margin="0,0,10,0"/>
                    <Button x:Name="ViewButton" Grid.Column="1" Style="{StaticResource ViewPickerButton}" Click="ViewButton_Click"
                            ToolTip="Choose a saved layer view"/>
                    <xt:XTButton Grid.Column="2" Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.save}" Margin="6,0,0,0"
                                 Width="30" Height="30" ToolTip="Save the current layers as a view" Click="SaveView_Click"/>
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <xt:XTButton x:Name="IsolateButton" Style="{StaticResource UiGhostButton}" Icon="{StaticResource Ui.Icon.eye}"
                                 Text="Isolate selected" ToolTip="Show only the selected layer (and its sub-layers)" Click="Isolate_Click"/>
                    <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Reset" Margin="8,0,0,0"
                                 ToolTip="Back to the layer visibility saved in each file" Click="Reset_Click"/>
                    <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Manage…" Margin="8,0,0,0"
                                 ToolTip="Rename and merge the layers of this file" Click="Manage_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- Tìm + mở/thu -->
            <Grid DockPanel.Dock="Top" Margin="12,0,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Surface}" Height="30">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Viewbox Width="15" Height="15" Margin="9,0,4,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Ui.Icon.search}" Fill="{DynamicResource Ui.Muted}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 Foreground="{DynamicResource Ui.Text}" CaretBrush="{DynamicResource Ui.Text}" TextChanged="SearchBox_TextChanged"/>
                        <TextBlock Grid.Column="1" Text="Search layers…" IsHitTestVisible="False" VerticalAlignment="Center" Margin="5,0,0,0"
                                   Foreground="{DynamicResource Ui.Muted}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <xt:XTButton Grid.Column="2" x:Name="ClearSearchButton" Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.close}"
                                     Width="24" Height="24" Margin="0,0,3,0" Visibility="Collapsed" ToolTip="Clear" Click="ClearSearch_Click"/>
                    </Grid>
                </Border>
                <xt:XTButton Grid.Column="1" x:Name="ExpandButton" Style="{StaticResource UiGhostButton}" Icon="{StaticResource Ui.Icon.chevd}"
                             Width="34" Padding="0" Margin="8,0,0,0" ToolTip="Expand / collapse all" Click="Expand_Click"/>
            </Grid>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,0,12,8">
                <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Show all" Click="ShowAll_Click"/>
                <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Hide all" Margin="8,0,0,0" Click="HideAll_Click"/>
            </StackPanel>

            <!-- Chân: xuất PDF theo View + ghi chú -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" Padding="12,10">
                <StackPanel>
                    <xt:XTButton Style="{StaticResource UiPrimaryButton}" HorizontalAlignment="Stretch" Icon="{StaticResource Ui.Icon.export}"
                                 Text="Export PDF with this view…" Click="Export_Click"
                                 ToolTip="Save a copy of this document's pages with the current layer view as its default"/>
                    <TextBlock TextWrapping="Wrap" FontSize="11.5" Margin="2,10,2,0" Foreground="{DynamicResource Ui.Muted}"
                               Text="Layers with the same name from several files are merged into one. “N files” shows how many source files contain the layer."/>
                </StackPanel>
            </Border>

            <ListBox x:Name="Rows" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Ui.Border}" Background="Transparent"
                     SelectionMode="Single" ItemContainerStyle="{StaticResource UiRowItem}" Padding="0,2"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling" SelectionChanged="Rows_SelectionChanged"/>
        </DockPanel>

        <TextBlock x:Name="EmptyText" Visibility="Collapsed" Margin="14" TextWrapping="Wrap" Foreground="{DynamicResource Ui.Muted}"/>
    </Grid>
</UserControl>
