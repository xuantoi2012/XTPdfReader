<UserControl x:Class="XTPdfMergeApp.Controls.StampPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <Style x:Key="TabChoice" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Height="26" Padding="14,0" CornerRadius="5" Background="Transparent">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Muted}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XTPrimaryButtonBackground}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Ui.OnAccent}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Width="400" Margin="8" Padding="14" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Surface}">
        <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.25" Direction="270"/></Border.Effect>
        <StackPanel>
            <DockPanel Margin="0,0,0,12">
                <Border DockPanel.Dock="Right" CornerRadius="7" Background="{DynamicResource Ui.Chip}" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="StandardTab" Style="{StaticResource TabChoice}" GroupName="StampTab" Content="Standard" IsChecked="True" Checked="Tab_Checked"/>
                        <RadioButton x:Name="MineTab" Style="{StaticResource TabChoice}" GroupName="StampTab" Content="Mine" Checked="Tab_Checked"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Stamps" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
            </DockPanel>
            <UniformGrid x:Name="Grid" Columns="3" MinHeight="70"/>
            <TextBlock x:Name="EmptyMine" Visibility="Collapsed" TextWrapping="Wrap" Foreground="{DynamicResource Ui.Muted}" FontSize="12"
                       Text="Create your own stamp with New stamp…, or import a signature / seal image. Right-click a stamp to remove it."/>
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <xt:XTButton Style="{StaticResource UiGhostButton}" Icon="{StaticResource Ui.Icon.plus}" Text="New stamp…" Click="NewStamp_Click"/>
                <xt:XTButton Grid.Column="2" Style="{StaticResource UiGhostButton}" Icon="{StaticResource Ui.Icon.folder}" Text="Import image…" Click="ImportImage_Click"/>
            </Grid>
            <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,10,0,0">
                <StackPanel>
                    <CheckBox x:Name="SignatureBox" Content="Add my name and today’s date" IsChecked="True"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="60"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Opacity" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                        <Slider x:Name="OpacitySlider" Grid.Column="1" Minimum="20" Maximum="100" Value="85" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="5"/>
                        <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                    </Grid>
                    <TextBlock Text="Click on the page to place · hold Shift to repeat · right-click a placed stamp to delete it" TextWrapping="Wrap" FontSize="12"
                               Margin="0,10,0,0" LineHeight="18" Foreground="{DynamicResource Ui.Muted}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
