<xt:XTWindow x:Class="XTPdfMergeApp.Controls.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
        Title="Print" Width="960" Height="640" MinWidth="900" MinHeight="600"
        TitleBarMode="Dialog" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <xt:XTWindow.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8,12,10"/>
            <Setter Property="Background" Value="{DynamicResource Ui.Surface}"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        </Style>
    </xt:XTWindow.Resources>

    <Grid Background="{DynamicResource Ui.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Máy in: tên, Properties (hộp thoại của chính driver), số bản, collate, thang xám -->
        <Border Grid.Row="0" Style="{StaticResource Card}" Margin="12,12,12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox x:Name="PrinterBox" Grid.Column="1" Height="30" SelectionChanged="Printer_Changed"/>
                <xt:XTButton x:Name="PropertiesButton" Grid.Column="2" Style="{StaticResource UiGhostButton}" Text="Properties…" Height="30" Margin="10,0,0,0" Padding="16,0"
                             ToolTip="Open the printer driver's own settings (paper tray, quality, duplex, plotter options…)" Click="Properties_Click"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Center">
                    <CheckBox x:Name="GrayBox" Content="Print as grayscale" Margin="0,0,18,0" Checked="ColorBox_Changed" Unchecked="ColorBox_Changed"/>
                    <CheckBox x:Name="LinesBox" Content="Black lines only" Checked="ColorBox_Changed" Unchecked="ColorBox_Changed"
                              ToolTip="Everything darker than light gray prints black — crisp CAD lines, no gray fill"/>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,8,0,0">
                    <TextBlock Text="Copies:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="CopiesBox" Width="70" Height="28" Text="1" VerticalContentAlignment="Center"/>
                    <CheckBox x:Name="CollateBox" Content="Collate" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PrinterStatus" Style="{StaticResource Small}" Margin="24,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="260"/>
            </Grid.ColumnDefinitions>

            <!-- Xem trước -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource CardTitle}"/>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <DockPanel><TextBlock Text="Zoom:" Style="{StaticResource Small}" Width="76"/><TextBlock x:Name="ZoomText"/></DockPanel>
                        <DockPanel><TextBlock Text="Document:" Style="{StaticResource Small}" Width="76"/><TextBlock x:Name="DocText"/></DockPanel>
                        <DockPanel><TextBlock Text="Paper:" Style="{StaticResource Small}" Width="76"/><TextBlock x:Name="PaperText"/></DockPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.chevl}" Width="30" Height="28" IconSize="20" Click="PrevPreview_Click"/>
                        <TextBlock x:Name="PreviewCaption" Margin="10,0" VerticalAlignment="Center" Style="{StaticResource Small}"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.chevr}" Width="30" Height="28" IconSize="20" Click="NextPreview_Click"/>
                    </StackPanel>
                    <Border Background="{DynamicResource Ui.View}" CornerRadius="4">
                        <Grid x:Name="PreviewHost" SizeChanged="PreviewHost_SizeChanged">
                            <Border x:Name="Paper" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Direction="270"/></Border.Effect>
                                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <!-- Phạm vi + cách in -->
            <StackPanel Grid.Column="2">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Print Range" Style="{StaticResource CardTitle}"/>
                        <RadioButton x:Name="PagesCurrent" GroupName="PrintPages" Margin="0,0,0,6" Checked="Setting_Changed"/>
                        <RadioButton x:Name="PagesAll" GroupName="PrintPages" Margin="0,0,0,6" Checked="Setting_Changed"/>
                        <DockPanel Margin="0,0,0,2">
                            <RadioButton x:Name="PagesRange" GroupName="PrintPages" Content="Pages:" Checked="Setting_Changed" VerticalAlignment="Center"/>
                            <TextBlock x:Name="RangeTotal" DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            <TextBox x:Name="RangeBox" Height="28" Margin="10,0,0,0" VerticalContentAlignment="Center" IsEnabled="False" TextChanged="Range_TextChanged"/>
                        </DockPanel>
                        <TextBlock Text="Example: 1-12, 40, 55-60" Style="{StaticResource Small}" Margin="24,0,0,8"/>
                        <DockPanel>
                            <TextBlock Text="Subset:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox x:Name="SubsetBox" Height="28" SelectedIndex="0" SelectionChanged="Subset_Changed">
                                <ComboBoxItem Content="All pages in range"/>
                                <ComboBoxItem Content="Odd pages only"/>
                                <ComboBoxItem Content="Even pages only"/>
                            </ComboBox>
                        </DockPanel>
                        <CheckBox x:Name="ReverseBox" Content="Reverse pages" Margin="0,8,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <TextBlock Text="Print Handling" Style="{StaticResource CardTitle}"/>
                        <RadioButton x:Name="ScaleActual" GroupName="PrintScale" Content="None (actual size)" Margin="0,0,0,6" Checked="Setting_Changed"/>
                        <RadioButton x:Name="ScaleFit" GroupName="PrintScale" Content="Fit to paper" IsChecked="True" Margin="0,0,0,6" Checked="Setting_Changed"/>
                        <RadioButton x:Name="ScaleReduce" GroupName="PrintScale" Content="Reduce to paper (only larger pages)" Margin="0,0,0,6" Checked="Setting_Changed"/>
                        <DockPanel>
                            <RadioButton x:Name="ScaleCustom" GroupName="PrintScale" Content="Custom scale" VerticalAlignment="Center" Checked="Setting_Changed"/>
                            <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
                            <TextBox x:Name="PercentBox" Width="70" Height="28" Margin="12,0,0,0" HorizontalAlignment="Left" Text="100" VerticalContentAlignment="Center" IsEnabled="False" TextChanged="Percent_TextChanged"/>
                        </DockPanel>
                        <TextBlock x:Name="LayerNote" Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource Small}"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Giấy / hướng -->
            <StackPanel Grid.Column="4">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Paper" Style="{StaticResource CardTitle}"/>
                        <ComboBox x:Name="PaperBox" Height="28" SelectionChanged="Paper_Changed"/>
                        <TextBlock Text="Orientation" Style="{StaticResource CardTitle}" Margin="0,10,0,6"/>
                        <ComboBox x:Name="OrientBox" Height="28" SelectedIndex="0" SelectionChanged="Subset_Changed">
                            <ComboBoxItem Content="Auto (per page)"/>
                            <ComboBoxItem Content="Portrait"/>
                            <ComboBoxItem Content="Landscape"/>
                        </ComboBox>
                        <CheckBox x:Name="AutoCenterBox" Content="Auto-center" IsChecked="True" Margin="0,12,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Margin="0,10,0,0" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <xt:XTButton x:Name="PrintButton" Style="{StaticResource UiPrimaryButton}" Text="Print" Width="100" Height="34" Margin="0,0,8,0" IsDefault="True" Click="Print_Click"/>
                    <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Cancel" Width="100" Height="34" IsCancel="True" Click="Cancel_Click"/>
                </StackPanel>
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Style="{StaticResource Small}"/>
            </DockPanel>
        </Border>
    </Grid>
</xt:XTWindow>
