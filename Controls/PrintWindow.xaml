<xt:XTWindow x:Class="XTPdfMergeApp.Controls.PrintWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
        Title="Print" Width="1150" Height="700" MinWidth="900" MinHeight="580"
        TitleBarMode="Tool" TitleIcon="{StaticResource Ui.Icon.print}" TitleIconBrush="{DynamicResource Ui.Brand}" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" ShowInTaskbar="False">
    <xt:XTWindow.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,8,12,10"/>
            <Setter Property="Background" Value="{DynamicResource Ui.Surface}"/>
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        </Style>
        <Style x:Key="ColumnSplitter" TargetType="GridSplitter">
            <Setter Property="Width" Value="8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
            <Setter Property="Cursor" Value="SizeWE"/>
        </Style>
    </xt:XTWindow.Resources>

    <Grid Background="{DynamicResource Ui.Panel}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The printer of each kind of sheet is chosen in the third column. This box only holds the printer that new cards start with and that the Copies / Collate boxes read. -->
        <ComboBox x:Name="PrinterBox" Visibility="Collapsed" Width="0" Height="0" SelectionChanged="Printer_Changed"/>
        <CheckBox x:Name="GrayBox" Visibility="Collapsed"/>
        <CheckBox x:Name="LinesBox" Visibility="Collapsed"/>

        <Grid Grid.Row="0" Margin="12,12,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.19*" MinWidth="240"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="0.86*" MinWidth="260"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <!-- Column 1: preview -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Preview" Style="{StaticResource CardTitle}"/>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <DockPanel><TextBlock Text="Zoom:" Style="{StaticResource Small}" Width="76"/><TextBlock x:Name="ZoomText"/></DockPanel>
                        <DockPanel><TextBlock Text="Document:" Style="{StaticResource Small}" Width="76"/><TextBlock x:Name="DocText"/></DockPanel>
                        <DockPanel><TextBlock Text="Paper:" Style="{StaticResource Small}" Width="76"/><TextBlock x:Name="PaperText"/></DockPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.chevl}" Width="30" Height="28" IconSize="20" Click="PrevPreview_Click"/>
                        <TextBlock x:Name="PreviewCaption" Margin="10,0" VerticalAlignment="Center" Style="{StaticResource Small}"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.chevr}" Width="30" Height="28" IconSize="20" Click="NextPreview_Click"/>
                    </StackPanel>
                    <Border Background="{DynamicResource Ui.View}" CornerRadius="4">
                        <Grid x:Name="PreviewHost" SizeChanged="PreviewHost_SizeChanged">
                            <Border x:Name="Paper" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" SnapsToDevicePixels="True">
                                <Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Direction="270"/></Border.Effect>
                                <Image x:Name="PreviewImage" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Style="{StaticResource ColumnSplitter}"/>

            <!-- Column 2: print range (with the pages by paper size under Pages) and print handling -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Print Range" Style="{StaticResource CardTitle}"/>
                            <RadioButton x:Name="PagesCurrent" GroupName="PrintPages" Margin="0,0,0,6" Checked="Setting_Changed"/>
                            <RadioButton x:Name="PagesAll" GroupName="PrintPages" Margin="0,0,0,6" Checked="Setting_Changed"/>
                            <DockPanel Margin="0,0,0,2">
                                <RadioButton x:Name="PagesRange" GroupName="PrintPages" Content="Pages:" Checked="Setting_Changed" VerticalAlignment="Center"/>
                                <TextBlock x:Name="RangeTotal" DockPanel.Dock="Right" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <TextBox x:Name="RangeBox" Height="28" Margin="10,0,0,0" VerticalContentAlignment="Center" IsEnabled="False" TextChanged="Range_TextChanged"/>
                            </DockPanel>
                            <TextBlock Text="Example: 1-12, 40, 55-60" Style="{StaticResource Small}" Margin="24,0,0,8"/>
                            <RadioButton x:Name="PagesBySize" GroupName="PrintPages" Content="Pages by paper size" Margin="0,0,0,2" Checked="Setting_Changed" IsEnabled="False"/>
                            <StackPanel x:Name="SizeChecks" Margin="24,2,0,6" Visibility="Collapsed"/>
                            <TextBlock x:Name="SizesNote" TextWrapping="Wrap" Text="Reading page sizes…" Style="{StaticResource Small}" Margin="24,0,0,8"/>
                            <TextBlock Text="Color pages" Style="{StaticResource CardTitle}" Margin="0,12,0,4" ToolTip="Pages that carry color pictures are picked for you. Add or remove pages by typing; they are printed in color on the printer chosen for them."/>
                            <DockPanel>
                                <xt:XTButton DockPanel.Dock="Right" Style="{StaticResource UiGhostButton}" Text="Reset" Height="28" Margin="8,0,0,0" ToolTip="Back to the pages with color pictures" Click="ColorReset_Click"/>
                                <TextBox x:Name="ColorPagesBox" Height="28" VerticalContentAlignment="Center" TextChanged="ColorPages_TextChanged" ToolTip="For example 5, 12, 40-42"/>
                            </DockPanel>
                            <TextBlock x:Name="ColorStat" Style="{StaticResource Small}" Margin="0,4,0,0"/>
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock Text="Subset:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox x:Name="SubsetBox" Height="28" SelectedIndex="0" SelectionChanged="Subset_Changed">
                                    <ComboBoxItem Content="All pages in range"/>
                                    <ComboBoxItem Content="Odd pages only"/>
                                    <ComboBoxItem Content="Even pages only"/>
                                </ComboBox>
                            </DockPanel>
                            <CheckBox x:Name="ReverseBox" Content="Reverse pages" Margin="0,8,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Print Handling" Style="{StaticResource CardTitle}"/>
                            <RadioButton x:Name="ScaleActual" GroupName="PrintScale" Content="None (actual size)" Margin="0,0,0,6" Checked="Setting_Changed"/>
                            <RadioButton x:Name="ScaleFit" GroupName="PrintScale" Content="Fit to paper" IsChecked="True" Margin="0,0,0,6" Checked="Setting_Changed"/>
                            <RadioButton x:Name="ScaleReduce" GroupName="PrintScale" Content="Reduce to paper (only larger pages)" Margin="0,0,0,6" Checked="Setting_Changed"/>
                            <DockPanel>
                                <RadioButton x:Name="ScaleCustom" GroupName="PrintScale" Content="Custom scale" VerticalAlignment="Center" Checked="Setting_Changed"/>
                                <TextBlock DockPanel.Dock="Right" Text="%" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBox x:Name="PercentBox" Width="70" Height="28" Margin="12,0,0,0" HorizontalAlignment="Left" Text="100" VerticalContentAlignment="Center" IsEnabled="False" TextChanged="Percent_TextChanged"/>
                            </DockPanel>
                            <TextBlock Text="Orientation" Style="{StaticResource CardTitle}" Margin="0,12,0,4"/>
                            <ComboBox x:Name="OrientBox" Height="28" SelectedIndex="0" SelectionChanged="Subset_Changed">
                                <ComboBoxItem Content="Auto (per page)"/>
                                <ComboBoxItem Content="Portrait"/>
                                <ComboBoxItem Content="Landscape"/>
                            </ComboBox>
                            <CheckBox x:Name="AutoCenterBox" Content="Auto-center" IsChecked="True" Margin="0,10,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                            <CheckBox x:Name="HighQualityBox" Content="High quality CAD (600 DPI)" Margin="0,10,0,0" Checked="Setting_Changed" Unchecked="Setting_Changed"
                                      ToolTip="Renders in memory-bounded bands for sharp CAD lines. Large sheets can take longer to spool."/>
                            <TextBlock x:Name="LayerNote" Margin="0,10,0,0" TextWrapping="Wrap" Style="{StaticResource Small}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <GridSplitter Grid.Column="3" Style="{StaticResource ColumnSplitter}"/>

            <!-- Column 3: how to print (gray, lines, copies), which pages are color, and the printer and paper of each kind of sheet -->
            <ScrollViewer Grid.Column="4" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Printer and paper for each kind of sheet" Style="{StaticResource CardTitle}"/>
                            <Border x:Name="BySizeHost"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Margin="0,10,0,0" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" Padding="16,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <xt:XTButton x:Name="PrintButton" Style="{StaticResource UiPrimaryButton}" Icon="{StaticResource Ui.Icon.print}" Text="Print" MinWidth="110" Height="34" Margin="0,0,8,0" IsDefault="True" Click="Print_Click"/>
                    <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Cancel" Width="100" Height="34" IsCancel="True" Click="Cancel_Click"/>
                </StackPanel>
                <Border x:Name="ProfileHost" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Margin="16,0,16,0" TextTrimming="CharacterEllipsis" Style="{StaticResource Small}"/>
            </DockPanel>
        </Border>
    </Grid>
</xt:XTWindow>
