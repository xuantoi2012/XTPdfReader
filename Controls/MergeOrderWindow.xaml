<xt:XTWindow x:Class="XTPdfMergeApp.Controls.MergeOrderWindow"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
              xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
              Title="Choose merge order" Width="560" Height="620" MinWidth="460" MinHeight="420"
              TitleBarMode="Dialog" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13" ShowInTaskbar="False">
    <Grid Background="{DynamicResource Ui.Surface}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="20,18,20,12">
            <TextBlock Text="Choose the order of windows to merge" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Ui.Text}"/>
            <TextBlock Text="Drag a row to place that window before another. Temp groups are not listed." Margin="0,5,0,0" Foreground="{DynamicResource Ui.Muted}"/>
        </StackPanel>
        <ListBox x:Name="OrderList" Grid.Row="1" Margin="20,0" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" Padding="6" Background="{DynamicResource Ui.Panel}"
                 AllowDrop="True" PreviewMouseLeftButtonDown="OrderList_PreviewMouseLeftButtonDown" PreviewMouseMove="OrderList_PreviewMouseMove"
                 DragOver="OrderList_DragOver" Drop="OrderList_Drop">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8" Margin="0,0,0,5" CornerRadius="6" Background="{DynamicResource Ui.Surface}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Order}" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Ui.Accent}"/>
                            <Border Grid.Column="1" Width="46" Height="58" Background="White" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1">
                                <local:PageThumbnailImage Source="{Binding FirstPage.Thumbnail}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="2" Margin="10,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}"/>
                                <TextBlock Text="{Binding PageCountText}" Margin="0,3,0,0" FontSize="11.5" Foreground="{DynamicResource Ui.Muted}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="Drag" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource Ui.Muted}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Margin="0,14,0,0" Padding="20,12" Background="{DynamicResource Ui.Panel}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Cancel" Width="90" Height="34" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <xt:XTButton Style="{StaticResource UiPrimaryButton}" Text="Continue" Width="100" Height="34" IsDefault="True" Click="Continue_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</xt:XTWindow>
