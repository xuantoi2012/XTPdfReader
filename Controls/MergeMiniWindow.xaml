<UserControl x:Class="XTPdfMergeApp.Controls.MergeMiniWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
             FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <Style x:Key="GoToBox" TargetType="TextBox">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="5" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Surface}">
                            <Grid>
                                <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="Hint" Text="Go to…" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{DynamicResource Ui.Muted}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Text" Value="">
                                <Setter TargetName="Hint" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="MiniThumbItem" TargetType="ListBoxItem" BasedOn="{StaticResource UiThumbItem}"/>
    </UserControl.Resources>

    <Border x:Name="Frame" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Surface}"
            SnapsToDevicePixels="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="34"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header: kéo = di chuyển cửa sổ; nhấp đúp = phóng to/trả lại; biểu tượng file bên trái = kéo CẢ FILE sang cửa sổ khác. -->
            <Border x:Name="Header" Background="{DynamicResource Ui.Panel}" CornerRadius="7,7,0,0" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" MouseMove="Header_MouseMove" MouseLeftButtonUp="Header_MouseLeftButtonUp">
                <DockPanel Margin="4,0,4,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="GoToBox" Style="{StaticResource GoToBox}" Width="84" Margin="0,0,8,0" ToolTip="Type a page number and press Enter"
                                 PreviewKeyDown="GoTo_PreviewKeyDown" MouseDown="GoTo_Focus"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.save}" Width="24" Height="24" IconSize="14"
                                     ToolTip="Export this draft window as a new PDF" Click="Save_Click"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.down2}" Width="24" Height="24" IconSize="14"
                                     ToolTip="Move this window to the temporary shelf (excluded from Merge all)" Click="Minimize_Click"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.max}" Width="24" Height="24" IconSize="14"
                                     ToolTip="Maximize / restore (double-click the title)" Click="Maximize_Click"/>
                        <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.close}" Width="24" Height="24" IconSize="14"
                                     ToolTip="Remove this window from the merge draft" Click="Close_Click"/>
                    </StackPanel>
                    <Border x:Name="FileHandle" DockPanel.Dock="Left" Width="26" Height="26" Background="Transparent" Cursor="SizeAll" VerticalAlignment="Center"
                            ToolTip="Drag onto another window to insert all pages of this file (Ctrl = copy)"
                            MouseLeftButtonDown="FileHandle_MouseLeftButtonDown" MouseMove="FileHandle_MouseMove" MouseLeftButtonUp="FileHandle_MouseLeftButtonUp">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Ui.Icon.grip}" Fill="{DynamicResource Ui.Muted}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Ui.Text}" ToolTip="{Binding SourcePath}"/>
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Ui.Warn}" Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Unsaved changes"
                             Visibility="{Binding IsDirty, Converter={StaticResource BoolToVis}}"/>
                    <Border Style="{StaticResource UiCountChip}" Margin="8,0,8,0" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <TextBlock x:Name="CountText" FontSize="11" Foreground="{DynamicResource Ui.Muted}"/>
                    </Border>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1">
                <ListBox x:Name="Thumbs" BorderThickness="0" Background="Transparent" Padding="6,6,6,0" SelectionMode="Extended"
                         ItemContainerStyle="{StaticResource MiniThumbItem}" AllowDrop="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         PreviewMouseLeftButtonDown="Thumb_PreviewMouseLeftButtonDown" PreviewMouseMove="Thumb_PreviewMouseMove"
                         PreviewMouseLeftButtonUp="Thumb_PreviewMouseLeftButtonUp" PreviewKeyDown="Thumbs_PreviewKeyDown"
                         DragOver="Thumb_DragOver" DragLeave="Thumb_DragLeave" Drop="Thumb_Drop">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="Uniform" StretchItems="False"
                                                       IsGridLayoutEnabled="True" ItemSize="{Binding CellSize, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4,0,2" Width="{Binding ThumbWidth, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <Border Background="White" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" CornerRadius="2"
                                        Width="{Binding ThumbWidth, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        Height="{Binding ThumbHeight, RelativeSource={RelativeSource AncestorType=UserControl}}" HorizontalAlignment="Center">
                                    <local:PageThumbnailImage Source="{Binding Thumbnail}" Stretch="Uniform"
                                           Loaded="ThumbImage_Loaded" Unloaded="ThumbImage_Unloaded" DataContextChanged="ThumbImage_DataContextChanged"/>
                                </Border>
                                <TextBlock Text="{Binding Index}" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,0" Foreground="{DynamicResource Ui.Muted}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border x:Name="DropLine" Width="3" CornerRadius="2" Background="{DynamicResource Ui.Accent}" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"/>
                <!-- Viền báo "thả vào đây" khi kéo trang qua cửa sổ. -->
                <Border x:Name="DropGlow" BorderBrush="{DynamicResource Ui.Accent}" BorderThickness="2" CornerRadius="0,0,7,7" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>

            <!-- Đổi cỡ (chỉ ở layout Free): cạnh phải, cạnh dưới, góc. -->
            <Thumb x:Name="ResizeRight" Grid.RowSpan="2" Width="6" HorizontalAlignment="Right" Cursor="SizeWE" Opacity="0" DragDelta="Resize_DragDelta" Tag="R" Margin="0,8,-2,10"/>
            <Thumb x:Name="ResizeBottom" Grid.RowSpan="2" Height="6" VerticalAlignment="Bottom" Cursor="SizeNS" Opacity="0" DragDelta="Resize_DragDelta" Tag="B" Margin="10,0,10,-2"/>
            <Thumb x:Name="ResizeCorner" Grid.RowSpan="2" Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" Opacity="0"
                   DragDelta="Resize_DragDelta" Tag="RB"/>
        </Grid>
    </Border>
</UserControl>
