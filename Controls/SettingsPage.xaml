<UserControl x:Class="XTPdfMergeApp.Controls.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <!-- Nút phân đoạn (Light | Dark | System): nền chip, mục chọn nền accent chữ trắng. -->
        <Style x:Key="SegItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Height="30" Padding="14,0" CornerRadius="5" Background="Transparent" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Muted}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XTPrimaryButtonBackground}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Ui.OnAccent}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Language buttons: a drawn flag and the name of the language; the chosen one has the accent border. -->
        <Style x:Key="FlagItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Padding="10,6" CornerRadius="7" BorderThickness="1.5" BorderBrush="{DynamicResource Ui.Border}" Background="Transparent" SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.AccentSoft}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ô màu nhấn: chấm tròn, đang chọn có vòng ngoài. Màu = Background của RadioButton. -->
        <Style x:Key="SwatchItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Width="34" Height="34" Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
                            <Ellipse x:Name="Dot" Width="24" Height="24" Fill="{TemplateBinding Background}" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform><ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                            </Ellipse>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ui.Border}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Ui.Text}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,16,0,0"/>
            <Setter Property="Padding" Value="0,0,0,5"/>
            <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
        </Style>
        <Style x:Key="RowHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Ui.Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- One page, top to bottom: every section has its own header. -->
        <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,6,28,12">
                <StackPanel x:Name="PageAppearance">
                <!-- Appearance -->
                <TextBlock x:Name="SecAppearance" Text="Appearance" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Language" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Style="{StaticResource RowHint}" Text="Choose the language of the whole interface."/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                            <RadioButton x:Name="LangVi" Style="{StaticResource FlagItem}" GroupName="Lang" Tag="vi" Checked="Language_Checked" AutomationProperties.Name="Tiếng Việt">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="20" CornerRadius="2" ClipToBounds="True" BorderBrush="#33000000" BorderThickness="0.5" Margin="0,0,9,0">
                                        <Canvas Width="30" Height="20" Background="#DA251D">
                                            <Polygon Fill="#FFFF00" Points="15.00,4.30 16.41,8.66 20.99,8.65 17.28,11.34 18.70,15.70 15.00,13.00 11.30,15.70 12.72,11.34 9.01,8.65 13.59,8.66"/>
                                        </Canvas>
                                    </Border>
                                    <TextBlock Text="Tiếng Việt" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="LangEn" Style="{StaticResource FlagItem}" GroupName="Lang" Tag="en" Checked="Language_Checked" AutomationProperties.Name="English (US)">
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="30" Height="20" CornerRadius="2" ClipToBounds="True" BorderBrush="#33000000" BorderThickness="0.5" Margin="0,0,9,0">
                                        <Canvas Width="30" Height="20" Background="White">
                                            <Rectangle Canvas.Top="0.000" Width="30" Height="1.538" Fill="#B22234"/><Rectangle Canvas.Top="3.076" Width="30" Height="1.538" Fill="#B22234"/><Rectangle Canvas.Top="6.152" Width="30" Height="1.538" Fill="#B22234"/><Rectangle Canvas.Top="9.228" Width="30" Height="1.538" Fill="#B22234"/><Rectangle Canvas.Top="12.304" Width="30" Height="1.538" Fill="#B22234"/><Rectangle Canvas.Top="15.380" Width="30" Height="1.538" Fill="#B22234"/><Rectangle Canvas.Top="18.456" Width="30" Height="1.538" Fill="#B22234"/>
                                            <Rectangle Width="12" Height="10.77" Fill="#3C3B6E"/>
                                            <Canvas Width="12" Height="10.77"><Ellipse Canvas.Left="0.70" Canvas.Top="0.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="2.80" Canvas.Top="0.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="4.90" Canvas.Top="0.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="7.00" Canvas.Top="0.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="9.10" Canvas.Top="0.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="1.75" Canvas.Top="2.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="3.85" Canvas.Top="2.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="5.95" Canvas.Top="2.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="8.05" Canvas.Top="2.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="0.70" Canvas.Top="4.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="2.80" Canvas.Top="4.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="4.90" Canvas.Top="4.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="7.00" Canvas.Top="4.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="9.10" Canvas.Top="4.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="1.75" Canvas.Top="6.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="3.85" Canvas.Top="6.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="5.95" Canvas.Top="6.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="8.05" Canvas.Top="6.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="0.70" Canvas.Top="8.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="2.80" Canvas.Top="8.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="4.90" Canvas.Top="8.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="7.00" Canvas.Top="8.70" Width="1" Height="1" Fill="White"/><Ellipse Canvas.Left="9.10" Canvas.Top="8.70" Width="1" Height="1" Fill="White"/></Canvas>
                                        </Canvas>
                                    </Border>
                                    <TextBlock Text="English (US)" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Theme" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Style="{StaticResource RowHint}" Text="Light is the default. Dark is easier on the eyes for drawings with dark backgrounds. System follows Windows."/>
                        </StackPanel>
                        <Border Grid.Column="1" CornerRadius="7" Background="{DynamicResource Ui.Chip}" Padding="2" VerticalAlignment="Center" Margin="24,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeLight" Style="{StaticResource SegItem}" GroupName="Theme" Content="Light" Tag="Light" Checked="Theme_Checked"/>
                                <RadioButton x:Name="ThemeDark" Style="{StaticResource SegItem}" GroupName="Theme" Content="Dark" Tag="Dark" Checked="Theme_Checked"/>
                                <RadioButton x:Name="ThemeSystem" Style="{StaticResource SegItem}" GroupName="Theme" Content="System" Tag="System" Checked="Theme_Checked"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Accent color" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Style="{StaticResource RowHint}" Text="Used for the main button, the selected item and the drop marker."/>
                        </StackPanel>
                        <StackPanel x:Name="SwatchHost" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    </Grid>
                </Border>
                </StackPanel>

                <StackPanel x:Name="PageDisplay">
                <!-- Display -->
                <TextBlock x:Name="SecDisplay" Text="Display" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Default view mode" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Style="{StaticResource RowHint}" Text="Applies the next time the app starts."/>
                        </StackPanel>
                        <ComboBox x:Name="ViewModeBox" Grid.Column="1" Width="180" Height="30" Margin="24,0,0,0" VerticalAlignment="Center" SelectionChanged="ViewMode_Changed">
                            <ComboBoxItem Content="Continuous scroll" Tag="continuous"/>
                            <ComboBoxItem Content="Single page" Tag="single"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Zoom when opening a file" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Style="{StaticResource RowHint}" Text="Applies to files opened for the first time."/>
                        </StackPanel>
                        <ComboBox x:Name="ZoomBox" Grid.Column="1" Width="180" Height="30" Margin="24,0,0,0" VerticalAlignment="Center" SelectionChanged="Zoom_Changed">
                            <ComboBoxItem Content="Fit width" Tag="FitWidth"/>
                            <ComboBoxItem Content="Fit page" Tag="FitPage"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Line darkness" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Style="{StaticResource RowHint}" Text="Draws thin lines of drawings darker so they stay easy to read. Applies the next time the app starts."/>
                        </StackPanel>
                        <ComboBox x:Name="LineWeightBox" Grid.Column="1" Width="180" Height="30" Margin="24,0,0,0" VerticalAlignment="Center" SelectionChanged="LineWeight_Changed">
                            <ComboBoxItem Content="As in the file" Tag="0"/>
                            <ComboBoxItem Content="Darker (default)" Tag="1"/>
                            <ComboBoxItem Content="Darkest" Tag="2"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Color pages when printing" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Style="{StaticResource RowHint}" Text="A page counts as a color page when at least this part of it is colored (a color picture, colored text or a colored table), so a small color logo in the title block does not make every sheet a color sheet."/>
                        </StackPanel>
                        <ComboBox x:Name="ColorPercentBox" Grid.Column="1" Width="180" Height="30" Margin="24,0,0,0" VerticalAlignment="Center" SelectionChanged="ColorPercent_Changed">
                            <ComboBoxItem Content="0.2% of the page" Tag="2"/>
                            <ComboBoxItem Content="0.5% of the page" Tag="5"/>
                            <ComboBoxItem Content="1% of the page (default)" Tag="10"/>
                            <ComboBoxItem Content="2% of the page" Tag="20"/>
                            <ComboBoxItem Content="5% of the page" Tag="50"/>
                        </ComboBox>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Tool when opening a file" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Style="{StaticResource RowHint}" Text="Hand scrolls the page by dragging it; Select lets you drag across text right away, no need to switch tools first."/>
                        </StackPanel>
                        <ComboBox x:Name="DefaultToolBox" Grid.Column="1" Width="180" Height="30" Margin="24,0,0,0" VerticalAlignment="Center" SelectionChanged="DefaultTool_Changed">
                            <ComboBoxItem Content="Hand" Tag="Hand"/>
                            <ComboBoxItem Content="Select" Tag="Select"/>
                        </ComboBox>
                    </Grid>
                </Border>
                </StackPanel>

                <StackPanel x:Name="PagePerformance">
                <!-- Performance & memory -->
                <TextBlock x:Name="SecPerformance" Text="Performance &amp; memory" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <StackPanel>
                        <TextBlock Text="Reader performance" Foreground="{DynamicResource Ui.Text}"/>
                        <ComboBox x:Name="PerformanceModeBox" Width="260" Height="32" HorizontalAlignment="Left" Margin="0,10,0,0" SelectionChanged="PerformanceMode_Changed">
                            <ComboBoxItem Content="Memory saving" Tag="MemorySaving"/>
                            <ComboBoxItem Content="Balance (default)" Tag="Balance"/>
                            <ComboBoxItem Content="Maximum performance" Tag="Maximum"/>
                        </ComboBox>
                        <TextBlock x:Name="PerformanceModeHint" Style="{StaticResource RowHint}"/>
                    </StackPanel>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Files kept warm" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock Style="{StaticResource RowHint}" Text="Recently used files keep their memory for fast scrolling and zoom. Older files are released; reopening stays fast thanks to the disk cache."/>
                        </StackPanel>
                        <ComboBox x:Name="WarmBox" Grid.Column="1" Width="110" Height="30" Margin="24,0,0,0" VerticalAlignment="Center" SelectionChanged="Warm_Changed"/>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="File cache on disk" Foreground="{DynamicResource Ui.Text}"/>
                            <TextBlock x:Name="CacheHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <xt:XTButton x:Name="ClearCacheButton" Grid.Column="1" Style="{StaticResource UiGhostButton}" Text="Clear cache" Margin="24,0,0,0"
                                     VerticalAlignment="Center" Click="ClearCache_Click"
                                     ToolTip="Release the cached copies of files that are not on screen. They are read again when needed."/>
                    </Grid>
                </Border>
                </StackPanel>

                <StackPanel x:Name="PageIntegration">
                <!-- Integration -->
                <TextBlock x:Name="SecIntegration" Text="Integration" Style="{StaticResource SectionTitle}"/>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Open PDF files with this app" Foreground="{DynamicResource Ui.Text}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="DefaultPdfHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <xt:XTButton x:Name="DefaultPdfButton" Grid.Column="1" Style="{StaticResource UiGhostButton}" Text="Set as default…" Margin="24,0,0,0"
                                     VerticalAlignment="Top" Click="DefaultPdf_Click"
                                     ToolTip="Opens Windows Settings, where you choose PDF Reader Pro for .pdf files"/>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Show when someone else has the same file open" Foreground="{DynamicResource Ui.Text}" TextWrapping="Wrap"/>
                            <TextBlock Text="Writes a small hidden marker file next to each open PDF (removed when you close it), so other people using this app on the same folder, including a network share, are told." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="PresenceToggle" Grid.Column="1" Style="{StaticResource XTToggleSwitch}" Margin="24,0,0,0" VerticalAlignment="Top"
                                  Checked="Presence_Changed" Unchecked="Presence_Changed"/>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Use this app when “View PDF” is pressed in pdfFactory" Foreground="{DynamicResource Ui.Text}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PdfFactoryHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <CheckBox x:Name="PdfFactoryToggle" Grid.Column="1" Style="{StaticResource XTToggleSwitch}" Margin="24,0,0,0" VerticalAlignment="Top"
                                  Checked="PdfFactory_Changed" Unchecked="PdfFactory_Changed"/>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Clean up printed files older than (days)" Foreground="{DynamicResource Ui.Text}" TextWrapping="Wrap"/>
                            <TextBlock Text="Print inbox > Clean up only offers printed PDFs that are no longer in the inbox or open and are at least this old, and asks before moving them to the Recycle Bin. 0 = any age." Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <TextBox x:Name="PrintedDaysBox" Grid.Column="1" Width="64" Height="30" Margin="24,0,0,0" VerticalAlignment="Top" VerticalContentAlignment="Center"
                                 HorizontalContentAlignment="Center" LostFocus="PrintedDays_LostFocus" PreviewKeyDown="PrintedDays_PreviewKeyDown"/>
                    </Grid>
                </Border>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="0,9">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Folder for printed files" Foreground="{DynamicResource Ui.Text}" TextWrapping="Wrap"/>
                            <TextBlock x:Name="PrintedFolderHint" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="24,0,0,0" VerticalAlignment="Top">
                            <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Browse…" Click="PrintedFolderBrowse_Click"/>
                            <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Default" Margin="6,0,0,0" Click="PrintedFolderDefault_Click"
                                         ToolTip="Back to the default folder under Local AppData"/>
                        </StackPanel>
                    </Grid>
                </Border>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
        <TextBlock x:Name="AboutText" Grid.Row="1" Style="{StaticResource RowHint}" HorizontalAlignment="Right" Margin="0,4,20,10"/>
    </Grid>
</UserControl>
