<Window x:Class="XTPdfMergeApp.Controls.UpdateReadyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
        Title="PDF Reader Pro" Width="460" Height="400" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#D9E3F4" FontFamily="Segoe UI"
        UseLayoutRounding="True" Foreground="#162B62" RenderOptions.BitmapScalingMode="HighQuality">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <LinearGradientBrush x:Key="Green" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#78D775" Offset="0"/><GradientStop Color="#098F4C" Offset="1"/>
        </LinearGradientBrush>
        <Style x:Key="ChromeButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <!-- Hover = a soft white veil over the button (the colour stays); keyboard focus = a thin light ring, not a dark frame. -->
                <Grid>
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="7"/>
                    <Border x:Name="Veil" Background="White" CornerRadius="7" Opacity="0"/>
                    <Border x:Name="Ring" BorderBrush="#C8FFFFFF" BorderThickness="0" CornerRadius="7"/>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.22"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Veil" Property="Opacity" Value="0.08"/><Setter TargetName="Surface" Property="Opacity" Value="0.9"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Ring" Property="BorderThickness" Value="1.5"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border BorderBrush="#C6D7F2" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
            <local:AmbientBackdrop Grid.RowSpan="3"/>
            <Border Background="#25FFFFFF"/>
            <Border Grid.Row="2" Background="#25FFFFFF"/>
            <Grid Margin="16,0,10,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{StaticResource App.Icon.Logo}" Width="25" Height="25"/>
                    <TextBlock Text="PDF Reader Pro" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button x:Name="CloseX" HorizontalAlignment="Right" Width="30" Height="30" Style="{StaticResource ChromeButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="Dismiss_Click" AutomationProperties.Name="Đóng">
                    <Path Data="M0,0 L10,10 M10,0 L0,10" Stroke="#162B62" StrokeThickness="1.5" Width="10" Height="10"/>
                </Button>
            </Grid>
            <StackPanel Grid.Row="1" Margin="34,10,34,10" VerticalAlignment="Center">
                <Viewbox Width="60" Height="60" Margin="0,0,0,12">
                    <Canvas Width="72" Height="72">
                        <Path Data="M49,62 A30,30 0 1 1 65,42 M36,18 L36,46 M24,34 L36,46 L48,34"
                              Stroke="#3E68BD" StrokeThickness="4.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Ellipse Canvas.Left="47" Canvas.Top="44" Width="27" Height="27" Fill="{StaticResource Green}"/>
                        <Path Canvas.Left="54" Canvas.Top="53" Data="M0,4 L4,8 L13,0" Stroke="White" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Canvas>
                </Viewbox>
                <TextBlock x:Name="TitleText" Text="Có bản cập nhật mới" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock x:Name="VersionLine" FontSize="13" Foreground="#2C4A86" TextAlignment="Center" Margin="0,6,0,12"/>
                <Border x:Name="NotesCard" Background="#66FFFFFF" BorderBrush="#A0FFFFFF" BorderThickness="1" CornerRadius="8" Padding="14,10">
                    <TextBlock x:Name="NotesText" FontSize="12.5" Foreground="#2C4A86" TextWrapping="Wrap" MaxHeight="76" TextTrimming="CharacterEllipsis"/>
                </Border>
                <Grid x:Name="ProgressArea" Margin="0,14,0,0" Visibility="Collapsed">
                    <Border Height="10" CornerRadius="5" Background="#2E3E68BD" BorderBrush="#D0FFFFFF" BorderThickness="1" VerticalAlignment="Top">
                        <Grid ClipToBounds="True">
                            <Border x:Name="ProgressFill" Width="0" HorizontalAlignment="Left" CornerRadius="4" Background="{StaticResource Green}"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="ProgressText" FontSize="12" Foreground="#2C4A86" Margin="0,16,0,0"/>
                </Grid>
                <TextBlock x:Name="ErrorText" FontSize="12.5" Foreground="#B3261E" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
            </StackPanel>
            <Grid Grid.Row="2" Margin="22,0,16,0">
                <TextBlock x:Name="HintText" Text="~15 giây · cần quyền quản trị" FontSize="11.5" Foreground="#3F5F9E"
                           VerticalAlignment="Center" HorizontalAlignment="Left" TextTrimming="CharacterEllipsis" Margin="0,0,250,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="LaterButton" Content="Để sau" Background="#88FFFFFF" Foreground="#162B62" FontSize="13"
                            Width="84" Height="34" Margin="0,0,8,0" Style="{StaticResource ChromeButton}" Click="Dismiss_Click"/>
                    <Button x:Name="UpdateButton" Content="Cập nhật ngay" Background="{StaticResource Green}" Foreground="White" FontSize="13"
                            Width="130" Height="34" Style="{StaticResource ChromeButton}" Click="UpdateNow_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
