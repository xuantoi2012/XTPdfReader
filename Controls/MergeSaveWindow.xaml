<xt:XTWindow x:Class="XTPdfMergeApp.Controls.MergeSaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
        xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
        Title="Save merged file" Width="1000" Height="640" MinWidth="820" MinHeight="520"
        TitleBarMode="Dialog" WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <xt:XTWindow.Resources>
        <Style x:Key="OptionHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="26,1,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
        </Style>
        <HierarchicalDataTemplate DataType="{x:Type local:OutlineItem}" ItemsSource="{Binding Children}">
            <Grid MinWidth="300">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                    <Canvas Width="24" Height="24">
                        <Path Data="{StaticResource Ui.Icon.bookmark}" Stroke="{DynamicResource Ui.Muted}" Style="{StaticResource UiLineIconPath}"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                <TextBlock Grid.Column="2" Text="{Binding Page}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Muted}"/>
            </Grid>
        </HierarchicalDataTemplate>
    </xt:XTWindow.Resources>

    <Grid Background="{DynamicResource Ui.Surface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="470"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Row="0" Grid.Column="0" VerticalScrollBarVisibility="Auto" BorderThickness="0">
            <StackPanel Margin="20,18,20,12">
                <TextBlock Text="File name" Foreground="{DynamicResource Ui.Muted}" FontSize="12"/>
                <TextBox x:Name="NameBox" Height="32" Margin="0,4,0,12" VerticalContentAlignment="Center"/>
                <TextBlock Text="Save to" Foreground="{DynamicResource Ui.Muted}" FontSize="12"/>
                <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="FolderBox" Height="32" VerticalContentAlignment="Center"/>
                    <xt:XTButton Grid.Column="1" Style="{StaticResource UiGhostButton}" Text="Browse…" Height="32" Margin="8,0,0,0" Click="Browse_Click"/>
                </Grid>

                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" CornerRadius="8">
                    <ItemsControl x:Name="SourceList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:SourceRow}">
                                <Grid Height="38" Margin="10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource Ui.Icon.file}" Stroke="{DynamicResource Ui.Muted}" Style="{StaticResource UiLineIconPath}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}" ToolTip="{Binding Name}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Pages}" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                                    <TextBlock Grid.Column="3" Text="{Binding Range}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource Ui.Muted}"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <StackPanel Margin="0,16,0,0">
                    <CheckBox x:Name="FileBookmarksBox" Content="Add a bookmark for each source file" Margin="0,0,0,8" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <CheckBox x:Name="KeepBookmarksBox" Content="Keep bookmarks from the source files" Checked="Option_Changed" Unchecked="Option_Changed"/>
                    <TextBlock Style="{StaticResource OptionHint}" Text="They are nested under the file’s bookmark." Margin="26,1,0,8"/>
                    <CheckBox x:Name="MergeLayersBox" Content="Merge same-name layers"/>
                    <TextBlock x:Name="LayersHint" Style="{StaticResource OptionHint}" Margin="26,1,0,8"/>
                    <CheckBox x:Name="PageNumbersBox" Content="Add page numbers" Margin="0,0,0,8"/>
                    <CheckBox x:Name="OptimizeBox" Content="Optimize file size"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="0" Grid.Column="1" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1,0,0,0" Padding="20,18">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Bookmarks in the result" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource Ui.Text}"/>
                <TextBlock x:Name="SummaryText" DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="12" Foreground="{DynamicResource Ui.Muted}"/>
                <Border BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" CornerRadius="8" Padding="6">
                    <Grid>
                        <TreeView x:Name="OutlineTree" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <TreeView.Resources>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource UiTreeItem}">
                                    <Setter Property="IsExpanded" Value="True"/>
                                </Style>
                            </TreeView.Resources>
                        </TreeView>
                        <TextBlock x:Name="NoOutlineText" Text="The result will have no bookmarks." Margin="10" Foreground="{DynamicResource Ui.Muted}" Visibility="Collapsed"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" Background="{DynamicResource Ui.Panel}" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Cancel" Width="90" Height="34" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click"/>
                <xt:XTButton Style="{StaticResource UiPrimaryButton}" Icon="{StaticResource Ui.Icon.save}" Text="Save" Height="34" IsDefault="True" Click="Save_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</xt:XTWindow>
