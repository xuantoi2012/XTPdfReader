<UserControl x:Class="XTPdfMergeApp.Controls.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
             xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
             FontFamily="Segoe UI" FontSize="13" Background="{DynamicResource Ui.Panel}">
    <UserControl.Resources>
        <!-- Thẻ hàng (Recent, Quick locations): viền mảnh, hover nền theo theme. -->
        <Style x:Key="CardRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Ui.Surface}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="RecentCardRow" TargetType="Border" BasedOn="{StaticResource CardRow}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type local:RecentItem}">
            <Border Style="{StaticResource RecentCardRow}" Padding="12,10" MouseLeftButtonUp="Recent_MouseLeftButtonUp" ToolTip="{Binding Path}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="48" CornerRadius="4" Margin="0,0,14,0">
                        <Image Width="34" Height="34" Source="{StaticResource App.Icon.Document}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ui.Text}"/>
                        <TextBlock Text="{Binding Folder}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Foreground="{DynamicResource Ui.Muted}"/>
                        <TextBlock x:Name="Meta" Text="{Binding Meta}" FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource Ui.Muted}"/>
                    </StackPanel>
                    <Border x:Name="PinHost" Grid.Column="2" Width="30" Height="30" Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                            MouseLeftButtonUp="Pin_MouseLeftButtonUp" ToolTip="Pin to the top">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Star" Data="{StaticResource Ui.Icon.star}" Fill="{DynamicResource Ui.Muted}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter TargetName="Star" Property="Data" Value="{StaticResource Ui.Icon.star.Fill}"/>
                    <Setter TargetName="Star" Property="Fill" Value="{DynamicResource Ui.Accent}"/>
                </DataTrigger>
                <Trigger SourceName="PinHost" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Star" Property="Fill" Value="{DynamicResource Ui.Brand}"/>
                </Trigger>
                <DataTrigger Binding="{Binding Missing}" Value="True">
                    <Setter TargetName="Meta" Property="Foreground" Value="{DynamicResource Ui.Warn}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="QuickToolCard" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Ui.Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource Ui.Text}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,14"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource Ui.Hover}"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Ui.Brand}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Card" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- Cột co giãn cân đối, khoảng cách 24 DIP; mỗi cột cuộn riêng. -->
    <Grid Margin="32,32,32,24" MaxWidth="1600">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="1.45*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid x:Name="StartBrandHeader">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Image Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center" Source="{StaticResource App.Icon.Logo}" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Ui.Text}"/>
                </Grid>
                <WrapPanel Margin="0,18,0,0">
                    <xt:XTButton Style="{StaticResource UiPrimaryButton}" Icon="{StaticResource Ui.Icon.folder}" Text="Open file…  Ctrl+O" Height="38" Click="OpenFile_Click"/>
                    <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Open folder…" Height="38" Margin="10,0,0,0" Padding="16,0" Click="OpenFolder_Click"
                                 ToolTip="Open every PDF in a folder"/>
                </WrapPanel>
                <Border Height="140" Margin="0,18,0,0" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Ui.Border}">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Ui.Icon.file}" Fill="{DynamicResource Ui.Muted}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Drop PDF files here" Margin="0,8,0,0" Foreground="{DynamicResource Ui.Muted}"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="Quick locations" FontWeight="SemiBold" Margin="0,22,0,8" Foreground="{DynamicResource Ui.Text}"/>
                <ItemsControl x:Name="Locations">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardRow}" Padding="12,8" Margin="0,0,0,6" MouseLeftButtonUp="Location_MouseLeftButtonUp" ToolTip="{Binding Path}">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="{StaticResource Ui.Icon.folder}" Fill="{DynamicResource Ui.Muted}"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ui.Text}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Recent: thẻ riêng có viền + cuộn riêng bên trong, không phải cuộn cả trang Start. -->
        <DockPanel Grid.Column="2" LastChildFill="True">
            <Grid DockPanel.Dock="Top" Height="32">
                <TextBlock Text="Recent" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                <xt:XTButton HorizontalAlignment="Right" Style="{StaticResource UiGhostButton}" Text="Clear list" Height="26" Padding="10,0"
                             ToolTip="Remove the files that are not pinned" Click="ClearRecent_Click"/>
            </Grid>
            <Border Margin="0,12,0,0" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Ui.Border}" Background="{DynamicResource Ui.Surface}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10">
                    <StackPanel>
                        <ItemsControl x:Name="RecentList"/>
                        <TextBlock x:Name="NoRecentText" Text="Files you open will appear here." Foreground="{DynamicResource Ui.Muted}" Visibility="Collapsed"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </DockPanel>

        <DockPanel Grid.Column="4" LastChildFill="True">
            <TextBlock DockPanel.Dock="Top" Text="Quick tools" Height="32" VerticalAlignment="Center" Padding="0,6,0,0"
                       FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
                <StackPanel>
                    <Button Style="{StaticResource QuickToolCard}" Click="NewPdf_Click" ToolTip="Create a blank PDF (Ctrl+N)">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Left"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.newdoc}" Fill="{DynamicResource Ui.Brand}"/></Canvas></Viewbox>
                            <StackPanel Grid.Column="1"><TextBlock Text="New PDF" FontWeight="SemiBold"/><TextBlock Text="Create a blank document" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Ui.Muted}"/></StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource QuickToolCard}" Click="MergePdf_Click" ToolTip="Merge files and organize pages">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Left"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.merge}" Fill="{DynamicResource Ui.Brand}"/></Canvas></Viewbox>
                            <StackPanel Grid.Column="1"><TextBlock Text="Merge PDFs" FontWeight="SemiBold"/><TextBlock Text="Combine files and arrange pages" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Ui.Muted}"/></StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="ExportPdfButton" Style="{StaticResource QuickToolCard}" Click="ExportPdf_Click" ToolTip="Export or split the current document (Ctrl+Shift+E)">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Left"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.export}" Fill="{DynamicResource Ui.Brand}"/></Canvas></Viewbox>
                            <StackPanel Grid.Column="1"><TextBlock Text="Split / Export" FontWeight="SemiBold"/><TextBlock Text="Save selected pages as new PDFs" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Ui.Muted}"/></StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="PrintPdfButton" Style="{StaticResource QuickToolCard}" Click="PrintPdf_Click" ToolTip="Print the current document (Ctrl+P)">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Left"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.print}" Fill="{DynamicResource Ui.Brand}"/></Canvas></Viewbox>
                            <StackPanel Grid.Column="1"><TextBlock Text="Print PDF" FontWeight="SemiBold"/><TextBlock Text="Choose pages and print settings" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Ui.Muted}"/></StackPanel>
                        </Grid>
                    </Button>
                    <Button x:Name="CaptureButton" Style="{StaticResource QuickToolCard}" Click="Capture_Click" ToolTip="Capture any part of the screen into an editable PDF">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Left"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.capture}" Fill="{DynamicResource Ui.Brand}"/></Canvas></Viewbox>
                            <StackPanel Grid.Column="1"><TextBlock Text="Screen capture" FontWeight="SemiBold"/><TextBlock Text="Capture the screen into an editable PDF" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Ui.Muted}"/></StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource QuickToolCard}" Click="Captures_Click" ToolTip="Open the screen captures kept by XT Capture">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Left"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.captures}" Fill="{DynamicResource Ui.Brand}"/></Canvas></Viewbox>
                            <StackPanel Grid.Column="1"><TextBlock Text="Capture store" FontWeight="SemiBold"/><TextBlock Text="Your saved captures, ready to edit" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" Foreground="{DynamicResource Ui.Muted}"/></StackPanel>
                        </Grid>
                    </Button>
                    <TextBlock x:Name="DocumentToolsHint" Text="Open a PDF to split, export or print." FontSize="11.5" TextWrapping="Wrap" Margin="2,4,2,0" Foreground="{DynamicResource Ui.Muted}"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
