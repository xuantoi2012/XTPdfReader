<UserControl x:Class="XTPdfMergeApp.Controls.StartPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
             xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <!-- Thẻ hàng (Recent, Quick locations): viền mảnh, hover nền theo theme. -->
        <Style x:Key="CardRow" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Ui.Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource Ui.Surface}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Ui.Hover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Ui.Accent}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type local:RecentItem}">
            <Border Style="{StaticResource CardRow}" Padding="12,10" MouseLeftButtonUp="Recent_MouseLeftButtonUp" ToolTip="{Binding Path}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="40" Height="48" CornerRadius="4" Background="{DynamicResource Ui.AccentSoft}" Margin="0,0,14,0">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Ui.Icon.file}" Stroke="{DynamicResource Ui.Accent}" Style="{StaticResource UiLineIconPath}"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Ui.Text}"/>
                        <TextBlock Text="{Binding Folder}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" Foreground="{DynamicResource Ui.Muted}"/>
                        <TextBlock x:Name="Meta" Text="{Binding Meta}" FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource Ui.Muted}"/>
                    </StackPanel>
                    <Border Grid.Column="2" Width="30" Height="30" Background="Transparent" Cursor="Hand" VerticalAlignment="Center"
                            MouseLeftButtonUp="Pin_MouseLeftButtonUp" ToolTip="Pin to the top">
                        <Viewbox Width="17" Height="17">
                            <Canvas Width="24" Height="24">
                                <Path x:Name="Star" Data="{StaticResource Ui.Icon.star}" Stroke="{DynamicResource Ui.Border}"
                                      Style="{StaticResource UiLineIconPath}" StrokeThickness="2"/>
                            </Canvas>
                        </Viewbox>
                    </Border>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter TargetName="Star" Property="Stroke" Value="{DynamicResource Ui.Accent}"/>
                    <Setter TargetName="Star" Property="Fill" Value="{DynamicResource Ui.Accent}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Missing}" Value="True">
                    <Setter TargetName="Meta" Property="Foreground" Value="{DynamicResource Ui.Warn}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type local:WorkspaceItem}">
            <Border Width="230" Margin="0,0,12,12" Padding="12" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" CornerRadius="8"
                    Background="{DynamicResource Ui.Surface}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Path Data="{StaticResource Ui.Icon.workspace}" Stroke="{DynamicResource Ui.Accent}" Style="{StaticResource UiLineIconPath}"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Ui.Text}" ToolTip="{Binding Name}"/>
                        <Border Grid.Column="2" Width="24" Height="24" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="DeleteWorkspace_MouseLeftButtonUp"
                                ToolTip="Delete this workspace">
                            <Viewbox Width="14" Height="14">
                                <Canvas Width="24" Height="24">
                                    <Path Data="{StaticResource Ui.Icon.close}" Stroke="{DynamicResource Ui.Muted}" Style="{StaticResource UiLineIconPath}" StrokeThickness="2"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Meta}" FontSize="11.5" Margin="0,6,0,10" Foreground="{DynamicResource Ui.Muted}"/>
                    <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Restore" Click="RestoreWorkspace_Click"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Ui.Panel}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Margin="48,36,20,0">
            <TextBlock x:Name="TitleText" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}"/>
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <xt:XTButton Style="{StaticResource UiPrimaryButton}" Icon="{StaticResource Ui.Icon.folder}" Text="Open file…  Ctrl+O" Height="38" Click="OpenFile_Click"/>
            </StackPanel>
            <Border Height="140" Margin="0,18,0,0" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Ui.Border}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Viewbox Width="28" Height="28" HorizontalAlignment="Center">
                        <Canvas Width="24" Height="24">
                            <Path Data="{StaticResource Ui.Icon.file}" Stroke="{DynamicResource Ui.Muted}" Style="{StaticResource UiLineIconPath}"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="Drop PDF files here" Margin="0,8,0,0" Foreground="{DynamicResource Ui.Muted}"/>
                </StackPanel>
            </Border>
            <TextBlock Text="Quick locations" FontWeight="SemiBold" Margin="0,22,0,8" Foreground="{DynamicResource Ui.Text}"/>
            <ItemsControl x:Name="Locations">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardRow}" Padding="12,8" Margin="0,0,0,6" MouseLeftButtonUp="Location_MouseLeftButtonUp" ToolTip="{Binding Path}">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                    <Canvas Width="24" Height="24">
                                        <Path Data="{StaticResource Ui.Icon.folder}" Stroke="{DynamicResource Ui.Muted}" Style="{StaticResource UiLineIconPath}"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ui.Text}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0">
            <StackPanel Margin="20,36,48,36" MaxWidth="820" HorizontalAlignment="Left">
                <Grid>
                    <TextBlock Text="Recent" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}"/>
                    <xt:XTButton HorizontalAlignment="Right" Style="{StaticResource UiGhostButton}" Text="Clear list" Height="26" Padding="10,0"
                                 ToolTip="Remove the files that are not pinned" Click="ClearRecent_Click"/>
                </Grid>
                <ItemsControl x:Name="RecentList" Margin="0,12,0,0"/>
                <TextBlock x:Name="NoRecentText" Text="Files you open will appear here." Foreground="{DynamicResource Ui.Muted}" Margin="0,12,0,0" Visibility="Collapsed"/>

                <Grid Margin="0,22,0,12">
                    <TextBlock Text="Workspaces" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Ui.Text}"/>
                    <xt:XTButton x:Name="SaveWorkspaceButton" HorizontalAlignment="Right" Style="{StaticResource UiGhostButton}" Text="Save open files as workspace…"
                                 Height="26" Padding="10,0" Click="SaveWorkspace_Click"/>
                </Grid>
                <ItemsControl x:Name="WorkspaceList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="NoWorkspaceText" Text="A workspace remembers the set of open files so you can restore it in one click." TextWrapping="Wrap"
                           Foreground="{DynamicResource Ui.Muted}" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
