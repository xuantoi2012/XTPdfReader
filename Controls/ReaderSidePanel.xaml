<UserControl x:Class="XTPdfMergeApp.Controls.ReaderSidePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
             xmlns:svc="clr-namespace:XTPdfMergeApp.Services"
             xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
             xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
             FontFamily="Segoe UI" FontSize="12">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/XTPdfMergeApp;component/Resources/ReaderResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="UiThumbItemPanel" TargetType="ListBoxItem" BasedOn="{StaticResource UiThumbItem}">
                <EventSetter Event="PreviewMouseRightButtonDown" Handler="ThumbItem_PreviewMouseRightButtonDown"/>
            </Style>

            <Style x:Key="UiThumbNumber" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="Margin" Value="0,5,0,0"/>
                <Setter Property="Foreground" Value="{DynamicResource Ui.Muted}"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource Ui.Accent}"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <HierarchicalDataTemplate DataType="{x:Type svc:PdfBookmarkNode}" ItemsSource="{Binding Children}">
                <Grid Background="Transparent" ToolTip="{Binding Title}" MouseLeftButtonUp="Bookmark_MouseLeftButtonUp">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Add bookmark here (current page)" Click="BookmarkAddChild_Click"/>
                            <MenuItem Header="Rename…" Click="BookmarkRename_Click"/>
                            <Separator/>
                            <MenuItem Header="Move up" Click="BookmarkMoveUp_Click"/>
                            <MenuItem Header="Move down" Click="BookmarkMoveDown_Click"/>
                            <Separator/>
                            <MenuItem Header="Delete" Click="BookmarkDelete_Click"/>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                    <TextBlock Grid.Column="1" Text="{Binding PageNumber}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource Ui.Muted}"/>
                </Grid>
            </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Ui.Surface}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Icon rail. Tag="Active" is set by SetTab. -->
        <Border Grid.Column="0" Width="44" Background="{DynamicResource Ui.Panel}"
                BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="0,8,0,8" LastChildFill="False">
                <StackPanel DockPanel.Dock="Top">
                <xt:XTButton x:Name="ThumbnailTabButton" Style="{StaticResource UiRailButton}" Tag="Active"
                             Icon="{StaticResource Ui.Icon.pages}" ToolTip="Pages" Click="ThumbnailTab_Click"/>
                <xt:XTButton x:Name="BookmarkTabButton" Style="{StaticResource UiRailButton}"
                             Icon="{StaticResource Ui.Icon.bookmark}" ToolTip="Bookmarks" Click="BookmarkTab_Click"/>
                <xt:XTButton x:Name="LayerTabButton" Style="{StaticResource UiRailButton}"
                             Icon="{StaticResource Ui.Icon.layers}" ToolTip="Layers" Click="LayerTab_Click"/>
                <xt:XTButton x:Name="CommentsTabButton" Style="{StaticResource UiRailButton}"
                             Icon="{StaticResource Ui.Icon.comment}" ToolTip="Comments" Click="CommentsTab_Click"/>
                <xt:XTButton x:Name="FindTabButton" Style="{StaticResource UiRailButton}"
                             Icon="{StaticResource Ui.Icon.search}" ToolTip="Find in document (Ctrl+F)" Click="FindTab_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <DockPanel x:Name="PanelContent" Grid.Column="1">
            <Grid DockPanel.Dock="Top" Height="40" Margin="14,0,8,0">
                <TextBlock x:Name="PanelTitleText" Text="Pages" FontWeight="SemiBold" FontSize="13"
                           VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                <xt:XTButton x:Name="PanelCollapseButton" Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.dleft}" Width="30" Height="30" IconSize="22"
                             HorizontalAlignment="Right" ToolTip="Hide the panel" Click="CollapsePanel_Click"/>
            </Grid>

            <TextBlock x:Name="PanelSourceText" DockPanel.Dock="Top" Margin="14,0,14,8" FontSize="11"
                       Foreground="{DynamicResource Ui.Muted}" TextTrimming="CharacterEllipsis" Visibility="Collapsed"/>

            <!-- Thêm bookmark ở trang đang xem (chỉ tab Bookmarks). Sửa tên/xoá qua menu chuột phải trên từng mục. -->
            <Border x:Name="BookmarkActionsBar" DockPanel.Dock="Top" Padding="14,0,14,8" Visibility="Collapsed">
                <xt:XTButton Style="{StaticResource UiGhostButton}" Icon="{StaticResource Ui.Icon.plus}" Text="Add bookmark"
                             HorizontalAlignment="Left" Height="26" Padding="8,0" ToolTip="Add a bookmark for the page you're currently viewing"
                             Click="AddBookmark_Click"/>
            </Border>

            <!-- Hàng thao tác trang (chỉ tab Pages). Panel chỉ báo sự kiện; ReaderWindow gọi handler cũ. -->
            <Border x:Name="PageActionsBar" DockPanel.Dock="Top" Padding="10,0,10,8"
                    BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1">
                <UniformGrid Rows="1">
                    <xt:XTButton Style="{StaticResource UiPanelAction}" Icon="{StaticResource Ui.Icon.insert}" Text="Insert ▾"
                                 ToolTip="Insert pages from another PDF after the current page" Click="InsertPages_Click"/>
                    <xt:XTButton Style="{StaticResource UiPanelAction}" Icon="{StaticResource Ui.Icon.trash}" Text="Delete"
                                 ToolTip="Delete the selected pages from this document (can be undone)" Click="DeletePages_Click"/>
                    <xt:XTButton Style="{StaticResource UiPanelAction}" Icon="{StaticResource Ui.Icon.rotl}" Text="Turn left"
                                 ToolTip="Rotate the selected pages 90° left and save to the file" Click="RotateLeft_Click"/>
                    <xt:XTButton Style="{StaticResource UiPanelAction}" Icon="{StaticResource Ui.Icon.rotr}" Text="Turn right"
                                 ToolTip="Rotate the selected pages 90° right and save to the file" Click="RotateRight_Click"/>
                    <xt:XTButton Style="{StaticResource UiPanelAction}" Icon="{StaticResource Ui.Icon.extract}" Text="Extract"
                                 ToolTip="Extract the selected pages to a new PDF" Click="ExtractPages_Click"/>
                </UniformGrid>
            </Border>

            <Border x:Name="SelectionBar" DockPanel.Dock="Top" Height="34" Visibility="Collapsed">
                <DockPanel Margin="14,0">
                    <TextBlock DockPanel.Dock="Right" Text="Ctrl+C copy · Ctrl+V paste" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Muted}"/>
                    <TextBlock x:Name="SelectionText" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
                </DockPanel>
            </Border>

            <Grid>
                <!-- Thumbnail 2 cột (ảo hoá). Chọn nhiều trang bằng Ctrl/Shift để xoay/xuất/xoá cùng lúc. -->
                <ListBox x:Name="ThumbnailList" BorderThickness="0" Background="Transparent" Padding="6,6,6,0"
                         SelectionMode="Extended" ItemContainerStyle="{StaticResource UiThumbItemPanel}"
                         PreviewKeyDown="ThumbnailList_PreviewKeyDown" ContextMenuOpening="ThumbnailList_ContextMenuOpening"
                         AllowDrop="True" PreviewMouseLeftButtonDown="Thumb_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="Thumb_PreviewMouseMove" PreviewMouseLeftButtonUp="Thumb_PreviewMouseLeftButtonUp"
                         DragOver="Thumb_DragOver" DragLeave="Thumb_DragLeave" Drop="Thumb_Drop"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="ThumbnailList_SelectionChanged">
                    <!-- Dùng đúng scrollbar của vùng đọc chính để Page sidebar và canvas không có hai ngôn ngữ thị giác khác nhau. -->
                    <ListBox.Resources>
                        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource UiReaderVerticalScrollBar}"/>
                    </ListBox.Resources>
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" InputGestureText="Ctrl+C" Tag="Copy" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.copy}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Cut" InputGestureText="Ctrl+X" Tag="Cut" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.cut}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="MiPasteAfter" Header="Paste after" InputGestureText="Ctrl+V" Tag="PasteAfter" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.paste}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                            <MenuItem x:Name="MiPasteBefore" Header="Paste before" InputGestureText="Ctrl+Shift+V" Tag="PasteBefore" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.paste}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                            <Separator/>
                            <MenuItem Header="Move"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.goto}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon>
                                <MenuItem Header="Move to start" InputGestureText="Ctrl+Shift+Home" Tag="MoveToStart" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.top}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Move up one" InputGestureText="Alt+Up" Tag="MoveUp" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.up}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Move down one" InputGestureText="Alt+Down" Tag="MoveDown" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.down}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                                <MenuItem Header="Move to end" InputGestureText="Ctrl+Shift+End" Tag="MoveToEnd" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.bottom}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                                <Separator/>
                                <MenuItem Header="Move to position…" Tag="MoveToPosition" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.goto}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                            </MenuItem>
                            <MenuItem Header="Duplicate" InputGestureText="Ctrl+D" Tag="Duplicate" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.dup}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Rotate left" Tag="RotateLeft" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.undo}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Rotate right" Tag="RotateRight" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.redo}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                            <MenuItem Header="Extract…" Tag="Extract" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.extract}" Fill="{DynamicResource Ui.Text}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                            <Separator/>
                            <MenuItem x:Name="MiDelete" Header="Delete" InputGestureText="Del" Tag="Delete" Click="PageMenu_Click"><MenuItem.Icon><Viewbox Width="16" Height="16"><Canvas Width="24" Height="24"><Path Data="{StaticResource Ui.Icon.trash}" Fill="{DynamicResource Ui.Danger}"/></Canvas></Viewbox></MenuItem.Icon></MenuItem>
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <vwp:VirtualizingWrapPanel Orientation="Horizontal" SpacingMode="Uniform" StretchItems="False"
                                                       IsGridLayoutEnabled="True" ItemSize="128,124"/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,6,0,4" Width="112">
                                <Border Background="White" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="1" CornerRadius="2"
                                        Width="112" Height="84" HorizontalAlignment="Center">
                                    <local:PageThumbnailImage Source="{Binding Thumbnail}" Stretch="Uniform"
                                           Loaded="ThumbnailImage_Loaded" Unloaded="ThumbnailImage_Unloaded"
                                           DataContextChanged="ThumbnailImage_DataContextChanged"/>
                                </Border>
                                <TextBlock Text="{Binding Index}" Style="{StaticResource UiThumbNumber}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Vạch chèn khi kéo trang (do Thumb_DragOver đặt vị trí). -->
                <Border x:Name="DropLine" Width="3" CornerRadius="2" Background="{DynamicResource Ui.Accent}" Visibility="Collapsed"
                        HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Panel.ZIndex="5"/>

                <TreeView x:Name="BookmarkTree" BorderThickness="0" Background="Transparent" Visibility="Collapsed"
                          VirtualizingPanel.IsVirtualizing="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0,2">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource UiTreeItem}"/>
                    </TreeView.Resources>
                </TreeView>

                <local:LayersPanel x:Name="LayersView" Visibility="Collapsed"/>
                <local:FindPanel x:Name="FindView" Visibility="Collapsed"/>
                <local:CommentsPanel x:Name="CommentsView" Visibility="Collapsed"/>

                <TextBlock x:Name="PanelEmptyText" Visibility="Collapsed" Margin="14" TextWrapping="Wrap"
                           Foreground="{DynamicResource Ui.Muted}"/>
            </Grid>
        </DockPanel>
    </Grid>
</UserControl>
