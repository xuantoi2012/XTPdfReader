<UserControl x:Class="XTPdfMergeApp.Controls.MergeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:xt="clr-namespace:XTStyle.Controls;assembly=XTStyle"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <!-- Nút phân đoạn (layout): nền chip, mục chọn nền accent. -->
        <Style x:Key="LayoutItem" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Height="28" MinWidth="34" Padding="10,0" CornerRadius="5" Background="Transparent" SnapsToDevicePixels="True">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource Ui.Muted}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Ui.Hover}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Ui.Text}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource XTPrimaryButtonBackground}"/>
                                <Setter TargetName="Tx" Property="Foreground" Value="{DynamicResource Ui.OnAccent}"/>
                                <Setter TargetName="Tx" Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Ui.Bg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Height="50" Background="{DynamicResource Ui.Surface}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,0,0,1" Padding="16,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <xt:XTButton Style="{StaticResource UiGhostButton}" Icon="{StaticResource Ui.Icon.plus}" Text="Temp window" Margin="0,0,12,0" Click="NewTemp_Click"
                                 ToolTip="Add an empty window to collect pages from several files, then save it as a new file"/>
                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.undo}" Width="30" Height="30" ToolTip="Undo (Ctrl+Z)" Click="Undo_Click"/>
                    <xt:XTButton Style="{StaticResource UiIconButton}" Icon="{StaticResource Ui.Icon.redo}" Width="30" Height="30" ToolTip="Redo (Ctrl+Y)" Click="Redo_Click" Margin="0,0,12,0"/>
                    <xt:XTButton Style="{StaticResource UiPrimaryButton}" Icon="{StaticResource Ui.Icon.merge}" Text="Merge into one file…" Click="MergeAll_Click"
                                 ToolTip="Save all windows, in this order, as a single PDF (same-name layers are merged)"/>
                    <xt:XTButton Style="{StaticResource UiGhostButton}" Text="Done" Margin="8,0,0,0" Click="Done_Click" ToolTip="Back to the reader"/>
                </StackPanel>
                <TextBlock Text="Merge" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{DynamicResource Ui.Text}"/>
                <Border CornerRadius="7" Background="{DynamicResource Ui.Chip}" Padding="2" VerticalAlignment="Center" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LayoutOne" Style="{StaticResource LayoutItem}" GroupName="MergeLayout" Content="1" Tag="One" ToolTip="One window" Checked="Layout_Checked"/>
                        <RadioButton x:Name="LayoutTwo" Style="{StaticResource LayoutItem}" GroupName="MergeLayout" Content="1 | 2" Tag="Two" ToolTip="Two side by side" Checked="Layout_Checked"/>
                        <RadioButton x:Name="LayoutThree" Style="{StaticResource LayoutItem}" GroupName="MergeLayout" Content="3 cols" Tag="Three" ToolTip="Three columns" Checked="Layout_Checked"/>
                        <RadioButton x:Name="LayoutGrid" Style="{StaticResource LayoutItem}" GroupName="MergeLayout" Content="2×2" Tag="Grid" ToolTip="2 × 2 grid" Checked="Layout_Checked"/>
                        <RadioButton x:Name="LayoutFree" Style="{StaticResource LayoutItem}" GroupName="MergeLayout" Content="Free" Tag="Free" ToolTip="Move and resize windows freely" Checked="Layout_Checked"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <Canvas x:Name="Workspace" Grid.Row="1" ClipToBounds="True" Background="Transparent" SizeChanged="Workspace_SizeChanged"/>
        <StackPanel x:Name="EmptyHint" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
            <TextBlock Text="No files open" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Foreground="{DynamicResource Ui.Text}"/>
            <TextBlock Text="Open PDF files to arrange and merge their pages here." Margin="0,6,0,14" Foreground="{DynamicResource Ui.Muted}"/>
            <xt:XTButton Style="{StaticResource UiPrimaryButton}" Icon="{StaticResource Ui.Icon.folder}" Text="Open file…" HorizontalAlignment="Center" Click="OpenFile_Click"/>
        </StackPanel>

        <!-- Dock: cửa sổ đã thu nhỏ (hoặc vượt số cửa sổ tối đa). Bấm chip = mở lại; thả trang lên chip = nối vào cuối file đó. -->
        <Border x:Name="DockBar" Grid.Row="2" Height="44" Background="{DynamicResource Ui.Panel}" BorderBrush="{DynamicResource Ui.Border}" BorderThickness="0,1,0,0" Padding="16,0">
            <DockPanel>
                <TextBlock Text="Dock" VerticalAlignment="Center" Margin="0,0,12,0" FontSize="11.5" Foreground="{DynamicResource Ui.Muted}"/>
                <StackPanel x:Name="DockChips" Orientation="Horizontal" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
