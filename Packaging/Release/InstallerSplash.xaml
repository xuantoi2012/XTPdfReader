<!-- Rendered by Build-Splash.ps1. No fake percentage: the bar indicates ongoing work. -->
<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="480" Height="390" Background="#BBCADF" BorderBrush="#B8CBEC" BorderThickness="1"
        RenderOptions.BitmapScalingMode="HighQuality"
        TextElement.FontFamily="Segoe UI" TextElement.Foreground="#162B62" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="54"/></Grid.RowDefinitions>
        <!--AMBIENT-->
        <Border Background="#25FFFFFF"/>
        <Border Grid.Row="2" Background="#25FFFFFF"/>
        <StackPanel Orientation="Horizontal" Margin="16,0" VerticalAlignment="Center">
            <Image Source="__ICON__" Width="25" Height="25"/>
            <TextBlock Text="PDF Reader Pro" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <StackPanel VerticalAlignment="Center" Margin="36,22">
                <Image Source="__ICON__" Width="64" Height="64" Margin="0,0,0,17"/>
                <TextBlock Text="Đang cài đặt" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock Text="Chuẩn bị không gian làm việc của bạn." FontSize="13" Foreground="#385B9B" TextAlignment="Center" Margin="0,10,0,37"/>
                <Border Background="#35FFFFFF" BorderBrush="#C0FFFFFF" BorderThickness="1" Height="12" CornerRadius="6">
                    <Grid ClipToBounds="True">
                        <Border x:Name="ProgressSegment" Width="134" HorizontalAlignment="Left" CornerRadius="5">
                            <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#78D775" Offset="0"/><GradientStop Color="#098F4C" Offset="1"/>
                            </LinearGradientBrush></Border.Background>
                            <Border.RenderTransform><TranslateTransform X="0"/></Border.RenderTransform>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Text="Đang cài đặt ứng dụng…" FontSize="12.5" Foreground="#385B9B" Margin="0,13,0,0"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Text="PDF Reader Pro v__VERSION__" FontSize="11.5" Foreground="#5376AE" Margin="22,0" VerticalAlignment="Center"/>
    </Grid>
</Border>
