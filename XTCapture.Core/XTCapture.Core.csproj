<Project Sdk="Microsoft.NET.Sdk">

  <!-- The screen-capture engine shared by XT Capture (the always-running tray program) and the tests: the frozen / dimmed overlay, window and
       area picking, the cut-out maths. No PDF code here: XT Capture stays light. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>XTCapture</RootNamespace>
    <AssemblyName>XTCapture.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XTCapture" />
    <InternalsVisibleTo Include="XTPdfMergeApp.PerformanceTests" />
  </ItemGroup>

</Project>
