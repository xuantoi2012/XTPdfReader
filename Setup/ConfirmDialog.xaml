<Window x:Class="PdfReaderSetup.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
        Width="400" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStyle="None" WindowStartupLocation="CenterOwner" Background="#D9E3F4" FontFamily="Segoe UI"
        UseLayoutRounding="True" Foreground="#162B62" RenderOptions.BitmapScalingMode="HighQuality">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#C6D7F2" BorderThickness="1" CornerRadius="10">
        <Grid>
            <local:AmbientBackdrop/>
            <StackPanel Margin="28,24,28,20">
                <StackPanel Orientation="Horizontal">
                    <Image Source="/Resources/AppIcon.png" Width="30" Height="30"/>
                    <TextBlock x:Name="TitleText" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock x:Name="MessageText" FontSize="13" Foreground="#2C4A86" TextWrapping="Wrap" LineHeight="20" Margin="0,14,0,22"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="FirstButton" Height="34" MinWidth="96" Padding="18,0" Margin="0,0,8,0" Style="{StaticResource PillButton}" Click="First_Click"/>
                    <Button x:Name="SecondButton" Height="34" MinWidth="96" Padding="18,0" Style="{StaticResource PillButton}" Click="Second_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
