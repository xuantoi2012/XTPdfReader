<Window x:Class="PdfReaderSetup.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:XTPdfMergeApp.Controls"
        Title="PDF Reader Pro" Width="480" Height="350" ResizeMode="NoResize"
        WindowStyle="None" WindowStartupLocation="CenterScreen" Background="#D9E3F4" FontFamily="Segoe UI"
        UseLayoutRounding="True" Foreground="#162B62" RenderOptions.BitmapScalingMode="HighQuality">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" CornerRadius="10" GlassFrameThickness="0" ResizeBorderThickness="0"/>
    </shell:WindowChrome.WindowChrome>
    <Border BorderBrush="#C6D7F2" BorderThickness="1" CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <local:AmbientBackdrop Grid.RowSpan="3"/>
            <Border Background="#25FFFFFF"/>
            <Border Grid.Row="2" Background="#25FFFFFF"/>
            <Grid Margin="16,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Resources/AppIcon.png" Width="25" Height="25"/>
                    <TextBlock Text="PDF Reader Pro" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
                <Button x:Name="CloseX" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource CloseGlyphButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CloseX_Click" AutomationProperties.Name="Đóng" ToolTip="Đóng"/>
            </Grid>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="36,4,36,8">
                <!-- Logo with a slowly breathing light behind it; the green badge pops in when the work is done. -->
                <Grid Width="52" Height="52" Margin="0,0,0,16" HorizontalAlignment="Center">
                    <Ellipse x:Name="Glow" Width="170" Height="170" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5" Opacity="0.7">
                        <Ellipse.Fill><RadialGradientBrush>
                            <GradientStop Color="#80FFFFFF" Offset="0"/><GradientStop Color="#30FFFFFF" Offset="0.45"/><GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush></Ellipse.Fill>
                        <Ellipse.RenderTransform><ScaleTransform x:Name="GlowScale" ScaleX="1" ScaleY="1"/></Ellipse.RenderTransform>
                    </Ellipse>
                    <Image Source="/Resources/AppIcon.png" Width="52" Height="52"/>
                    <Grid x:Name="Badge" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-6" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform x:Name="BadgeScale" ScaleX="0" ScaleY="0"/></Grid.RenderTransform>
                        <Ellipse Fill="{StaticResource Green}" Stroke="White" StrokeThickness="1.5"/>
                        <Path Data="M6,11.5 L9.5,15 L16,7.5" Stroke="White" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                    </Grid>
                </Grid>
                <TextBlock x:Name="TitleText" Text="Đang cài đặt" FontSize="19" FontWeight="SemiBold" TextAlignment="Center"/>
                <TextBlock x:Name="SubtitleText" Text="Chuẩn bị không gian làm việc của bạn." FontSize="13" Foreground="#2C4A86"
                           TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,16"/>
                <StackPanel x:Name="FeaturesPanel" HorizontalAlignment="Center" Margin="0,0,0,2">
                    <TextBlock x:Name="Feature1" FontSize="12.5" Foreground="#2C4A86" Margin="0,0,0,5"/>
                    <TextBlock x:Name="Feature2" FontSize="12.5" Foreground="#2C4A86" Margin="0,0,0,5"/>
                    <TextBlock x:Name="Feature3" FontSize="12.5" Foreground="#2C4A86"/>
                </StackPanel>
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,8,0,0">
                <Border x:Name="Track" Background="#2E3E68BD" BorderBrush="#D0FFFFFF" BorderThickness="1" Height="12" CornerRadius="6">
                    <Grid ClipToBounds="True">
                        <Border x:Name="Fill" Width="0" HorizontalAlignment="Left" CornerRadius="5" Background="{StaticResource Green}" ClipToBounds="True">
                            <!-- A soft highlight sliding along the filled part: the bar looks alive even while a step takes a moment. -->
                            <Rectangle x:Name="Sheen" Width="90" HorizontalAlignment="Left" IsHitTestVisible="False">
                                <Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#78FFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/>
                                </LinearGradientBrush></Rectangle.Fill>
                                <Rectangle.RenderTransform><TranslateTransform x:Name="SheenShift" X="-90"/></Rectangle.RenderTransform>
                            </Rectangle>
                        </Border>
                        <Border x:Name="FinishFlash" Background="White" CornerRadius="5" Opacity="0" IsHitTestVisible="False"/>
                    </Grid>
                </Border>
                <Grid Margin="0,12,0,0">
                    <TextBlock x:Name="StageText" Text="Đang chuẩn bị…" FontSize="12.5" Foreground="#2C4A86" TextTrimming="CharacterEllipsis" Margin="0,0,50,0"/>
                    <TextBlock x:Name="PercentText" Text="0%" FontSize="12.5" Foreground="#2C4A86" HorizontalAlignment="Right"/>
                </Grid>
                </StackPanel>
                <Button x:Name="ActionButton" Background="{StaticResource Green}" Foreground="White" Width="150" Height="34"
                        Style="{StaticResource PillButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="Action_Click"/>
                <StackPanel x:Name="Buttons" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed">
                    <Button x:Name="LaunchButton" Content="Mở PDF Reader Pro" Background="{StaticResource Green}" Foreground="White"
                            Width="150" Height="34" Style="{StaticResource PillButton}" Margin="0,0,18,0" Click="Launch_Click"/>
                    <Button x:Name="CloseButton" Content="Đóng" Background="#88FFFFFF" Foreground="#162B62"
                            Width="150" Height="34" Style="{StaticResource PillButton}" Click="Close_Click"/>
                </StackPanel>
            </StackPanel>
            <Grid Grid.Row="2" Margin="18,0">
                <TextBlock x:Name="VersionText" FontSize="11.5" Foreground="#3F5F9E" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <TextBlock Text="XT Solution © 2026" FontSize="11.5" Foreground="#3F5F9E" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            </Grid>
        </Grid>
    </Border>
</Window>
