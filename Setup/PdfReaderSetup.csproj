<Project Sdk="Microsoft.NET.Sdk">

  <!-- PDF Reader Pro installer: one small single-file exe; Build-Release.ps1 appends the zipped app after it (see Payload.cs).
       Runs elevated (installs into Program Files). Needs the .NET 10 Desktop Runtime, like the Reader itself. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PDFReaderPro-Setup</AssemblyName>
    <RootNamespace>PdfReaderSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\PDF icon.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <!-- The same ambient backdrop and logo as the Reader's own windows. -->
  <ItemGroup>
    <Resource Include="..\Resources\AppIcon.png" Link="Resources\AppIcon.png" />
    <Compile Include="..\Controls\AmbientBackdrop.xaml.cs" Link="AmbientBackdrop.xaml.cs" />
    <Page Include="..\Controls\AmbientBackdrop.xaml" Link="AmbientBackdrop.xaml" />
  </ItemGroup>

</Project>
