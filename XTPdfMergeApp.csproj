<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- windows10.0.19041.0 cho WPF desktop; thumbnail PDF render trực tiếp bằng PDFium native. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- PdfiumInstance gọi PDFium qua con trỏ hàm (nhiều bản sao thư viện, xem Services/PdfiumInstance.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>XTPdfMergeApp</AssemblyName>
    <RootNamespace>XTPdfMergeApp</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>XTPdfMergeApp.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Publish làm 1 file exe gọn: dotnet publish, -r win-x64, -c Release,
         PublishSingleFile=true, SelfContained=true (xem README khi cần). -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>PDF icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <EmbeddedResource Remove="Tests\**\*" />
    <None Remove="Tests\**\*" />
    <Resource Include="Resources\AppIcon.png" />
    <InternalsVisibleTo Include="XTPdfMergeApp.PerformanceTests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="PDF icon.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="itext" Version="9.6.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.6.0" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="147.0.7690" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XTStyle\XTStyle.csproj" />
  </ItemGroup>

  <!-- Vẽ song song: bản sao pdfium.dll mang tên khác (pdfium_1..3.dll) nằm cạnh bản gốc. Mỗi tên file là 1
       module riêng với trạng thái toàn cục riêng, nên các bản chạy song song được (Services/PdfiumInstance.cs,
       PdfiumPool: tối đa 4 bản). -->
  <Target Name="CopyPdfiumInstances" AfterTargets="Build">
    <ItemGroup>
      <_PdfiumOriginal Include="$(OutDir)pdfium.dll" Condition="Exists('$(OutDir)pdfium.dll')" />
      <_PdfiumOriginal Include="$(OutDir)runtimes\win-x64\native\pdfium.dll" Condition="Exists('$(OutDir)runtimes\win-x64\native\pdfium.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PdfiumOriginal)" DestinationFiles="@(_PdfiumOriginal->'%(RootDir)%(Directory)pdfium_1.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PdfiumOriginal)" DestinationFiles="@(_PdfiumOriginal->'%(RootDir)%(Directory)pdfium_2.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PdfiumOriginal)" DestinationFiles="@(_PdfiumOriginal->'%(RootDir)%(Directory)pdfium_3.dll')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPdfiumInstancesToPublish" AfterTargets="Publish">
    <ItemGroup>
      <_PdfiumPublished Include="$(PublishDir)pdfium.dll" Condition="Exists('$(PublishDir)pdfium.dll')" />
      <_PdfiumPublished Include="$(PublishDir)runtimes\win-x64\native\pdfium.dll" Condition="Exists('$(PublishDir)runtimes\win-x64\native\pdfium.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PdfiumPublished)" DestinationFiles="@(_PdfiumPublished->'%(RootDir)%(Directory)pdfium_1.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PdfiumPublished)" DestinationFiles="@(_PdfiumPublished->'%(RootDir)%(Directory)pdfium_2.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PdfiumPublished)" DestinationFiles="@(_PdfiumPublished->'%(RootDir)%(Directory)pdfium_3.dll')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ExcludeNativeSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
