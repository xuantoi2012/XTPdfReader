<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <MuPdfOnly Condition="'$(MuPdfOnly)' == ''">true</MuPdfOnly>
    <NativeOnly Condition="'$(NativeOnly)' == '' And '$(MuPdfOnly)' == 'true'">true</NativeOnly>
    <NativeOnly Condition="'$(NativeOnly)' == ''">false</NativeOnly>
    <MuPdfRuntimeDir Condition="'$(MuPdfRuntimeDir)' == ''">$(MSBuildProjectDirectory)\bin\MuPdfRuntime</MuPdfRuntimeDir>
    <!-- windows10.0.19041.0 cho WPF desktop; thumbnail PDF render trực tiếp bằng PDFium native. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- PdfiumInstance gọi PDFium qua con trỏ hàm (nhiều bản sao thư viện, xem Services/PdfiumInstance.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>XTPdfMergeApp</AssemblyName>
    <RootNamespace>XTPdfMergeApp</RootNamespace>
    <!-- Mốc bắt đầu — mỗi lần phát hành đổi qua tham số -Version của Packaging/Release/Build-Release.ps1
         (dùng /p:Version lúc publish), không cần sửa tay ở đây mỗi lần. -->
    <Version>1.0.0</Version>
    <Product>PDF Reader Pro</Product>
    <!-- Task Manager shows the file description, not the assembly name. -->
    <AssemblyTitle>PDF Reader Pro</AssemblyTitle>
    <Description>PDF Reader Pro</Description>
    <Company>XT Solution</Company>
    <Copyright>XT Solution © 2026</Copyright>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <StartupObject>XTPdfMergeApp.App</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Publish làm 1 file exe gọn: dotnet publish, -r win-x64, -c Release,
         PublishSingleFile=true, SelfContained=true (xem README khi cần). -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <ApplicationIcon>PDF icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**\*.cs" />
    <Compile Remove="VirtualPrinter\**\*.cs" />
    <!-- XT Capture (the screen-capture program) and its library are separate projects built and packed together with the Reader. -->
    <Compile Remove="XTCapture\**;XTCapture.Core\**;Setup\**" />
    <!-- Setup\ = the installer project (Setup/PdfReaderSetup.csproj), packed around the published Reader by Build-Release.ps1. -->
    <Page Remove="XTCapture\**;XTCapture.Core\**;Setup\**" />
    <Page Remove="Packaging\Release\InstallerSplash.xaml" />
    <Resource Remove="XTCapture\**;XTCapture.Core\**;Setup\**" />
    <None Remove="XTCapture\**;XTCapture.Core\**;Setup\**" />
    <EmbeddedResource Remove="XTCapture\**;XTCapture.Core\**;Setup\**" />
    <EmbeddedResource Remove="Tests\**\*" />
    <None Remove="Tests\**\*" />
    <InternalsVisibleTo Include="XTPdfMergeApp.PerformanceTests" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\AppIcon.png" />
    <Resource Include="Resources\DocumentIcon.png" />
    <Resource Include="PDF icon.ico" />
    <!-- The icon of .pdf files that open with this app (a page with the F badge), registered by the setup; it must sit beside the exe. -->
    <Content Include="PDFDocument.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Tests\GpuPdfium\MuPdfViewportWorker.py" Link="MuPdfWorker.py" CopyToOutputDirectory="PreserveNewest" Condition="'$(NativeOnly)' != 'true'" />
    <!-- Native viewing worker (no Python), built by Native/XtMuPdfWorker/Build.ps1; without it the app uses the Python worker. -->
    <!-- Statically linked worker (Build-Static.ps1): MuPDF inside the exe, banded multi-threaded rendering, no mupdfcpp64.dll. It wins when it has been built. -->
    <Content Include="Native\XtMuPdfWorker\bin\static\xtpdfworker.exe" Link="xtpdfworker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('Native\XtMuPdfWorker\bin\static\xtpdfworker.exe')" />
    <Content Include="Native\XtMuPdfWorker\xtpdfworker.static" Link="xtpdfworker.static" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('Native\XtMuPdfWorker\bin\static\xtpdfworker.exe')" />
    <Content Include="Native\XtMuPdfWorker\bin\xtpdfworker.exe" Link="xtpdfworker.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="!Exists('Native\XtMuPdfWorker\bin\static\xtpdfworker.exe') And ('$(NativeOnly)' == 'true' Or Exists('Native\XtMuPdfWorker\bin\xtpdfworker.exe'))" />
    <Content Include="Native\XtMuPdfWorker\bin\mupdfcpp64.dll" Link="mupdfcpp64.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="!Exists('Native\XtMuPdfWorker\bin\static\xtpdfworker.exe') And ('$(NativeOnly)' == 'true' Or Exists('Native\XtMuPdfWorker\bin\xtpdfworker.exe'))" />
    <Content Include="Native\XtGpuRaster\bin\xtgpuraster.dll" Link="xtgpuraster.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(GpuRaster)' == 'true'" />
    <Content Include="Native\XtGpuRaster\Run-GPU.cmd" Link="Run-GPU.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(GpuRaster)' == 'true'" />
    <!-- OCR of scanned pages: the worker script (run by the embedded Python) and the Vietnamese + Latin language data of tesseract (tessdata_fast, Apache-2.0). -->
    <Content Include="Services\Ocr\OcrWorker.py" Link="OcrWorker.py" CopyToOutputDirectory="PreserveNewest" Condition="'$(NativeOnly)' != 'true'" />
    <Content Include="Services\TextEdit\TextEditWorker.py" Link="TextEditWorker.py" CopyToOutputDirectory="PreserveNewest" Condition="'$(NativeOnly)' != 'true'" />
    <Content Include="Services/Ocr/tessdata/vie.traineddata" Link="tessdata/vie.traineddata" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup Condition="'$(MuPdfOnly)' == 'true'">
    <DefineConstants>$(DefineConstants);MUPDF_ONLY</DefineConstants>
  </PropertyGroup>
  <Target Name="BuildNativeWorker" BeforeTargets="PrepareForBuild"
          Condition="'$(NativeOnly)' == 'true'"
          Inputs="Native\XtMuPdfWorker\worker.cpp;Native\XtMuPdfWorker\json.h;Native\XtMuPdfWorker\fidelity.h;Native\XtMuPdfWorker\ocr.h;Native\XtMuPdfWorker\edit.h;Native\XtMuPdfWorker\objects.h;Native\XtMuPdfWorker\transport.h;Native\XtMuPdfWorker\Build.ps1"
          Outputs="Native\XtMuPdfWorker\bin\xtpdfworker.exe;Native\XtMuPdfWorker\bin\mupdfcpp64.dll">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Native\XtMuPdfWorker\Build.ps1&quot;" />
  </Target>
  <Target Name="BuildGpuRaster" BeforeTargets="PrepareForBuild" Condition="'$(GpuRaster)' == 'true'"
          Inputs="Native\XtGpuRaster\renderer.cpp;Native\XtGpuRaster\Build.ps1" Outputs="Native\XtGpuRaster\bin\xtgpuraster.dll">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Native\XtGpuRaster\Build.ps1&quot;" />
  </Target>
  <Target Name="ValidateNativeWorker" BeforeTargets="PrepareForBuild" DependsOnTargets="BuildNativeWorker" Condition="'$(NativeOnly)' == 'true'">
    <Error Condition="!Exists('Native\XtMuPdfWorker\bin\static\xtpdfworker.exe') And (!Exists('Native\XtMuPdfWorker\bin\xtpdfworker.exe') Or !Exists('Native\XtMuPdfWorker\bin\mupdfcpp64.dll'))" Text="Build Native/XtMuPdfWorker/Build.ps1 (or Build-Static.ps1) before building a native-only Reader." />
  </Target>
  <ItemGroup Condition="'$(MuPdfOnly)' == 'true' And '$(NativeOnly)' != 'true' And Exists('$(MuPdfRuntimeDir)\python.exe')">
    <Content Include="$(MuPdfRuntimeDir)\**\*" Link="MuPdfRuntime\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="ValidateMuPdfRuntime" BeforeTargets="PrepareForBuild" Condition="'$(MuPdfOnly)' == 'true' And '$(NativeOnly)' != 'true'">
    <Error Condition="!Exists('$(MuPdfRuntimeDir)\python.exe')" Text="Prepare the local runtime with Packaging/Prepare-MuPdfRuntime.ps1, or supply MuPdfRuntimeDir." />
  </Target>

  <ItemGroup>
    <PackageReference Include="itext" Version="9.6.0" />
    <PackageReference Include="itext.bouncy-castle-adapter" Version="9.6.0" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="147.0.7690" Condition="'$(MuPdfOnly)' != 'true'" />
    <PackageReference Include="VirtualizingWrapPanel" Version="2.5.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\XTStyle\XTStyle.csproj" />
  </ItemGroup>

  <!-- Vẽ song song: bản sao pdfium.dll mang tên khác (pdfium_1..3.dll) nằm cạnh bản gốc. Mỗi tên file là 1
       module riêng với trạng thái toàn cục riêng, nên các bản chạy song song được (Services/PdfiumInstance.cs,
       PdfiumPool: tối đa 4 bản). -->
  <Target Name="CopyPdfiumInstances" AfterTargets="Build" Condition="'$(MuPdfOnly)' != 'true'">
    <ItemGroup>
      <_PdfiumOriginal Include="$(OutDir)pdfium.dll" Condition="Exists('$(OutDir)pdfium.dll')" />
      <_PdfiumOriginal Include="$(OutDir)runtimes\win-x64\native\pdfium.dll" Condition="Exists('$(OutDir)runtimes\win-x64\native\pdfium.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PdfiumOriginal)" DestinationFiles="@(_PdfiumOriginal->'%(RootDir)%(Directory)pdfium_1.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PdfiumOriginal)" DestinationFiles="@(_PdfiumOriginal->'%(RootDir)%(Directory)pdfium_2.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PdfiumOriginal)" DestinationFiles="@(_PdfiumOriginal->'%(RootDir)%(Directory)pdfium_3.dll')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPdfiumInstancesToPublish" AfterTargets="Publish" Condition="'$(MuPdfOnly)' != 'true'">
    <ItemGroup>
      <_PdfiumPublished Include="$(PublishDir)pdfium.dll" Condition="Exists('$(PublishDir)pdfium.dll')" />
      <_PdfiumPublished Include="$(PublishDir)runtimes\win-x64\native\pdfium.dll" Condition="Exists('$(PublishDir)runtimes\win-x64\native\pdfium.dll')" />
    </ItemGroup>
    <Copy SourceFiles="@(_PdfiumPublished)" DestinationFiles="@(_PdfiumPublished->'%(RootDir)%(Directory)pdfium_1.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PdfiumPublished)" DestinationFiles="@(_PdfiumPublished->'%(RootDir)%(Directory)pdfium_2.dll')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_PdfiumPublished)" DestinationFiles="@(_PdfiumPublished->'%(RootDir)%(Directory)pdfium_3.dll')" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="ExcludeNativeSymbolsFromPublish" AfterTargets="ComputeFilesToPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

</Project>
